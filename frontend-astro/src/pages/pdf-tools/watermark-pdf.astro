---
import Layout from '../../layouts/Layout.astro';
import PdfPageWrapper from '../../shared/PdfPageWrapper';
import { WatermarkPdf } from '../../react-pages/pdf';

const title = "Add Watermark to PDF Free";
const description = "Add text watermark to your PDF pages. Free online watermark tool.";

const faqs = [
  {
    "q": "How to add a watermark to PDF?",
    "a": "Upload your PDF, type the watermark text (e.g. 'CONFIDENTIAL', 'DRAFT'), adjust the rotation, opacity, and font size, and apply it to all pages."
  },
  {
    "q": "Can I add image watermarks to a PDF?",
    "a": "Currently, our tool supports adding text watermarks with full opacity and positioning control."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/pdf-tools/watermark-pdf">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"PDF Tools","item":"https://toolswaala.in/pdf-tools"},{"@type":"ListItem","position":3,"name":"Add Watermark to PDF Free","item":"https://toolswaala.in/pdf-tools/watermark-pdf"}]}</script>

  <PdfPageWrapper title={title} hindi="वाटरमार्क लगाएं" client:load>
    <WatermarkPdf client:only="react" />
  </PdfPageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; <a href="/pdf-tools">PDF Tools</a> &gt; Add Watermark to PDF Free</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>