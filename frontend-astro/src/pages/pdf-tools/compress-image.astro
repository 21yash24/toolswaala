---
import Layout from '../../layouts/Layout.astro';
import PdfPageWrapper from '../../shared/PdfPageWrapper';
import { ImageCompressor } from '../../react-pages/pdf';

const title = "Image Compressor — Resize for Exam Portals";
const description = "Resize and compress images for exam portal uploads. Free online tool.";

const faqs = [
  {
    "q": "How do I compress an image below 50KB for portals?",
    "a": "Upload your image, choose the compression level or target size (e.g. 50KB), and download. The compressor optimizes the pixel dimensions and quality."
  },
  {
    "q": "Does compressing an image change its dimensions?",
    "a": "You can choose to keep the original dimensions or resize them. Our tool allows custom width/height adjustments."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/pdf-tools/compress-image">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"PDF Tools","item":"https://toolswaala.in/pdf-tools"},{"@type":"ListItem","position":3,"name":"Image Compressor — Resize for Exam Portals","item":"https://toolswaala.in/pdf-tools/compress-image"}]}</script>

  <PdfPageWrapper title={title} hindi="इमेज कम्प्रेस करें" client:load>
    <ImageCompressor client:only="react" />
  </PdfPageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; <a href="/pdf-tools">PDF Tools</a> &gt; Image Compressor — Resize for Exam Portals</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>