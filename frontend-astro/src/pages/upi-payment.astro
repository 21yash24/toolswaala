---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { UpiTool } from '../react-pages/BusinessTools';

const title = "Free UPI Payment Page Generator";
const description = "Create a shareable UPI payment page with QR code. No app needed. Works with PhonePe, GPay, Paytm.";

const faqs = [
  {
    "q": "How does a UPI payment link or QR work?",
    "a": "It encodes your UPI ID (VPA), recipient name, and optionally the transaction amount into a standard UPI deep-link URL or QR code. When scanned, it opens the user's UPI app."
  },
  {
    "q": "Are UPI payment QRs safe?",
    "a": "Yes, they are completely safe. They only contain public routing information (like your UPI ID). They cannot access or deduct money from your bank account."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/upi-payment">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"Free UPI Payment Page Generator","item":"https://toolswaala.in/upi-payment"}]}</script>

  <PageWrapper title={title} hindi="पेमेंट पेज" client:load>
    <UpiTool client:only="react" />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; Free UPI Payment Page Generator</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    <h2>UPI Payment Page</h2><p>Shareable payment link with QR. PhonePe, GPay, Paytm. No gateway fees.</p><p>Related: <a href="/qr-generator">QR Code Generator</a></p>
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>