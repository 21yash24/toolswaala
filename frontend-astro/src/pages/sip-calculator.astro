---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { SipCalcTool } from '../react-pages/BusinessTools';

const title = "SIP Calculator India — Mutual Fund Returns";
const description = "Estimate mutual fund SIP returns with visual charts. Free SIP investment calculator.";

const faqs = [
  {
    "q": "How does a SIP calculator work?",
    "a": "SIP calculators use the compound interest formula to estimate future returns: M = P x [((1 + i)^n - 1) / i] x (1 + i), where P is monthly investment, i is periodic interest rate, and n is number of payments."
  },
  {
    "q": "What is a good SIP return rate to assume?",
    "a": "For long-term equity mutual funds (7-10+ years), an average return rate of 12-15% is commonly used for estimations."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/sip-calculator">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"SIP Calculator India — Mutual Fund Returns","item":"https://toolswaala.in/sip-calculator"}]}</script>

  <PageWrapper title={title} hindi="एसआईपी कैलकुलेटर" client:load>
    <SipCalcTool client:only="react" />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; SIP Calculator India — Mutual Fund Returns</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    <h2>SIP Calculator</h2><p>Mutual fund SIP returns with growth charts. Step-up SIP calculations.</p><p>Related: <a href="/fd-calculator">FD Calculator</a> | <a href="/emi-calculator">EMI Calculator</a></p>
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>