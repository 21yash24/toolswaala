---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { LegalHubTool } from '../react-pages/BusinessTools';

const title = "Free Legal Agreement Generator — Rent, NDA, MSA";
const description = "Draft rent agreements, NDAs, and service contracts instantly online. No lawyer needed.";

const faqs = [
  {
    "q": "Are online legal drafts legally valid in India?",
    "a": "Yes, online drafts are legally valid once printed on appropriate stamp paper, signed by all parties, and notarized or registered as required."
  },
  {
    "q": "Which stamp paper value should I use?",
    "a": "Stamp duty varies by state and document type (e.g., Rs. 50-100 for rent agreements or affidavits). Check your local state guidelines for exact values."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/legal-hub">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"Free Legal Agreement Generator — Rent, NDA, MSA","item":"https://toolswaala.in/legal-hub"}]}</script>

  <PageWrapper title={title} hindi="कानूनी दस्तावेज़" client:load>
    <LegalHubTool client:only="react" />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; Free Legal Agreement Generator — Rent, NDA, MSA</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>