---
import Layout from '../layouts/Layout.astro';
import { PdfHome } from '../react-pages/pdf';

const title = "Free PDF Tools Online — No Upload, 100% Private";
const description = "9 free PDF tools. Compress, merge, split, convert. Your files never leave your browser.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/pdf-tools">
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"Free PDF Tools Online — No Upload, 100% Private","item":"https://toolswaala.in/pdf-tools"}]}</script>

  <PdfHome client:only="react" />

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; Free PDF Tools Online — No Upload, 100% Private</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    <p>9 free PDF tools, 100% browser-based. No uploads.</p><ul><li><a href="/pdf-tools/compress-pdf">Compress PDF</a></li><li><a href="/pdf-tools/image-to-pdf">Image to PDF</a></li><li><a href="/pdf-tools/merge-pdf">Merge PDF</a></li><li><a href="/pdf-tools/split-pdf">Split PDF</a></li></ul>
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>