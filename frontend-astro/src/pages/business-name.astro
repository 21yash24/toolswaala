---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { BizNameTool } from '../react-pages/BusinessTools';

const title = "Business Name Generator AI";
const description = "AI-powered business name suggestions for your startup or brand.";

const faqs = [
  {
    "q": "How does the AI Business Name Generator work?",
    "a": "Our generator uses advanced naming algorithms to combine keywords, industries, and styles to generate memorable, brandable business names instantly."
  },
  {
    "q": "Are the generated business names free to use?",
    "a": "Yes, all business name suggestions are 100% free. However, you should check trademark availability and domain availability before registering your brand."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/business-name">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"Business Name Generator AI","item":"https://toolswaala.in/business-name"}]}</script>

  <PageWrapper title={title} hindi="बिज़नेस नाम" client:load>
    <BizNameTool client:only="react" />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; Business Name Generator AI</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>