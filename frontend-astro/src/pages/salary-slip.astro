---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { SalaryTool } from '../react-pages/BusinessTools';

const title = "Free Salary Slip Generator India";
const description = "Create professional salary slips with CTC breakdown and TDS calculation.";

const faqs = [
  {
    "q": "What are the key components of a salary slip?",
    "a": "A salary slip consists of Earnings (Basic, HRA, DA, Special Allowance) and Deductions (PF, Professional Tax, TDS, ESIC)."
  },
  {
    "q": "Why is a salary slip important?",
    "a": "Salary slips are crucial proof of income required when applying for home loans, personal loans, credit cards, or during job transitions."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/salary-slip">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"Free Salary Slip Generator India","item":"https://toolswaala.in/salary-slip"}]}</script>

  <PageWrapper title={title} hindi="वेतन पर्ची" client:load>
    <SalaryTool client:only="react" />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; Free Salary Slip Generator India</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>