---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { PomodoroTimer } from '../react-pages/students';

const title = "Pomodoro Timer & Lofi Player";
const description = "Free Pomodoro timer with lofi beats, focus tracking, and productivity history.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/pomodoro-timer">
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the Pomodoro Technique?","acceptedAnswer":{"@type":"Answer","text":"Study for 25 minutes, take a 5-minute break. After 4 cycles, take a 15-minute long break. Prevents burnout and maintains focus."}},{"@type":"Question","name":"Can I change the timer duration?","acceptedAnswer":{"@type":"Answer","text":"Yes! Customize focus time (1-90 min), short break (1-30 min), and long break (1-60 min)."}}]}</script>
<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"Pomodoro Timer & Lofi Player","item":"https://toolswaala.in/pomodoro-timer"}]}</script>

  <PageWrapper title={title} hindi="पोमोडोरो टाइमर" client:load>
    <PomodoroTimer client:only="react" />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; <a href="/students">Student Tools</a> &gt; Pomodoro Timer & Lofi Player</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    <h2>Pomodoro Study Timer</h2><p>25-minute focus sessions with lofi music, productivity tracking, and customizable durations.</p><p>Related: <a href="/study-planner">Study Planner</a> | <a href="/attendance-calculator">Attendance Calculator</a></p>
    <h2>Frequently Asked Questions</h2><h3>What is the Pomodoro Technique?</h3><p>Study for 25 minutes, take a 5-minute break. After 4 cycles, take a 15-minute long break. Prevents burnout and maintains focus.</p><h3>Can I change the timer duration?</h3><p>Yes! Customize focus time (1-90 min), short break (1-30 min), and long break (1-60 min).</p>
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>