---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { YtThumbnailDownloader } from '../react-pages/students';

const title = "YouTube Thumbnail Downloader HD";
const description = "Download high-quality YouTube video thumbnails in full HD instantly for free.";

const faqs = [
  {
    "q": "How to download YouTube thumbnails?",
    "a": "Copy the YouTube video link, paste it into our downloader, choose the quality (Max Resolution, HD, Standard), and click download."
  },
  {
    "q": "Is it legal to use YouTube thumbnails?",
    "a": "Thumbnails are copyrighted. While downloading them is safe, reusing them for your own content might violate copyright unless you have permission or it falls under fair use."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/youtube-thumbnail-downloader">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"YouTube Thumbnail Downloader HD","item":"https://toolswaala.in/youtube-thumbnail-downloader"}]}</script>

  <PageWrapper title={title} hindi="थंबनेल डाउनलोडर" client:load>
    <YtThumbnailDownloader client:only="react" />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; <a href="/students">Student Tools</a> &gt; YouTube Thumbnail Downloader HD</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>