---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { QrTool } from '../react-pages/BusinessTools';

const title = "QR Code Generator — Custom QR Codes Free";
const description = "Create custom QR codes for URL, UPI, WhatsApp and more. Free download.";

const faqs = [
  {
    "q": "How do QR codes work?",
    "a": "QR (Quick Response) codes store data in a black-and-white grid pattern that can be instantly scanned by smartphone cameras to open links, text, or payment portals."
  },
  {
    "q": "Are these QR codes permanent?",
    "a": "Yes, static QR codes generated here do not expire and will work permanently as long as the destination URL or text remains active."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/qr-generator">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"QR Code Generator — Custom QR Codes Free","item":"https://toolswaala.in/qr-generator"}]}</script>

  <PageWrapper title={title} hindi="क्यूआर" client:load>
    <QrTool client:only="react" />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; QR Code Generator — Custom QR Codes Free</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>