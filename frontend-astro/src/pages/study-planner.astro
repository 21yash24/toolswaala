---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { StudyPlanner } from '../react-pages/students';

const title = "Study Planner — Exam Countdown & Schedule";
const description = "Plan your study schedule with exam countdown and daily checklist.";

const faqs = [
  {
    "q": "How do I create an effective study schedule?",
    "a": "Divide your subjects into topics, estimate hours required, allocate study blocks with Pomodoro breaks, and schedule weekly revisions."
  },
  {
    "q": "How many hours should a student study daily?",
    "a": "For competitive exams, 6-8 structured hours are recommended. For school/college, 3-4 hours of consistent study is highly effective."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/study-planner">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"Study Planner — Exam Countdown & Schedule","item":"https://toolswaala.in/study-planner"}]}</script>

  <PageWrapper title={title} hindi="स्टडी प्लानर" client:load>
    <StudyPlanner client:only="react" />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; <a href="/students">Student Tools</a> &gt; Study Planner — Exam Countdown & Schedule</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    <h2>Study Planner with Exam Countdown</h2><p>Priority tasks, weekly timetable, exam countdown, study streak tracker.</p><p>Related: <a href="/pomodoro-timer">Pomodoro Timer</a> | <a href="/cgpa-calculator">CGPA Calculator</a></p>
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>