---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { GstinVerifyTool } from '../react-pages/BusinessTools';

const title = "GSTIN Verifier — Verify GST Number Online";
const description = "Instantly verify GST format and extract business details from GSTIN.";

const faqs = [
  {
    "q": "How to verify a GSTIN number?",
    "a": "You can verify a GST number by entering the 15-digit GSTIN. The structure consists of the state code, PAN number, entity number, character 'Z', and a check digit."
  },
  {
    "q": "What details can I see from GST search?",
    "a": "A GSTIN search returns the business name, trade name, registration date, taxpayer type (regular/composition), active status, and address."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/gstin-verify">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"GSTIN Verifier — Verify GST Number Online","item":"https://toolswaala.in/gstin-verify"}]}</script>

  <PageWrapper title={title} hindi="जीएसटीएन सत्यापन" client:load>
    <GstinVerifyTool client:only="react" />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; GSTIN Verifier — Verify GST Number Online</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>