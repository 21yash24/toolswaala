---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { GstInvoiceTool } from '../react-pages/BusinessTools';

const title = "Free GST Invoice Generator India";
const description = "Generate professional GST invoices with HSN codes and PDF export. Zero login required.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/gst-invoice">
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What are the mandatory fields in a GST invoice?","acceptedAnswer":{"@type":"Answer","text":"GSTIN, invoice number, date, buyer details, HSN/SAC codes, taxable value, GST rate and amount, and total."}},{"@type":"Question","name":"Do I need GST registration for invoicing?","acceptedAnswer":{"@type":"Answer","text":"GST registration is mandatory if turnover exceeds 40 lakh (20 lakh for services)."}}]}</script>
<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"Free GST Invoice Generator India","item":"https://toolswaala.in/gst-invoice"}]}</script>

  <PageWrapper title={title} hindi="चालान" client:load>
    <GstInvoiceTool client:only="react" />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; Free GST Invoice Generator India</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    <h2>GST Invoice Generator</h2><p>GSTIN, HSN codes, CGST/SGST/IGST breakdown. PDF export. B2B and B2C.</p><p>Related: <a href="/gst-calculator">GST Calculator</a> | <a href="/receipt-maker">Receipt Maker</a></p>
    <h2>Frequently Asked Questions</h2><h3>What are the mandatory fields in a GST invoice?</h3><p>GSTIN, invoice number, date, buyer details, HSN/SAC codes, taxable value, GST rate and amount, and total.</p><h3>Do I need GST registration for invoicing?</h3><p>GST registration is mandatory if turnover exceeds 40 lakh (20 lakh for services).</p>
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>