---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { UpiTool } from '../react-pages/BusinessTools';

const title = "Free UPI Payment Page Generator 2025 | Zero Gateway Fee QR & Link Maker";
const description = "Create shareable UPI payment links & QR codes for small businesses, freelancers, and stores. Accept GPay, PhonePe, Paytm, BHIM payments with 0% MDR fees.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/upi-payment">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala UPI Payment Link Generator",
      "operatingSystem": "All",
      "applicationCategory": "FinancialApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.97",
        "ratingCount": "3820"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Are there any payment gateway commission fees (MDR) on ToolsWaala UPI links?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Zero fees! Unlike traditional payment gateways (Razorpay, Cashfree) that charge 2% + GST commission, ToolsWaala generates direct NPCI UPI deep links. Money transfers directly from customer bank account to your bank account with 0% MDR fees."
          }
        },
        {
          "@type": "Question",
          "name": "Which apps support scanning or opening ToolsWaala UPI payment links?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All major Indian UPI applications are supported, including Google Pay (GPay), PhonePe, Paytm, BHIM UPI, Cred, Mobikwik, and bank apps (SBI Yono, HDFC MobileBanking, ICICI iMobile)."
          }
        },
        {
          "@type": "Question",
          "name": "Can I set a fixed payment amount in the UPI QR code?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! You can create a static QR code (flexible amount entered by customer) or a dynamic QR code with a pre-filled fixed amount and transaction note."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="UPI Payment Page" hindi="पेमेंट पेज" client:load>
    <UpiTool client:only="react" />
  </PageWrapper>

  <!-- Sleek Dark Glassmorphic SEO Content Block -->
  <article style="max-width: 900px; margin: 60px auto 40px; padding: 0 24px; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; line-height: 1.7; color: var(--app-text);">
    <div class="mb-10 text-center sm:text-left">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold text-amber-400 bg-amber-500/10 border border-amber-500/20 mb-4">
        ⚡ NPCI Deep Link Spec 2025
      </span>
      <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">
        Direct UPI Link & Instant QR Generator
      </h3>
      <p class="text-base text-zinc-400 max-w-2xl">
        Generate zero-fee payment links and printable QR codes for store counters, freelancing invoices, and shop sales. Receive 100% direct bank deposits with 0% MDR commissions.
      </p>
    </div>

    <!-- Glassmorphic Specification Card -->
    <div class="bg-zinc-900/40 border border-white/10 rounded-2xl p-6 mb-10 backdrop-blur-md shadow-2xl">
      <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">
        <span class="text-amber-400">📌</span> NPCI Standard UPI Deep Link Format
      </h4>
      <p class="text-zinc-400 text-sm mb-4">
        ToolsWaala constructs standardized Unified Payments Interface (UPI) deep links adhering to National Payments Corporation of India (NPCI) specs:
      </p>
      <div class="bg-zinc-950/80 p-4 rounded-xl border border-white/10 font-mono text-xs text-amber-300 overflow-x-auto mb-4">
        upi://pay?pa=yourvpa@upi&pn=BusinessName&am=500.00&cu=INR&tn=Invoice101
      </div>
      <div class="grid sm:grid-cols-2 gap-3 text-xs text-zinc-400">
        <div class="bg-zinc-900/60 p-3 rounded-xl border border-white/5">
          <span class="text-white font-semibold block mb-0.5">pa (Payee VPA)</span>
          Your UPI ID (e.g. <code>9876543210@paytm</code>)
        </div>
        <div class="bg-zinc-900/60 p-3 rounded-xl border border-white/5">
          <span class="text-white font-semibold block mb-0.5">pn (Payee Name)</span>
          Display name registered with your bank
        </div>
        <div class="bg-zinc-900/60 p-3 rounded-xl border border-white/5">
          <span class="text-white font-semibold block mb-0.5">am (Amount)</span>
          Transaction amount in INR (optional)
        </div>
        <div class="bg-zinc-900/60 p-3 rounded-xl border border-white/5">
          <span class="text-white font-semibold block mb-0.5">tn (Transaction Note)</span>
          Invoice reference or order description
        </div>
      </div>
    </div>

    <!-- Comparison Table -->
    <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Direct UPI Link vs Traditional Gateway</h4>
    <div class="overflow-x-auto mb-12">
      <table style="width: 100%; border-collapse: collapse; border: 1px solid var(--app-border); border-radius: 16px; overflow: hidden; font-size: 14px; background: var(--app-surface-card);">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th class="p-4 border-b border-white/10">Feature</th>
            <th class="p-4 border-b border-white/10 text-amber-400">ToolsWaala Direct Link</th>
            <th class="p-4 border-b border-white/10 text-zinc-500">Payment Gateways</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5 text-zinc-300">
          <tr class="hover:bg-white/5 transition-colors">
            <td class="p-4 font-semibold text-white">Transaction MDR Fee</td>
            <td class="p-4 text-emerald-400 font-bold">0% (100% Free)</td>
            <td class="p-4 text-zinc-400">2.0% + 18% GST</td>
          </tr>
          <tr class="hover:bg-white/5 transition-colors">
            <td class="p-4 font-semibold text-white">Settlement Time</td>
            <td class="p-4 text-emerald-400 font-bold">Instant Bank Transfer</td>
            <td class="p-4 text-zinc-400">T+1 or T+2 Business Days</td>
          </tr>
          <tr class="hover:bg-white/5 transition-colors">
            <td class="p-4 font-semibold text-white">KYC Requirement</td>
            <td class="p-4 text-emerald-400 font-bold">Zero KYC Required</td>
            <td class="p-4 text-zinc-400">Merchant Document Verification</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Glassmorphic FAQ Cards -->
    <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Frequently Asked Questions</h4>
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="bg-zinc-900/40 p-5 rounded-2xl border border-white/10 backdrop-blur-md hover:border-amber-500/30 transition-all">
        <h4 class="text-sm font-semibold text-white mb-2">Are there any gateway fees (MDR)?</h4>
        <p class="text-zinc-400 text-xs leading-relaxed">
          Zero fees! Direct NPCI UPI deep links route payments directly from customer bank accounts to your bank account with 0% MDR fees.
        </p>
      </div>
      <div class="bg-zinc-900/40 p-5 rounded-2xl border border-white/10 backdrop-blur-md hover:border-amber-500/30 transition-all">
        <h4 class="text-sm font-semibold text-white mb-2">Are UPI payment QRs secure?</h4>
        <p class="text-zinc-400 text-xs leading-relaxed">
          Yes. UPI QR codes only store public routing parameters (your VPA ID). They cannot deduct funds or access account balances.
        </p>
      </div>
    </div>
  </article>
</Layout>