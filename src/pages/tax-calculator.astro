---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { TaxCalculatorTool } from '../react-pages/BusinessTools';

const title = "Income Tax Calculator FY 2025-26 (AY 2026-27) | Old vs New Regime";
const description = "Calculate income tax for FY 2025-26. Compare Old vs New Tax Regime tax slabs, 80C deductions, HRA exemption, and u/s 87A rebate. Free for salaried in India.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/tax-calculator">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala Income Tax Calculator India",
      "operatingSystem": "All",
      "applicationCategory": "FinancialApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.97",
        "ratingCount": "3890"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the tax-free income limit under the New Tax Regime for FY 2025-26?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Under the New Tax Regime for FY 2025-26, income up to ₹12 Lakh is effectively tax-free due to the enhanced Section 87A rebate and ₹75,000 standard deduction for salaried individuals."
          }
        },
        {
          "@type": "Question",
          "name": "Which regime saves more tax: Old Tax Regime or New Tax Regime?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If your total eligible tax deductions (Section 80C, 80D, HRA, Home Loan Interest) exceed ₹3.75 Lakh per year, the Old Tax Regime will usually save you more tax. If your total deductions are below ₹3.75 Lakh, the New Tax Regime is more beneficial."
          }
        },
        {
          "@type": "Question",
          "name": "What is the Standard Deduction for salaried employees in FY 2025-26?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Standard Deduction for salaried employees and pensioners is ₹75,000 under the New Tax Regime and ₹50,000 under the Old Tax Regime."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="Income Tax Calculator" hindi="आयकर" client:load>
    <TaxCalculatorTool client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article class="seo-article">
    

    <h2 style="font-size: clamp(24px, 4vw, 36px); font-weight: 800; color: var(--app-text); margin-bottom: 16px; letter-spacing: -0.02em;">
      Income Tax Calculator FY 2025-26 (AY 2026-27) — Old vs New Regime
    </h2>
    
    <p style="font-size: 16px; color: var(--app-text-secondary); margin-bottom: 32px; line-height: 1.7;">
      Compare your income tax liability under the <strong>New Tax Regime</strong> and <strong>Old Tax Regime</strong> for Financial Year 2025-26 (Assessment Year 2026-27). Calculate deductions under <strong>Section 80C, 80D, HRA, Section 24 (Home Loan), NPS (80CCD)</strong>, and Section 87A rebate.
    </p>

    <div style="background: var(--app-surface-card); border: 1px solid var(--app-border); border-radius: 20px; padding: 28px; margin-bottom: 40px; box-shadow: 0 4px 20px -2px rgba(0,0,0,0.05);">
      <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Key Highlights of Union Budget Tax Revisions</h3>
      <ul class="space-y-2 text-slate-700 dark:text-slate-300 text-sm">
        <li>📌 <strong>Enhanced Standard Deduction:</strong> Increased to <code>₹75,000</code> for salaried employees under the New Regime.</li>
        <li>📌 <strong>Rebate u/s 87A:</strong> Full tax rebate for net taxable income up to <code>₹12,00,000</code> under the New Tax Regime.</li>
        <li>📌 <strong>Default Tax Regime:</strong> The New Tax Regime is the default option; however, taxpayers can opt for the Old Regime at the time of ITR filing.</li>
      </ul>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Income Tax Slabs Comparison Table FY 2025-26</h3>
    <p style="font-size: 15px; color: var(--app-text-secondary); margin-bottom: 24px; line-height: 1.7;">Side-by-side comparison of tax rates applicable to individual taxpayers below 60 years of age:</p>

    <div class="seo-table-wrapper">
      <table class="seo-table">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Income Slab Range</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">New Tax Regime Rate</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Old Tax Regime Rate</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Up to ₹3,00,000</td>
            <td class="p-3 text-emerald-600 font-medium">NIL (No Tax)</td>
            <td class="p-3 font-medium">NIL (No Tax up to ₹2.5L)</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">₹3,00,001 to ₹7,00,000</td>
            <td class="p-3 text-emerald-600 font-medium">5% (Rebate u/s 87A applies)</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">5%</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">₹7,00,001 to ₹10,00,000</td>
            <td class="p-3 text-blue-600 font-medium">10%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">20%</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">₹10,00,001 to ₹12,00,000</td>
            <td class="p-3 text-indigo-600 font-medium">15%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">30%</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">₹12,00,001 to ₹15,00,000</td>
            <td class="p-3 text-indigo-600 font-medium">20%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">30%</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Above ₹15,00,000</td>
            <td class="p-3 text-amber-600 font-bold">30%</td>
            <td class="p-3 text-amber-600 font-bold">30%</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Tax Deductions Allowed Under Old Tax Regime</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
      <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Section 80C (Max ₹1,50,000)</h4>
        <p class="text-xs text-slate-600 dark:text-slate-300">EPF, PPF, ELSS mutual funds, LIC premiums, home loan principal repayment, children tuition fees.</p>
      </div>
      <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Section 80D Health Insurance</h4>
        <p class="text-xs text-slate-600 dark:text-slate-300">Medical insurance premiums up to ₹25,000 for self/family and ₹50,000 for senior citizen parents.</p>
      </div>
      <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">House Rent Allowance (HRA)</h4>
        <p class="text-xs text-slate-600 dark:text-slate-300">Exemption calculated under Section 10(13A) based on rent paid, basic salary, and city tier.</p>
      </div>
      <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Section 24(b) Home Loan Interest</h4>
        <p class="text-xs text-slate-600 dark:text-slate-300">Deduction up to ₹2,00,000 per year on home loan interest for self-occupied residential property.</p>
      </div>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Frequently Asked Questions (FAQs)</h3>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Which is better: Old or New Tax Regime?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          If your total deductions (80C, 80D, HRA, Home Loan Interest) exceed ₹3.75 Lakh per year, the Old Tax Regime will usually save you more tax. Otherwise, the New Tax Regime is more beneficial.
        </p>
      </div>
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">What is the Standard Deduction for FY 2025-26?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          The Standard Deduction for salaried employees is ₹75,000 under the New Tax Regime and ₹50,000 under the Old Tax Regime.
        </p>
      </div>
    </div>
  </article>
</Layout>