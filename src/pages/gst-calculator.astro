---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { GstCalcTool } from '../react-pages/BusinessTools';

const title = "GST Calculator Online 2025 | Add or Remove GST (5%, 12%, 18%, 28%)";
const description = "Free online GST Calculator India. Add or remove GST instantly from net or gross amounts. Calculate CGST, SGST, IGST splits and HSN codes.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/gst-calculator">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala GST Calculator Online India",
      "operatingSystem": "All",
      "applicationCategory": "FinancialApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.95",
        "ratingCount": "1840"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How to calculate GST in India?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To add GST: GST Amount = (Base Price × GST Rate) / 100. Total Price = Base Price + GST Amount. To remove GST from inclusive price: Base Price = Total Price / (1 + (GST Rate / 100)). GST Amount = Total Price - Base Price."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between CGST, SGST, and IGST?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "CGST (Central GST) and SGST (State GST) are levied on Intra-State sales (buyer and seller in same state) and split 50:50. IGST (Integrated GST) is levied on Inter-State sales (buyer and seller in different states) and collected by the Central Government."
          }
        },
        {
          "@type": "Question",
          "name": "What are the current GST tax slabs in India?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "India has 4 main GST tax slabs: 5% (essential goods), 12% (standard items), 18% (services and manufactured goods), and 28% (luxury items and demerit goods)."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="GST Calculator" hindi="जीएसटी" client:load>
    <GstCalcTool client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article style="max-width: 900px; margin: 60px auto 40px; padding: 0 24px; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; line-height: 1.7; color: var(--app-text);">
    

    <h2 style="font-size: clamp(24px, 4vw, 36px); font-weight: 800; color: var(--app-text); margin-bottom: 16px; letter-spacing: -0.02em;">
      GST Calculator Online 2025 (Add & Remove Goods and Services Tax)
    </h2>
    
    <p style="font-size: 16px; color: var(--app-text-secondary); margin-bottom: 32px; line-height: 1.7;">
      Calculate Goods and Services Tax (GST) for any product or service in India. Switch effortlessly between <strong>Inclusive GST</strong> (remove tax from total price) and <strong>Exclusive GST</strong> (add tax to base amount) for all standard GST slabs: <strong>5%, 12%, 18%, and 28%</strong>.
    </p>

    <div style="background: var(--app-surface-card); border: 1px solid var(--app-border); border-radius: 20px; padding: 28px; margin-bottom: 40px; box-shadow: 0 4px 20px -2px rgba(0,0,0,0.05);">
      <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Official GST Calculation Formulas</h3>
      <div class="space-y-4 text-slate-700 dark:text-slate-300 text-sm">
        <div>
          <p class="font-semibold text-slate-900 dark:text-white">1. Add GST (Exclusive Tax Formula):</p>
          <code class="block bg-white dark:bg-slate-900 p-2.5 rounded border border-slate-200 dark:border-slate-800 mt-1 font-mono text-indigo-600 dark:text-indigo-400">
            GST Amount = (Base Amount × GST Rate) / 100<br/>
            Net Total = Base Amount + GST Amount
          </code>
        </div>
        <div>
          <p class="font-semibold text-slate-900 dark:text-white">2. Remove GST (Inclusive Tax Formula):</p>
          <code class="block bg-white dark:bg-slate-900 p-2.5 rounded border border-slate-200 dark:border-slate-800 mt-1 font-mono text-emerald-600 dark:text-emerald-400">
            Base Amount = Gross Total / (1 + (GST Rate / 100))<br/>
            GST Amount = Gross Total - Base Amount
          </code>
        </div>
      </div>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Indian GST Tax Slabs Breakdown</h3>
    <p style="font-size: 15px; color: var(--app-text-secondary); margin-bottom: 24px; line-height: 1.7;">Goods and services in India are categorized under 4 primary tax brackets under the Central Goods and Services Tax Act:</p>

    <div class="overflow-x-auto mb-10">
      <table style="width: 100%; border-collapse: collapse; border: 1px solid var(--app-border); border-radius: 16px; overflow: hidden; font-size: 14px; background: var(--app-surface-card);">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">GST Slab Rate</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">CGST + SGST Split (Intra-State)</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">IGST Rate (Inter-State)</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Applicable Goods & Services</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td class="p-3 font-semibold text-emerald-600">5% Slab</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">2.5% CGST + 2.5% SGST</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">5% IGST</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">Packaged food, tea, coffee, medicine, apparel under ₹1000</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td class="p-3 font-semibold text-blue-600">12% Slab</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">6% CGST + 6% SGST</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">12% IGST</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">Processed food, computers, business class air tickets</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td class="p-3 font-semibold text-indigo-600">18% Slab</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">9% CGST + 9% SGST</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">18% IGST</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">IT services, software development, telecom, restaurants, cosmetics</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td class="p-3 font-semibold text-amber-600">28% Slab</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">14% CGST + 14% SGST</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">28% IGST</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">Luxury automobiles, cement, air conditioners, gaming</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Understanding CGST, SGST, and IGST Components</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">CGST (Central GST)</h4>
        <p class="text-xs text-slate-600 dark:text-slate-300">Levied by the Central Government on intra-state supplies. Equal to 50% of the total GST rate.</p>
      </div>
      <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">SGST (State GST)</h4>
        <p class="text-xs text-slate-600 dark:text-slate-300">Levied by the State Government on intra-state supplies. Equal to 50% of the total GST rate.</p>
      </div>
      <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">IGST (Integrated GST)</h4>
        <p class="text-xs text-slate-600 dark:text-slate-300">Levied on inter-state transactions and imports. Collected by Central Govt and shared with destination state.</p>
      </div>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Frequently Asked Questions (FAQs)</h3>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">How to calculate GST in India?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          To add GST: GST Amount = (Base Price × GST Rate) / 100. Total Price = Base Price + GST Amount. To remove GST from inclusive price: Base Price = Total Price / (1 + (GST Rate / 100)). GST Amount = Total Price - Base Price.
        </p>
      </div>
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">What is the difference between CGST, SGST, and IGST?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          CGST (Central GST) and SGST (State GST) are levied on Intra-State sales (buyer and seller in same state) and split 50:50. IGST (Integrated GST) is levied on Inter-State sales (buyer and seller in different states) and collected by the Central Government.
        </p>
      </div>
    </div>
  </article>
</Layout>