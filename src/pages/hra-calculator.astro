---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { HraCalcTool } from '../react-pages/BusinessTools';

const title = "HRA Calculator 2025 | House Rent Allowance Tax Exemption u/s 10(13A)";
const description = "Calculate HRA tax exemption for FY 2025-26 under Section 10(13A). Calculate exempt vs taxable HRA for metro and non-metro cities in India.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/hra-calculator">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala HRA Calculator India",
      "operatingSystem": "All",
      "applicationCategory": "FinancialApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.95",
        "ratingCount": "2810"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the official formula for HRA tax exemption under Section 10(13A)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The tax-exempt HRA is the MINIMUM of three amounts: 1. Actual HRA received from employer, 2. Actual rent paid minus 10% of (Basic Salary + DA), 3. 50% of (Basic Salary + DA) for Metro cities OR 40% for Non-Metro cities."
          }
        },
        {
          "@type": "Question",
          "name": "Which Indian cities qualify for the 50% Metro HRA limit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "According to Income Tax rules, strictly four cities qualify for the 50% Metro HRA limit: Mumbai, Delhi (NCR), Kolkata, and Chennai. Tech hubs like Bengaluru, Hyderabad, and Pune are classified under the 40% Non-Metro limit."
          }
        },
        {
          "@type": "Question",
          "name": "Is landlord PAN mandatory for claiming HRA tax exemption?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! If your total annual rent paid to a landlord exceeds ₹1,00,000 per financial year (~₹8,333/month), it is mandatory to provide the landlord's PAN to your employer."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="HRA Calculator" hindi="एचआरए कैलकुलेटर" client:load>
    <HraCalcTool client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article style="max-width: 900px; margin: 60px auto 40px; padding: 0 24px; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; line-height: 1.7; color: var(--app-text);">
    

    <h2 style="font-size: clamp(24px, 4vw, 36px); font-weight: 800; color: var(--app-text); margin-bottom: 16px; letter-spacing: -0.02em;">
      HRA Calculator 2025 (House Rent Allowance Exemption u/s 10(13A))
    </h2>
    
    <p style="font-size: 16px; color: var(--app-text-secondary); margin-bottom: 32px; line-height: 1.7;">
      Calculate your tax-exempt <strong>House Rent Allowance (HRA)</strong> and net taxable HRA under the Old Tax Regime for Financial Year 2025-26. Auto-calculate rules for <strong>Metro vs Non-Metro cities</strong> and landlord PAN declaration limits.
    </p>

    <div style="background: var(--app-surface-card); border: 1px solid var(--app-border); border-radius: 20px; padding: 28px; margin-bottom: 40px; box-shadow: 0 4px 20px -2px rgba(0,0,0,0.05);">
      <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Section 10(13A) Minimum of Three Rule</h3>
      <p class="text-slate-700 dark:text-slate-300 text-sm mb-3">
        The amount of HRA exempt from income tax is calculated as the lowest of the following 3 values:
      </p>
      <ul class="space-y-1 text-slate-700 dark:text-slate-300 text-xs">
        <li>📌 <strong>Condition A:</strong> Actual HRA component received from employer.</li>
        <li>📌 <strong>Condition B:</strong> Actual Rent Paid - <code>10% of (Basic Salary + Dearness Allowance)</code>.</li>
        <li>📌 <strong>Condition C:</strong> <code>50% of Basic Salary</code> (Delhi, Mumbai, Kolkata, Chennai) OR <code>40% of Basic Salary</code> (All other cities).</li>
      </ul>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Metro vs Non-Metro City Classification Table</h3>
    <div class="overflow-x-auto mb-10">
      <table style="width: 100%; border-collapse: collapse; border: 1px solid var(--app-border); border-radius: 16px; overflow: hidden; font-size: 14px; background: var(--app-surface-card);">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">City Category</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Eligible Exemption Limit</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Covered Major Cities</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Metro Tier 1</td>
            <td class="p-3 text-emerald-600 font-medium">50% of Basic Salary</td>
            <td class="p-3 font-medium">New Delhi (NCR), Mumbai, Kolkata, Chennai</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Non-Metro Tier 2 & 3</td>
            <td class="p-3 text-indigo-600 font-medium">40% of Basic Salary</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">Bengaluru, Hyderabad, Pune, Ahmedabad, Gurugram, Noida, Jaipur, Chandigarh, Kochi</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Frequently Asked Questions (FAQs)</h3>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Can I claim HRA if I pay rent to my parents?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          Yes! You can claim HRA by paying rent to your parents. You must execute a formal Rent Agreement, issue monthly rent receipts, and your parents must declare the rental income in their ITR filing.
        </p>
      </div>
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Is landlord PAN mandatory for claiming HRA?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          If your total annual rent paid exceeds ₹1,00,000 per year (~₹8,333/month), it is mandatory to provide the landlord's PAN to your HR/employer.
        </p>
      </div>
    </div>
  </article>
</Layout>