---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { PercentageCalc } from '../react-pages/students';

const title = "Marks & Percentage Calculator";
const description = "Calculate semester results, target marks and CBSE grading instantly.";

const faqs = [
  {
    "q": "How to calculate percentage of a number?",
    "a": "To find the percentage, divide the part by the whole and multiply by 100: Percentage = (Part / Whole) x 100."
  },
  {
    "q": "How to find percentage increase or decrease?",
    "a": "Percentage Increase/Decrease = ((New Value - Original Value) / Original Value) x 100. A positive result is an increase, negative is a decrease."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/percentage-calculator">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"Marks & Percentage Calculator","item":"https://toolswaala.in/percentage-calculator"}]}</script>

  <PageWrapper title={title} hindi="प्रतिशत कैलकुलेटर" client:load>
    <PercentageCalc client:only="react" />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; <a href="/students">Student Tools</a> &gt; Marks & Percentage Calculator</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    <h2>Marks Calculator</h2><p>Semester results, CBSE grading, target marks calculator. Custom pass thresholds.</p><p>Related: <a href="/cgpa-calculator">CGPA Calculator</a></p>
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>