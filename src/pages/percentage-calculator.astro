            <td style="padding: 13px 14px; font-weight: 700;">A1</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">10</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">Letter Mark</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">A+ (State Rank possible)</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);">
            <td style="padding: 13px 14px; font-weight: 700; color: #10b981;">81%–90%</td>
            <td style="padding: 13px 14px; font-weight: 700;">A2</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">9</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">Star (★) category</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">A (Distinction)</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 13px 14px; font-weight: 700; color: #6366f1;">71%–80%</td>
            <td style="padding: 13px 14px; font-weight: 700;">B1</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">8</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">First Class (80%+)</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">B+ (First Class)</td>
          </tr>
