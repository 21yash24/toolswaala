---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { PercentageCalc } from '../react-pages/students';

const title = "Marks to Percentage Calculator 2026 | Madhyamik, HSC & Plus Two Marks %";
const description = "Calculate exam marks percentage for 10th Result, HSC, Madhyamik, and Plus Two board exams. Official marks to percentage formula, grade calculator, and cutoff guide.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/percentage-calculator">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala Marks to Percentage Calculator",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.98",
        "ratingCount": "3420"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I calculate marks to percentage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To calculate your exam percentage: (Marks Scored / Total Maximum Marks) × 100. Example: 450 marks out of 500 = (450 / 500) × 100 = 90%."
          }
        },
        {
          "@type": "Question",
          "name": "What is the formula for percentage calculator of marks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Percentage = (Obtained Marks ÷ Total Marks) × 100. This works for CBSE, ICSE, State Boards, and University semester exams."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="Marks to Percentage Calculator" hindi="मार्क्स प्रतिशत कैलकुलेटर" client:load>
    <PercentageCalc client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article class="seo-article">

    <!-- Quick Answer Box -->
    <div style="background: rgba(99,102,241,0.08); border: 2px solid rgba(99,102,241,0.3); border-radius: 16px; padding: 24px; margin-bottom: 32px;">
      <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; color: #6366f1; margin-bottom: 8px; letter-spacing: 0.05em;">⚡ Quick Answer</div>
      <h2 style="font-size: 20px; font-weight: 800; color: var(--app-text); margin-bottom: 12px;">How to Calculate Percentage of Marks?</h2>
      <p style="font-size: 15px; color: var(--app-text-secondary); line-height: 1.7; margin: 0;">
        <strong>Percentage = (Marks Obtained ÷ Total Maximum Marks) × 100</strong><br /><br />
        Example: You scored <strong>432 out of 500</strong> in HSC/12th Board →<br />
        Percentage = (432 ÷ 500) × 100 = <strong style="color: #6366f1; font-size: 18px;">86.4%</strong>
      </p>
    </div>

    <h2 style="font-size: clamp(22px, 3.5vw, 32px); font-weight: 800; color: var(--app-text); margin-bottom: 20px; letter-spacing: -0.02em;">
      Marks to Percentage Calculator — All Boards & Exams (2026)
    </h2>

    <!-- All 5 Formulas -->
    <h3 style="font-size: 20px; font-weight: 800; color: var(--app-text); margin-bottom: 16px;">🧮 5 Essential Percentage Formulas (With Examples)</h3>
    <div style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 36px;">
      <div style="background: rgba(99,102,241,0.07); border: 1px solid rgba(99,102,241,0.25); border-radius: 14px; padding: 18px 20px;">
        <div style="font-size: 12px; font-weight: 700; color: #6366f1; margin-bottom: 6px; text-transform: uppercase;">Formula 1: Marks to Percentage (Exam Results)</div>
        <code style="font-size: 14px; font-weight: 700; color: var(--app-text); display: block; margin-bottom: 6px;">% = (Marks Scored ÷ Total Marks) × 100</code>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0;">Example: 378 out of 600 marks → (378 ÷ 600) × 100 = <strong>63.0%</strong></p>
      </div>
      <div style="background: rgba(16,185,129,0.07); border: 1px solid rgba(16,185,129,0.25); border-radius: 14px; padding: 18px 20px;">
        <div style="font-size: 12px; font-weight: 700; color: #10b981; margin-bottom: 6px; text-transform: uppercase;">Formula 2: Percentage Increase (Salary Hike / Price Rise)</div>
        <code style="font-size: 14px; font-weight: 700; color: var(--app-text); display: block; margin-bottom: 6px;">% Increase = ((New Value − Old Value) ÷ Old Value) × 100</code>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0;">Example: Salary goes from ₹40,000 to ₹48,000 → ((48,000−40,000)÷40,000)×100 = <strong>20% hike</strong></p>
      </div>
      <div style="background: rgba(239,68,68,0.07); border: 1px solid rgba(239,68,68,0.25); border-radius: 14px; padding: 18px 20px;">
        <div style="font-size: 12px; font-weight: 700; color: #ef4444; margin-bottom: 6px; text-transform: uppercase;">Formula 3: Percentage Decrease (Discount / Price Drop)</div>
        <code style="font-size: 14px; font-weight: 700; color: var(--app-text); display: block; margin-bottom: 6px;">% Decrease = ((Old Value − New Value) ÷ Old Value) × 100</code>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0;">Example: Product drops from ₹2,000 to ₹1,500 → ((2000−1500)÷2000)×100 = <strong>25% off</strong></p>
      </div>
      <div style="background: rgba(245,158,11,0.07); border: 1px solid rgba(245,158,11,0.25); border-radius: 14px; padding: 18px 20px;">
        <div style="font-size: 12px; font-weight: 700; color: #f59e0b; margin-bottom: 6px; text-transform: uppercase;">Formula 4: What is X% of a Number?</div>
        <code style="font-size: 14px; font-weight: 700; color: var(--app-text); display: block; margin-bottom: 6px;">Value = (X ÷ 100) × Total Number</code>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0;">Example: What is 35% of 800? → (35 ÷ 100) × 800 = <strong>280</strong></p>
      </div>
      <div style="background: rgba(236,72,153,0.07); border: 1px solid rgba(236,72,153,0.25); border-radius: 14px; padding: 18px 20px;">
        <div style="font-size: 12px; font-weight: 700; color: #ec4899; margin-bottom: 6px; text-transform: uppercase;">Formula 5: Reverse — Marks from Percentage</div>
        <code style="font-size: 14px; font-weight: 700; color: var(--app-text); display: block; margin-bottom: 6px;">Marks = (Percentage ÷ 100) × Total Marks</code>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0;">Example: I scored 72% in a 500-mark exam → (72 ÷ 100) × 500 = <strong>360 marks</strong></p>
      </div>
    </div>

    <!-- Marks-to-% Lookup Table -->
    <h3 style="font-size: 20px; font-weight: 800; color: var(--app-text); margin-bottom: 16px;">📊 Marks to Percentage — Ready Reference Table</h3>
    <p style="font-size: 14px; color: var(--app-text-secondary); margin-bottom: 16px; line-height: 1.6;">Common exam totals: CBSE Class 10 and 12 (500 marks, 5 subjects × 100), Kerala/Tamil Nadu Plus Two (1200 marks), Madhyamik WB (500 marks):</p>
    <div class="seo-table-wrapper" style="margin-bottom: 36px;">
      <table class="seo-table">
