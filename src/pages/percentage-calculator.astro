---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { PercentageCalc } from '../react-pages/students';

const title = "Percentage Calculator Online 2025 | Marks & Percentage Difference Calculator";
const description = "Calculate percentage of marks, percentage increase/decrease, reverse percentage, and CBSE exam grade boundaries. 100% free online calculator.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/percentage-calculator">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala Percentage Calculator",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.96",
        "ratingCount": "2890"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the formula to calculate percentage of marks scored?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To calculate your exam percentage: Percentage = (Marks Obtained / Total Maximum Marks) × 100. For example, 450 out of 500 = (450 / 500) × 100 = 90%."
          }
        },
        {
          "@type": "Question",
          "name": "How to calculate percentage increase or decrease between two numbers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Percentage Change = ((New Value - Original Value) / Original Value) × 100. A positive result indicates a percentage increase, while a negative result indicates a percentage decrease."
          }
        },
        {
          "@type": "Question",
          "name": "How do I calculate reverse percentage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To find the original price before a discount or tax: Original Value = Final Value / (1 - (Discount % / 100))."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="Percentage Calculator" hindi="प्रतिशत कैलकुलेटर" client:load>
    <PercentageCalc client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article style="max-width: 900px; margin: 60px auto 40px; padding: 0 24px; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; line-height: 1.7; color: var(--app-text);">
    

    <h2 style="font-size: clamp(24px, 4vw, 36px); font-weight: 800; color: var(--app-text); margin-bottom: 16px; letter-spacing: -0.02em;">
      Percentage Calculator Online 2025 (Marks & Percentage Change)
    </h2>
    
    <p style="font-size: 16px; color: var(--app-text-secondary); margin-bottom: 32px; line-height: 1.7;">
      Calculate student exam percentages, <strong>percentage increase/decrease, salary hike percentage, discount calculations, and reverse percentage</strong> instantly.
    </p>

    <div style="background: var(--app-surface-card); border: 1px solid var(--app-border); border-radius: 20px; padding: 28px; margin-bottom: 40px; box-shadow: 0 4px 20px -2px rgba(0,0,0,0.05);">
      <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Essential Percentage Formulas</h3>
      <div class="space-y-4 text-slate-700 dark:text-slate-300 text-sm">
        <div>
          <p class="font-semibold text-slate-900 dark:text-white">1. Student Exam Percentage:</p>
          <code class="block bg-white dark:bg-slate-900 p-2.5 rounded border border-slate-200 dark:border-slate-800 mt-1 font-mono text-indigo-600 dark:text-indigo-400">
            Percentage (%) = (Total Scored Marks / Total Maximum Marks) × 100
          </code>
        </div>
        <div>
          <p class="font-semibold text-slate-900 dark:text-white">2. Percentage Increase (Salary Hike / Price Growth):</p>
          <code class="block bg-white dark:bg-slate-900 p-2.5 rounded border border-slate-200 dark:border-slate-800 mt-1 font-mono text-emerald-600 dark:text-emerald-400">
            Hike % = ((New Salary - Old Salary) / Old Salary) × 100
          </code>
        </div>
      </div>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">CBSE Class 10 & 12 Percentage Grade Scale Table</h3>
    <div class="overflow-x-auto mb-10">
      <table style="width: 100%; border-collapse: collapse; border: 1px solid var(--app-border); border-radius: 16px; overflow: hidden; font-size: 14px; background: var(--app-surface-card);">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Marks Percentage Range</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">CBSE Letter Grade</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Grade Point (GP)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td class="p-3 font-semibold text-emerald-600">91% – 100%</td>
            <td class="p-3 font-bold">A1</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">10.0</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td class="p-3 font-semibold text-emerald-600">81% – 90%</td>
            <td class="p-3 font-bold">A2</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">9.0</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td class="p-3 font-semibold text-indigo-600">71% – 80%</td>
            <td class="p-3 font-bold">B1</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">8.0</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td class="p-3 font-semibold text-indigo-600">61% – 70%</td>
            <td class="p-3 font-bold">B2</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">7.0</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td class="p-3 font-semibold text-amber-600">51% – 60%</td>
            <td class="p-3 font-bold">C1</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">6.0</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Frequently Asked Questions (FAQs)</h3>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">What is the formula to calculate percentage of marks scored?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          Percentage = (Marks Obtained / Total Maximum Marks) × 100. For example, 450 out of 500 = (450 / 500) × 100 = 90%.
        </p>
      </div>
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">How to calculate percentage increase or decrease?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          Percentage Change = ((New Value - Original Value) / Original Value) × 100.
        </p>
      </div>
    </div>
  </article>
</Layout>