        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 12px 14px; font-weight: 700;">500 / 600 / 1000 / 1200</td><td style="padding: 12px 14px; color: #6366f1; font-weight: 700;">100%</td><td style="padding: 12px 14px; color: #f97316; font-weight: 700;">100%</td><td style="padding: 12px 14px; color: #10b981; font-weight: 700;">100%</td><td style="padding: 12px 14px; color: #ec4899; font-weight: 700;">100%</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);"><td style="padding: 12px 14px; font-weight: 700;">475 / 570 / 950 / 1140</td><td style="padding: 12px 14px; color: #6366f1; font-weight: 700;">95%</td><td style="padding: 12px 14px; color: #f97316; font-weight: 700;">95%</td><td style="padding: 12px 14px; color: #10b981; font-weight: 700;">95%</td><td style="padding: 12px 14px; color: #ec4899; font-weight: 700;">95%</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 12px 14px; font-weight: 700;">450 / 540 / 900 / 1080</td><td style="padding: 12px 14px; color: #6366f1; font-weight: 700;">90%</td><td style="padding: 12px 14px; color: #f97316; font-weight: 700;">90%</td><td style="padding: 12px 14px; color: #10b981; font-weight: 700;">90%</td><td style="padding: 12px 14px; color: #ec4899; font-weight: 700;">90%</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);"><td style="padding: 12px 14px; font-weight: 700;">425 / 510 / 850 / 1020</td><td style="padding: 12px 14px; color: #6366f1; font-weight: 700;">85%</td><td style="padding: 12px 14px; color: #f97316; font-weight: 700;">85%</td><td style="padding: 12px 14px; color: #10b981; font-weight: 700;">85%</td><td style="padding: 12px 14px; color: #ec4899; font-weight: 700;">85%</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 12px 14px; font-weight: 700;">400 / 480 / 800 / 960</td><td style="padding: 12px 14px; color: #6366f1; font-weight: 700;">80%</td><td style="padding: 12px 14px; color: #f97316; font-weight: 700;">80%</td><td style="padding: 12px 14px; color: #10b981; font-weight: 700;">80%</td><td style="padding: 12px 14px; color: #ec4899; font-weight: 700;">80%</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);"><td style="padding: 12px 14px; font-weight: 700;">375 / 450 / 750 / 900</td><td style="padding: 12px 14px; color: #6366f1; font-weight: 700;">75%</td><td style="padding: 12px 14px; color: #f97316; font-weight: 700;">75%</td><td style="padding: 12px 14px; color: #10b981; font-weight: 700;">75%</td><td style="padding: 12px 14px; color: #ec4899; font-weight: 700;">75%</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 12px 14px; font-weight: 700;">350 / 420 / 700 / 840</td><td style="padding: 12px 14px; color: #f59e0b; font-weight: 700;">70%</td><td style="padding: 12px 14px; color: #f59e0b; font-weight: 700;">70%</td><td style="padding: 12px 14px; color: #f59e0b; font-weight: 700;">70%</td><td style="padding: 12px 14px; color: #f59e0b; font-weight: 700;">70%</td></tr>
          <tr style="background: rgba(0,0,0,0.02);"><td style="padding: 12px 14px; font-weight: 700;">300 / 360 / 600 / 720</td><td style="padding: 12px 14px; color: #ef4444; font-weight: 700;">60%</td><td style="padding: 12px 14px; color: #ef4444; font-weight: 700;">60%</td><td style="padding: 12px 14px; color: #ef4444; font-weight: 700;">60%</td><td style="padding: 12px 14px; color: #ef4444; font-weight: 700;">60%</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Board-wise Grade Tables -->
    <h3 style="font-size: 20px; font-weight: 800; color: var(--app-text); margin-bottom: 16px;">🏫 Board-wise Grading Scale Reference (CBSE, Madhyamik, HSC, Plus Two)</h3>
    <div class="seo-table-wrapper" style="margin-bottom: 36px;">
      <table class="seo-table">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 13px 14px; font-weight: 800; color: var(--app-text);">Percentage Range</th>
            <th style="padding: 13px 14px; font-weight: 800; color: var(--app-text);">CBSE Grade</th>
            <th style="padding: 13px 14px; font-weight: 800; color: var(--app-text);">Grade Point</th>
            <th style="padding: 13px 14px; font-weight: 800; color: var(--app-text);">WB Madhyamik</th>
            <th style="padding: 13px 14px; font-weight: 800; color: var(--app-text);">TN / Kerala Plus Two</th>
          </tr>
        </thead>
        <tbody>
