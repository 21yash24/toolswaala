            <td style="padding: 13px 14px; font-weight: 700;">B2</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">7</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">First Class</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">B (Second Class)</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 13px 14px; font-weight: 700; color: #f59e0b;">51%–60%</td>
            <td style="padding: 13px 14px; font-weight: 700;">C1</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">6</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">Second Class</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">C (Pass)</td>
