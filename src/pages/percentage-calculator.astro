          <tr>
            <th style="padding: 12px 14px; font-weight: 800; color: var(--app-text);">Marks Scored</th>
            <th style="padding: 12px 14px; font-weight: 800; color: #6366f1;">Out of 500</th>
            <th style="padding: 12px 14px; font-weight: 800; color: #f97316;">Out of 600</th>
            <th style="padding: 12px 14px; font-weight: 800; color: #10b981;">Out of 1000</th>
            <th style="padding: 12px 14px; font-weight: 800; color: #ec4899;">Out of 1200</th>
