---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { FdCalcTool } from '../react-pages/BusinessTools';

const title = "FD Calculator India 2025 | Fixed Deposit Interest & Maturity Calculator";
const description = "Calculate Fixed Deposit (FD) interest payout and maturity amount for SBI, HDFC, ICICI, and Post Office FDs. Includes Senior Citizen rates and 5-Year Tax Saver FD.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/fd-calculator">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala FD Calculator India",
      "operatingSystem": "All",
      "applicationCategory": "FinancialApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.96",
        "ratingCount": "2980"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the mathematical formula for Fixed Deposit (FD) interest calculation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Indian banks calculate FD interest on a quarterly compounding basis using the compound interest formula: A = P × (1 + r/n)^(n × t), where A is Maturity Amount, P is Principal Deposit, r is annual interest rate in decimals, n is compounding frequency (4 for quarterly), and t is total tenure in years."
          }
        },
        {
          "@type": "Question",
          "name": "What is the TDS threshold for FD interest in India?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Under Section 194A, banks deduct 10% TDS if total FD interest earned across all branches exceeds ₹40,000 per year for regular individuals or ₹50,000 for Senior Citizens (aged 60+)."
          }
        },
        {
          "@type": "Question",
          "name": "How does a 5-Year Tax Saving FD work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Tax Saving FD has a mandatory 5-year lock-in period. Deposits up to ₹1,50,000 qualify for tax deduction under Section 80C of the Income Tax Act under the Old Tax Regime."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="FD Calculator" hindi="एफडी कैलकुलेटर" client:load>
    <FdCalcTool client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article class="seo-article">
    

    <h2 style="font-size: clamp(24px, 4vw, 36px); font-weight: 800; color: var(--app-text); margin-bottom: 16px; letter-spacing: -0.02em;">
      FD Calculator India 2025 (Fixed Deposit Maturity & Interest)
    </h2>
    
    <p style="font-size: 16px; color: var(--app-text-secondary); margin-bottom: 32px; line-height: 1.7;">
      Calculate exact maturity values, interest earned, and quarterly compounding returns on your <strong>Fixed Deposits (FD)</strong> across <strong>State Bank of India (SBI), HDFC Bank, ICICI Bank, Post Office Time Deposit, and NBFCs</strong>.
    </p>

    <div style="background: var(--app-surface-card); border: 1px solid var(--app-border); border-radius: 20px; padding: 28px; margin-bottom: 40px; box-shadow: 0 4px 20px -2px rgba(0,0,0,0.05);">
      <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Quarterly Compounding Formula</h3>
      <code class="block bg-white dark:bg-slate-900 p-3 rounded-lg border border-slate-200 dark:border-slate-800 font-mono text-sm text-indigo-600 dark:text-indigo-400 mb-3">
        A = P × (1 + r / 4)^(4 × t)
      </code>
      <ul class="space-y-1 text-slate-700 dark:text-slate-300 text-xs">
        <li>📌 <strong>A:</strong> Total maturity amount received at completion of tenure.</li>
        <li>📌 <strong>P:</strong> Principal deposit amount (e.g., ₹1,00,000).</li>
        <li>📌 <strong>r:</strong> Annual interest rate decimal = <code>(Interest Rate % / 100)</code></li>
        <li>📌 <strong>t:</strong> Deposit tenure in years.</li>
      </ul>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Top Indian Bank FD Interest Rates 2025</h3>
    <p style="font-size: 15px; color: var(--app-text-secondary); margin-bottom: 24px; line-height: 1.7;">Current interest rates offered for 1 to 5-year tenures:</p>

    <div class="seo-table-wrapper">
      <table class="seo-table">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Bank / Institution</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">General Public Rate (1-3 Yrs)</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Senior Citizen Rate (+0.50%)</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">5-Yr Tax Saver FD Rate</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">State Bank of India (SBI)</td>
            <td class="p-3 text-emerald-600 font-medium">6.80% - 7.00%</td>
            <td class="p-3 font-bold text-emerald-600">7.30% - 7.50%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">6.50%</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">HDFC Bank</td>
            <td class="p-3 text-emerald-600 font-medium">7.10% - 7.25%</td>
            <td class="p-3 font-bold text-emerald-600">7.60% - 7.75%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">7.00%</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">ICICI Bank</td>
            <td class="p-3 text-emerald-600 font-medium">7.00% - 7.20%</td>
            <td class="p-3 font-bold text-emerald-600">7.50% - 7.75%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">7.00%</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Post Office Time Deposit</td>
            <td class="p-3 text-emerald-600 font-medium">6.90% - 7.10%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">7.10%</td>
            <td class="p-3 text-indigo-600 font-bold">7.50%</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Frequently Asked Questions (FAQs)</h3>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">What is the TDS threshold for FD interest in India?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          Under Section 194A, banks deduct 10% TDS if total FD interest earned exceeds ₹40,000 per year for regular individuals or ₹50,000 for Senior Citizens.
        </p>
      </div>
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">How to avoid TDS deduction on FD interest?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          If your total annual taxable income is below the basic exemption slab, submit Form 15G (for individuals below 60) or Form 15H (for Senior Citizens) to your bank at the start of the financial year.
        </p>
      </div>
    </div>
  </article>
</Layout>