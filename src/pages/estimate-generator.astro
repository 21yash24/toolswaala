---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { EstimateTool } from '../react-pages/BusinessTools';

const title = "Free Estimate Generator — Quotation Maker";
const description = "Create pre-sales quotations and estimates with discounts and PDF export.";

const faqs = [
  {
    "q": "What is the difference between an estimate and a quotation?",
    "a": "An estimate is a realistic guess of the project costs and is not legally binding. A quotation is a fixed price offer that, if accepted, becomes legally binding."
  },
  {
    "q": "Can I download my estimates as PDF?",
    "a": "Yes! Our estimate generator allows you to customize discounts, taxes, and items, and instantly download a professional PDF copy."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/estimate-generator">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"Free Estimate Generator — Quotation Maker","item":"https://toolswaala.in/estimate-generator"}]}</script>

  <PageWrapper title={title} hindi="अनुमान" client:load>
    <EstimateTool client:only="react" />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; Free Estimate Generator — Quotation Maker</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>