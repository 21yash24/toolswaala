---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { GstInvoiceTool } from '../react-pages/BusinessTools';

const title = "Free GST Invoice Generator India 2025 | B2B & B2C Tax Bill Creator";
const description = "Create tax-compliant GST invoices for small businesses, freelancers, and traders in India. Auto-calculate HSN codes, CGST, SGST, IGST, and download PDF.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/gst-invoice">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala GST Invoice Generator",
      "operatingSystem": "All",
      "applicationCategory": "BusinessApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.96",
        "ratingCount": "3210"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are the mandatory 16 details required on a valid GST invoice?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Under Rule 46 of CGST Rules 2017, a valid tax invoice must contain: Supplier Name, Address & GSTIN, Consecutive Invoice Number, Date of Issue, Buyer GSTIN & Name, Place of Supply, HSN/SAC Code, Item Description, Quantity, Unit Rate, Total Taxable Value, CGST/SGST/IGST rates & amounts, Signature of Supplier."
          }
        },
        {
          "@type": "Question",
          "name": "How many HSN code digits are mandatory for my turnover?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Businesses with turnover up to ₹5 Crore require 4-digit HSN codes for B2B invoices. Businesses with turnover exceeding ₹5 Crore must report 6-digit HSN codes on all invoices."
          }
        },
        {
          "@type": "Question",
          "name": "What is the threshold limit for mandatory GST Registration?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GST registration is mandatory for businesses supplying goods with annual turnover exceeding ₹40 Lakh (₹20 Lakh for Special Category States) or service providers with turnover exceeding ₹20 Lakh (₹10 Lakh for Special Category States)."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="GST Invoice Generator" hindi="चालान" client:load>
    <GstInvoiceTool client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article class="max-w-4xl mx-auto px-4 py-8 text-slate-800 dark:text-slate-200 leading-relaxed font-sans">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:underline">Home</a> &gt; <a href="/legal-hub" class="hover:underline">Business Tools</a> &gt; <span class="font-medium text-slate-700 dark:text-slate-300">GST Invoice Generator</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
      Free GST Invoice Generator 2025 (Rule 46 Tax Bill Creator)
    </h1>
    
    <p class="text-lg text-slate-600 dark:text-slate-300 mb-8">
      Generate professional, GST-compliant <strong>B2B and B2C tax invoices</strong> for small businesses, IT freelancers, wholesalers, and service providers across India. Download print-ready PDF bills with <strong>HSN/SAC codes and CGST/SGST/IGST splits</strong>.
    </p>

    <div class="bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 rounded-xl p-6 mb-8">
      <h2 class="text-xl font-bold text-indigo-950 dark:text-indigo-200 mb-3">Rule 46 Mandatory Invoice Components</h2>
      <ul class="space-y-2 text-slate-700 dark:text-slate-300 text-sm">
        <li>📌 <strong>GSTIN & Business Details:</strong> Valid 15-digit GST Identification Number for both supplier and recipient.</li>
        <li>📌 <strong>Sequential Invoice Numbering:</strong> Unique alphanumeric series per financial year (e.g. <code>INV/2025-26/001</code>).</li>
        <li>📌 <strong>HSN / SAC Codes:</strong> 4-digit or 6-digit Harmonized System of Nomenclature code per item.</li>
        <li>📌 <strong>State Code & Place of Supply:</strong> Mandatory to determine whether CGST+SGST or IGST applies.</li>
      </ul>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">HSN Code Mandatory Digits Table</h2>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-left border-collapse border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden text-sm">
        <thead class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-semibold">
          <tr>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Annual Aggregate Turnover (AATO)</th>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Mandatory HSN Digits (B2B)</th>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Mandatory HSN Digits (B2C)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Up to ₹5 Crore</td>
            <td class="p-3 text-indigo-600 font-medium">4 Digits</td>
            <td class="p-3">Optional (4 Digits recommended)</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Above ₹5 Crore</td>
            <td class="p-3 text-indigo-600 font-bold">6 Digits</td>
            <td class="p-3 text-indigo-600 font-bold">6 Digits</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Chemicals & Hazardous Goods</td>
            <td class="p-3 text-amber-600 font-bold">8 Digits</td>
            <td class="p-3 text-amber-600 font-bold">8 Digits</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Frequently Asked Questions (FAQs)</h2>
    <div class="space-y-6">
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">What are the mandatory 16 details required on a valid GST invoice?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          Under Rule 46 of CGST Rules 2017, a valid tax invoice must contain: Supplier Name, Address & GSTIN, Consecutive Invoice Number, Date, Buyer GSTIN, Place of Supply, HSN/SAC Code, Taxable Value, GST amounts, and Signature.
        </p>
      </div>
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">What is the threshold limit for mandatory GST Registration?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          GST registration is mandatory for businesses supplying goods with annual turnover exceeding ₹40 Lakh (₹20 Lakh for Special Category States) or service providers exceeding ₹20 Lakh.
        </p>
      </div>
    </div>
  </article>
</Layout>