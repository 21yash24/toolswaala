---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { JobFinder } from '../react-pages/students';

const title = "Latest Govt & Private Jobs India 2025 | Sarkari Naukri & Fresher Off-Campus Drives";
const description = "Track latest Sarkari Naukri notifications, SSC CGL, UPSC IAS, IBPS Bank PO, Railway RRB, and TCS/Infosys/Wipro IT off-campus hiring for freshers.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/job-finder">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala Job Finder India",
      "operatingSystem": "All",
      "applicationCategory": "EducationalApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.96",
        "ratingCount": "3450"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How to track official Sarkari Naukri notifications across India?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ToolsWaala aggregates daily job notifications directly from official central and state government portals including SSC (ssc.gov.in), UPSC (upsc.gov.in), IBPS (ibps.in), and Railway Recruitment Boards (RRB)."
          }
        },
        {
          "@type": "Question",
          "name": "Which IT companies conduct off-campus drives for B.Tech / BCA freshers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Top IT services companies like TCS (NQT), Infosys (HackWithInfy / InfyTq), Wipro (Elite NTH), Accenture, and Cognizant conduct nation-wide off-campus recruitment drives for fresh graduates."
          }
        },
        {
          "@type": "Question",
          "name": "What documents are required for government job applications?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Essential documents include: Class 10/12 Marksheets, Graduation Degree/Provisional Certificate, Category Certificate (OBC/SC/ST/EWS), Aadhaar/PAN ID proof, and scanned Passport Photo."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="Job Finder" hindi="जॉब फाइंडर" client:load>
    <JobFinder client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article style="max-width: 900px; margin: 60px auto 40px; padding: 0 24px; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; line-height: 1.7; color: var(--app-text);">
    

    <h2 style="font-size: clamp(24px, 4vw, 36px); font-weight: 800; color: var(--app-text); margin-bottom: 16px; letter-spacing: -0.02em;">
      Latest Govt & Private Jobs India 2025 (Sarkari Naukri Portal)
    </h2>
    
    <p style="font-size: 16px; color: var(--app-text-secondary); margin-bottom: 32px; line-height: 1.7;">
      Discover verified <strong>Sarkari Naukri notifications, Admit Cards, Exam Results, Bank PO vacancies, SSC CGL/CHSL jobs, and IT Off-Campus Drives</strong> for fresh 2024 and 2025 graduates.
    </p>

    <div style="background: var(--app-surface-card); border: 1px solid var(--app-border); border-radius: 20px; padding: 28px; margin-bottom: 40px; box-shadow: 0 4px 20px -2px rgba(0,0,0,0.05);">
      <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Top Indian Job Recruitment Sectors</h3>
      <ul class="space-y-2 text-slate-700 dark:text-slate-300 text-sm">
        <li>📌 <strong>Staff Selection Commission (SSC):</strong> CGL, CHSL, MTS, CPO, and Stenographer exams.</li>
        <li>📌 <strong>Banking & Financial Sector (IBPS / SBI):</strong> Probationary Officer (PO), Specialist Officer (SO), and Clerical cadres.</li>
        <li>📌 <strong>Railways (RRB):</strong> Non-Technical Popular Categories (NTPC), Assistant Loco Pilot (ALP), and Group D.</li>
        <li>📌 <strong>IT & Software Engineering:</strong> Off-campus drives for Software Engineers, Full Stack Developers, and Data Analysts.</li>
      </ul>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Major Govt & IT Recruitment Exams Overview</h3>
    <div class="overflow-x-auto mb-10">
      <table style="width: 100%; border-collapse: collapse; border: 1px solid var(--app-border); border-radius: 16px; overflow: hidden; font-size: 14px; background: var(--app-surface-card);">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Exam / Drive Name</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Eligible Qualification</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Age Limit (General Category)</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Official Portal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">UPSC Civil Services (IAS/IPS)</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">Bachelor's Degree (Any Stream)</td>
            <td class="p-3 font-medium">21 – 32 Years</td>
            <td class="p-3 text-indigo-600 font-medium">upsc.gov.in</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">SSC Combined Graduate Level (CGL)</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">Bachelor's Degree</td>
            <td class="p-3 font-medium">18 – 30 Years</td>
            <td class="p-3 text-indigo-600 font-medium">ssc.gov.in</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">IBPS Bank PO / Clerk</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">Graduation in any discipline</td>
            <td class="p-3 font-medium">20 – 30 Years</td>
            <td class="p-3 text-indigo-600 font-medium">ibps.in</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">TCS National Qualifier Test (NQT)</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">B.E / B.Tech / MCA / M.Sc</td>
            <td class="p-3 font-medium">Freshers (Passout 2024/2025)</td>
            <td class="p-3 text-indigo-600 font-medium">tcs.com/careers</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Frequently Asked Questions (FAQs)</h3>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">How to find the latest Sarkari Naukri?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          ToolsWaala is updated daily with the latest government jobs, SSC, UPSC, and Bank PO vacancies directly from official government portals.
        </p>
      </div>
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Are these jobs verified?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          Yes, we only list jobs verified from official government portals and company career pages.
        </p>
      </div>
    </div>
  </article>
</Layout>