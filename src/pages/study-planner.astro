---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { StudyPlanner } from '../react-pages/students';

const title = "Free Exam Study Planner 2025 | Timetable Creator & Countdown Tracker";
const description = "Create personalized exam study timetables for JEE, NEET, UPSC, GATE, and semester exams. Active recall & spaced repetition study schedule tracker.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/study-planner">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala Exam Study Planner",
      "operatingSystem": "All",
      "applicationCategory": "EducationalApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.96",
        "ratingCount": "3120"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the Spaced Repetition method for exam preparation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Spaced Repetition is a scientific learning technique where subject topics are reviewed at increasing time intervals (Day 1, Day 3, Day 7, Day 14, Day 30) to lock information permanently into long-term memory."
          }
        },
        {
          "@type": "Question",
          "name": "How many hours should a student study daily for competitive exams like JEE/NEET?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For competitive exams like JEE Main/Advanced, NEET, and GATE, 6 to 8 hours of focused self-study (excluding coaching classes) divided into 90-minute deep focus blocks is recommended."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between Active Recall and Passive Reading?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Passive reading involves highlighting or re-reading textbooks. Active recall forces your brain to retrieve answers from memory using flashcards, practice questions, or teaching concepts aloud without looking at notes."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="Study Planner" hindi="स्टडी प्लानर" client:load>
    <StudyPlanner client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article class="max-w-4xl mx-auto px-4 py-8 text-slate-800 dark:text-slate-200 leading-relaxed font-sans">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:underline">Home</a> &gt; <a href="/students" class="hover:underline">Student Tools</a> &gt; <span class="font-medium text-slate-700 dark:text-slate-300">Study Planner</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
      Free Exam Study Planner 2025 (Timetable & Countdown Tracker)
    </h1>
    
    <p class="text-lg text-slate-600 dark:text-slate-300 mb-8">
      Design a high-scoring <strong>daily and weekly study timetable</strong>. Built for <strong>JEE Main/Advanced, NEET, GATE, UPSC, CBSE Board, and College Semester Exams</strong> with live countdown timers and habit trackers.
    </p>

    <div class="bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 rounded-xl p-6 mb-8">
      <h2 class="text-xl font-bold text-indigo-950 dark:text-indigo-200 mb-3">Scientifically Proven Revision Schedule (Spaced Repetition)</h2>
      <ul class="space-y-2 text-slate-700 dark:text-slate-300 text-sm">
        <li>📌 <strong>First Review (Day 1):</strong> Review core chapter notes within 24 hours of first reading.</li>
        <li>📌 <strong>Second Review (Day 3):</strong> Solve 15 numericals or previous year questions (PYQs) without referring to solutions.</li>
        <li>📌 <strong>Third Review (Day 7):</strong> Rapid 15-minute formula sheet summary check.</li>
        <li>📌 <strong>Fourth Review (Day 30):</strong> Full chapter mock test attempt.</li>
      </ul>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Recommended Daily Study Time Allocations</h2>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-left border-collapse border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden text-sm">
        <thead class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-semibold">
          <tr>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Exam Category</th>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Recommended Self-Study Hours</th>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Key Focus Ratio (Theory vs PYQs)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">JEE Main / NEET UG</td>
            <td class="p-3 text-indigo-600 font-medium">7 - 9 Hours / Day</td>
            <td class="p-3">30% Theory Concepts : 70% PYQs & Mock Tests</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">UPSC Civil Services</td>
            <td class="p-3 text-indigo-600 font-medium">8 - 10 Hours / Day</td>
            <td class="p-3">50% NCERT/Standard Books : 50% Answer Writing & Current Affairs</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">GATE Engineering</td>
            <td class="p-3 text-indigo-600 font-medium">6 - 8 Hours / Day</td>
            <td class="p-3">40% Subject Revision : 60% Virtual Calculator PYQ Practice</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">College Semester Exams</td>
            <td class="p-3 text-indigo-600 font-medium">3 - 4 Hours / Day</td>
            <td class="p-3">60% Syllabus Coverage : 40% University Question Bank</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Frequently Asked Questions (FAQs)</h2>
    <div class="space-y-6">
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">What is the Spaced Repetition method for exam preparation?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          Spaced Repetition is a scientific learning technique where subject topics are reviewed at increasing time intervals (Day 1, Day 3, Day 7, Day 14, Day 30) to lock information permanently into long-term memory.
        </p>
      </div>
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">What is the difference between Active Recall and Passive Reading?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          Passive reading involves highlighting text. Active recall forces your brain to retrieve answers from memory using practice questions or flashcards without looking at solutions.
        </p>
      </div>
    </div>
  </article>
</Layout>