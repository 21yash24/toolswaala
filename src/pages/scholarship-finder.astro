---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { ScholarshipFinder } from '../react-pages/students';

const title = "Scholarship Finder India 2025 | 50+ Fully Funded Govt & Foreign Scholarships";
const description = "Directory of government, private, and international scholarships for Indian students. Apply for NSP, AICTE Pragati, Chevening, Fulbright, and DAAD scholarships.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/scholarship-finder">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala Scholarship Finder India",
      "operatingSystem": "All",
      "applicationCategory": "EducationalApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.96",
        "ratingCount": "2910"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are the best central government scholarships for Indian college students?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Top Central Government scholarships include NSP Post-Matric Scholarship, DST INSPIRE Scholarship (₹80,000/yr for basic sciences), AICTE Pragati Scholarship for Girls (₹50,000/yr), and Central Sector Scheme for University Students."
          }
        },
        {
          "@type": "Question",
          "name": "Can Indian students get 100% fully funded scholarships to study abroad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Prestigious global programs like the Chevening Scholarship (UK), Fulbright-Nehru Fellowship (USA), DAAD Scholarship (Germany), and Erasmus Mundus (Europe) cover 100% tuition fees, monthly living stipend, visa, and round-trip airfare."
          }
        },
        {
          "@type": "Question",
          "name": "What documents are required to apply for NSP scholarships?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Key NSP application documents include Aadhaar Card, Income Certificate from Tehsildar, Caste Certificate (if applicable), Marksheets of Previous Exam, Bank Passbook copy, and Bonafide Certificate from College."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="Scholarship Finder" hindi="छात्रवृत्ति खोजें" client:load>
    <ScholarshipFinder client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article class="max-w-4xl mx-auto px-4 py-8 text-slate-800 dark:text-slate-200 leading-relaxed font-sans">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:underline">Home</a> &gt; <a href="/students" class="hover:underline">Student Tools</a> &gt; <span class="font-medium text-slate-700 dark:text-slate-300">Scholarship Finder</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
      Scholarship Finder India 2025 (Govt & Foreign Fully Funded)
    </h1>
    
    <p class="text-lg text-slate-600 dark:text-slate-300 mb-8">
      Explore over 50+ verified <strong>Government of India scholarships (NSP, AICTE, DST)</strong> and <strong>International Fully-Funded Study Abroad Scholarships (UK, USA, Germany, Europe)</strong> for Class 10/12, B.Tech, B.Sc, MBBS, and MS applicants.
    </p>

    <div class="bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 rounded-xl p-6 mb-8">
      <h2 class="text-xl font-bold text-indigo-950 dark:text-indigo-200 mb-3">Top Fully-Funded International Scholarships</h2>
      <p class="text-slate-700 dark:text-slate-300 text-sm mb-3">
        Prestigious global scholarships awarded to Indian graduates for Master's and PhD programs:
      </p>
      <ul class="space-y-1 text-slate-700 dark:text-slate-300 text-xs">
        <li>📌 <strong>Chevening Scholarship (UK):</strong> 100% tuition + £1,300 monthly stipend + flight tickets.</li>
        <li>📌 <strong>DAAD Scholarship (Germany):</strong> €934 monthly stipend + health insurance + free tuition at public German universities.</li>
        <li>📌 <strong>Fulbright-Nehru (USA):</strong> Full tuition waiver + monthly stipend + J-1 visa sponsorship.</li>
        <li>📌 <strong>Erasmus Mundus (Europe):</strong> €1,400 monthly allowance for joint Master's degrees across 3 European countries.</li>
      </ul>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Indian Central & State Government Scholarships Directory</h2>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-left border-collapse border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden text-sm">
        <thead class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-semibold">
          <tr>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Scholarship Name</th>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Financial Assistance</th>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Eligibility Criteria</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">DST INSPIRE Scholarship (SHE)</td>
            <td class="p-3 text-emerald-600 font-medium">₹80,000 / Year</td>
            <td class="p-3">Top 1% in Class 12 Board pursuing B.Sc / M.Sc basic sciences.</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">AICTE Pragati Scheme for Girls</td>
            <td class="p-3 text-emerald-600 font-medium">₹50,000 / Year</td>
            <td class="p-3">Girl students admitted to 1st year B.Tech/Diploma (Income &lt; ₹8 LPA).</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Post-Matric Scholarship (NSP)</td>
            <td class="p-3 text-emerald-600 font-medium">Full Tuition + Maintenance Allowance</td>
            <td class="p-3">SC/ST/OBC category students (Family Income &lt; ₹2.5 LPA).</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Reliance Foundation Undergraduate</td>
            <td class="p-3 text-emerald-600 font-medium">Up to ₹2,00,000</td>
            <td class="p-3">Undergraduate degree students (Family Income &lt; ₹15 LPA).</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Frequently Asked Questions (FAQs)</h2>
    <div class="space-y-6">
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">What are the best central government scholarships for Indian college students?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          Top Central Government scholarships include NSP Post-Matric Scholarship, DST INSPIRE Scholarship (₹80,000/yr), and AICTE Pragati Scholarship (₹50,000/yr).
        </p>
      </div>
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Can Indian students get 100% fully funded scholarships to study abroad?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          Yes! Chevening (UK), Fulbright-Nehru (USA), DAAD (Germany), and Erasmus Mundus (Europe) cover 100% tuition fees, monthly living stipend, and airfare.
        </p>
      </div>
    </div>
  </article>
</Layout>