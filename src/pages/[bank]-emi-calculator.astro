---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { EmiTool } from '../react-pages/BusinessTools';
import banks from '../data/banks.json';

export async function getStaticPaths() {
  return banks.map((bank) => ({
    params: { bank: bank.id },
    props: { bank },
  }));
}

const { bank } = Astro.props;
const title = `${bank.name} EMI Calculator 2026 | Home, Car & Personal Loan Rates`;
const description = `Calculate monthly EMI for ${bank.name} home loans (${bank.homeInterest}), car loans (${bank.carInterest}), and personal loans (${bank.personalInterest}). Complete amortization breakdown.`;

const faqSchemaStr = `<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are current ${bank.shortName} loan interest rates in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "${bank.faq1}"
      }
    },
    {
      "@type": "Question",
      "name": "Does ${bank.shortName} charge prepayment penalties?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "${bank.faq2}"
      }
    }
  ]
}
</script>\n`;

const softwareSchema = `<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "ToolsWaala ${bank.shortName} EMI Calculator",
  "operatingSystem": "All",
  "applicationCategory": "FinancialApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  }
}
</script>\n`;
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath={`/${bank.id}`}>
  <Fragment set:html={softwareSchema} />
  <Fragment set:html={faqSchemaStr} />

  <PageWrapper title={`${bank.name} EMI Calculator`} description={`Calculate loan EMIs for ${bank.name} home loans, auto loans, and personal credit.`}>
    <EmiTool client:load />

    <div style="margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--app-border);" id="seo-content">
      <h2>{bank.name} Interest Rates &amp; EMI Guide (2026)</h2>
      <p>{bank.name} is one of India's leading financial institutions. Calculate your exact monthly loan repayments using official interest rates across key categories:</p>

      <div style="overflow-x:auto; margin: 24px 0;">
        <table style="width:100%; border-collapse:collapse; text-align:left; font-size:14px;">
          <thead>
            <tr style="border-bottom: 2px solid var(--app-border);">
              <th style="padding: 10px;">Loan Category</th>
              <th style="padding: 10px;">Indicative Interest Rate</th>
              <th style="padding: 10px;">Max Tenure</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--app-border);">
              <td style="padding: 10px;"><strong>{bank.shortName} Home Loan</strong></td>
              <td style="padding: 10px;">{bank.homeInterest}</td>
              <td style="padding: 10px;">Up to 30 Years</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--app-border);">
              <td style="padding: 10px;"><strong>{bank.shortName} Car Loan</strong></td>
              <td style="padding: 10px;">{bank.carInterest}</td>
              <td style="padding: 10px;">Up to 7 Years</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--app-border);">
              <td style="padding: 10px;"><strong>{bank.shortName} Personal Loan</strong></td>
              <td style="padding: 10px;">{bank.personalInterest}</td>
              <td style="padding: 10px;">Up to 5 Years</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>Other Bank EMI Calculators</h2>
      <ul style="display:flex; flex-wrap:wrap; gap:12px; list-style:none; padding:0; margin:16px 0;">
        {banks.map(b => (
          <li>
            <a href={`/${b.id}`} style="padding: 6px 14px; background: rgba(255,255,255,0.05); border: 1px solid var(--app-border); border-radius: 8px; font-weight:600; text-decoration:none;">
              {b.shortName} EMI Calculator →
            </a>
          </li>
        ))}
      </ul>
    </div>
  </PageWrapper>
</Layout>
