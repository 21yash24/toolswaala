---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { EmiTool } from '../react-pages/BusinessTools';

const title = "EMI Calculator India 2025 | Home, Car & Personal Loan Interest Calculator";
const description = "Calculate Equated Monthly Installment (EMI) for SBI, HDFC, ICICI home loans, car loans, and personal loans. Amortization schedule & interest formulas.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/emi-calculator">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala EMI Calculator India",
      "operatingSystem": "All",
      "applicationCategory": "FinancialApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.94",
        "ratingCount": "2410"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the mathematical formula for EMI calculation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The mathematical formula for calculating EMI is: EMI = [P × R × (1+R)^N] / [(1+R)^N - 1], where P is the Principal loan amount, R is the monthly interest rate (Annual Rate / 12 / 100), and N is the loan tenure in months."
          }
        },
        {
          "@type": "Question",
          "name": "What is FOIR (Fixed Obligation to Income Ratio) in home loans?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "FOIR is a parameter used by banks like SBI and HDFC to determine home loan eligibility. Most Indian banks restrict your total monthly EMIs to a maximum of 40% to 50% of your net monthly take-home salary."
          }
        },
        {
          "@type": "Question",
          "name": "How does pre-paying a loan reduce total interest?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Making partial prepayments directly reduces your principal balance. Since interest is calculated on the outstanding balance, prepayments either shorten your total loan tenure or lower your monthly EMI amount."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="EMI Calculator" hindi="ईएमआई" client:load>
    <EmiTool client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article style="max-width: 900px; margin: 60px auto 40px; padding: 0 24px; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; line-height: 1.7; color: var(--app-text);">
    

    <h2 style="font-size: clamp(24px, 4vw, 36px); font-weight: 800; color: var(--app-text); margin-bottom: 16px; letter-spacing: -0.02em;">
      EMI Calculator India 2025 (Home, Car & Personal Loans)
    </h2>
    
    <p style="font-size: 16px; color: var(--app-text-secondary); margin-bottom: 32px; line-height: 1.7;">
      Calculate exact <strong>Equated Monthly Installment (EMI)</strong> payouts, total interest payable, and total payment values for home loans, car loans, personal loans, and education loans across <strong>SBI, HDFC, ICICI, Axis Bank, and Kotak Mahindra</strong>.
    </p>

    <div style="background: var(--app-surface-card); border: 1px solid var(--app-border); border-radius: 20px; padding: 28px; margin-bottom: 40px; box-shadow: 0 4px 20px -2px rgba(0,0,0,0.05);">
      <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Official EMI Mathematical Formula</h3>
      <code class="block bg-white dark:bg-slate-900 p-3 rounded-lg border border-slate-200 dark:border-slate-800 font-mono text-sm text-indigo-600 dark:text-indigo-400 mb-3">
        EMI = [P × R × (1+R)^N] / [(1+R)^N - 1]
      </code>
      <ul class="space-y-1 text-slate-700 dark:text-slate-300 text-xs">
        <li>📌 <strong>P (Principal):</strong> Total loan amount borrowed from bank.</li>
        <li>📌 <strong>R (Rate):</strong> Monthly interest rate = <code>(Annual Interest Rate % / 12 / 100)</code></li>
        <li>📌 <strong>N (Tenure):</strong> Total number of monthly installments = <code>Tenure in Years × 12</code></li>
      </ul>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Current Bank Interest Rates Comparison 2025</h3>
    <p style="font-size: 15px; color: var(--app-text-secondary); margin-bottom: 24px; line-height: 1.7;">Typical interest rates offered by top Indian banks across loan categories:</p>

    <div class="overflow-x-auto mb-10">
      <table style="width: 100%; border-collapse: collapse; border: 1px solid var(--app-border); border-radius: 16px; overflow: hidden; font-size: 14px; background: var(--app-surface-card);">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Bank / Lender</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Home Loan Interest Rate</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Car Loan Interest Rate</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Personal Loan Interest Rate</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">State Bank of India (SBI)</td>
            <td class="p-3 text-emerald-600 font-medium">8.50% - 9.65%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">8.75% - 9.80%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">11.15% - 15.30%</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">HDFC Bank</td>
            <td class="p-3 text-emerald-600 font-medium">8.70% - 9.80%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">9.10% - 10.50%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">10.75% - 16.00%</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">ICICI Bank</td>
            <td class="p-3 text-emerald-600 font-medium">8.75% - 9.85%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">9.15% - 10.75%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">10.80% - 16.25%</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Axis Bank</td>
            <td class="p-3 text-emerald-600 font-medium">8.75% - 9.90%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">9.30% - 11.00%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">10.75% - 15.75%</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Factors That Impact Your Monthly EMI</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">1. Credit Score (CIBIL)</h4>
        <p class="text-xs text-slate-600 dark:text-slate-300">A CIBIL score of 750+ qualifies you for lowest interest rates, directly lowering your EMI.</p>
      </div>
      <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">2. Loan Tenure</h4>
        <p class="text-xs text-slate-600 dark:text-slate-300">Longer tenures reduce monthly EMI but drastically increase total interest paid over time.</p>
      </div>
      <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">3. Down Payment Amount</h4>
        <p class="text-xs text-slate-600 dark:text-slate-300">Paying a higher down payment upfront lowers the principal borrowed, reducing interest costs.</p>
      </div>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Frequently Asked Questions (FAQs)</h3>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">What is the mathematical formula for EMI calculation?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          The mathematical formula for calculating EMI is: EMI = [P × R × (1+R)^N] / [(1+R)^N - 1], where P is Principal, R is monthly interest rate, and N is tenure in months.
        </p>
      </div>
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">What is FOIR (Fixed Obligation to Income Ratio)?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          FOIR is a parameter used by banks like SBI and HDFC. Most Indian banks restrict your total monthly EMIs to a maximum of 40% to 50% of your net monthly take-home salary.
        </p>
      </div>
    </div>
  </article>
</Layout>