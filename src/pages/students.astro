---
import Layout from '../layouts/Layout.astro';
import { StudentHome } from '../react-pages/students';

const title = "Free Educational & Student Tools India 2025 | CGPA, Resume, Bunk & SOP";
const description = "15+ free digital tools for Indian college students. Convert CGPA for 20+ universities, track 75% attendance rule, build ATS resumes, and find scholarships.";

const faqSchemaStr = `<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How to convert SGPA and CGPA to percentage for Indian engineering universities?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Select your university preset in our free CGPA Calculator. Formulas vary: VTU/AKTU ((CGPA-0.75)×10), Mumbai Uni ((7.1×CGPA)+11), Anna Uni (CGPA×10), DU/CBSE (CGPA×9.5)."
      }
    },
    {
      "@type": "Question",
      "name": "How to build an ATS-friendly resume for campus placement drives?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use our free Resume Builder for Freshers. Choose clean single-column layouts, include keywords from job descriptions (Naukri, LinkedIn), and download PDF without watermarks."
      }
    }
  ]
}
</script>\n`;

const bcSchema = `<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://toolswaala.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "${title}",
      "item": "https://toolswaala.in/students"
    }
  ]
}
</script>\n`;
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/students">
  <Fragment set:html={faqSchemaStr} />
  <Fragment set:html={bcSchema} />

  <StudentHome client:only="react" />

  <!-- Comprehensive High-Depth SEO Content Block -->
  <article class="seo-article">
    <div style="margin-bottom: 32px;">
      <span class="seo-badge">
        🎓 UGC & AICTE Academic Toolkit 2025
      </span>
      <h2 style="font-size: clamp(24px, 4vw, 36px); font-weight: 800; color: var(--app-text); margin-bottom: 12px; letter-spacing: -0.02em;">
        Essential Free Digital Toolkit for Indian Students
      </h2>
      <p style="font-size: 16px; color: var(--app-text-secondary); line-height: 1.7;">
        ToolsWaala Student Hub equips college students across engineering, commerce, arts, and medical streams with 15+ high-utility productivity tools. Calculate CGPA with official university formulas, monitor class attendance against the 75% UGC rule, generate print-ready Bonafide and NOC certificates, and build ATS resumes for placement drives.
      </p>
    </div>

    <!-- Student Suite Highlights Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-bottom: 40px;">
      <a href="/cgpa-calculator" class="seo-card" style="margin-bottom: 0; text-decoration: none;">
        <h3 style="font-size: 16px; font-weight: 800; color: var(--app-text); margin-bottom: 6px;">🎓 University CGPA Calculator</h3>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0;">Presets for VTU, Mumbai Uni, AKTU, Anna Uni, SPPU, DU, KTU, CBSE, and 20+ boards.</p>
      </a>
      <a href="/attendance-calculator" class="seo-card" style="margin-bottom: 0; text-decoration: none;">
        <h3 style="font-size: 16px; font-weight: 800; color: var(--app-text); margin-bottom: 6px;">📊 Attendance & Bunk Calculator</h3>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0;">Calculate exact safe bunks while keeping your attendance above the mandatory 75% threshold.</p>
      </a>
      <a href="/resume-builder" class="seo-card" style="margin-bottom: 0; text-decoration: none;">
        <h3 style="font-size: 16px; font-weight: 800; color: var(--app-text); margin-bottom: 6px;">💼 ATS Resume Builder</h3>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0;">Build single-page placement resumes for freshers optimized for Naukri and LinkedIn parsing.</p>
      </a>
      <a href="/scholarship-finder" class="seo-card" style="margin-bottom: 0; text-decoration: none;">
        <h3 style="font-size: 16px; font-weight: 800; color: var(--app-text); margin-bottom: 6px;">🏆 Scholarship Finder India</h3>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0;">Search 35+ verified government and private college scholarships with eligibility criteria.</p>
      </a>
      <a href="/pomodoro-timer" class="seo-card" style="margin-bottom: 0; text-decoration: none;">
        <h3 style="font-size: 16px; font-weight: 800; color: var(--app-text); margin-bottom: 6px;">⏱️ Pomodoro Study Timer</h3>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0;">Focus timer with 25/5 session cycles, audio alerts, and study streak tracking.</p>
      </a>
      <a href="/sop-generator" class="seo-card" style="margin-bottom: 0; text-decoration: none;">
        <h3 style="font-size: 16px; font-weight: 800; color: var(--app-text); margin-bottom: 6px;">✍️ Statement of Purpose (SOP) Writer</h3>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0;">Draft SOP essays for MS in US, UK, Germany, Canada, and MBA applications.</p>
      </a>
    </div>

    <!-- FAQ Cards -->
    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 36px; margin-bottom: 16px;">
      Frequently Asked Questions (FAQs)
    </h3>
    <div class="seo-faq-grid">
      <div class="seo-faq-card">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">
          How to convert SGPA and CGPA to percentage for Indian engineering universities?
        </h4>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">
          Select your university preset in our free CGPA Calculator. Formulas vary: VTU/AKTU ((CGPA-0.75)×10), Mumbai Uni ((7.1×CGPA)+11), Anna Uni (CGPA×10), DU/CBSE (CGPA×9.5).
        </p>
      </div>
      <div class="seo-faq-card">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">
          How to build an ATS-friendly resume for campus placement drives?
        </h4>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">
          Use our free Resume Builder for Freshers. Choose clean single-column layouts, include keywords from job descriptions (Naukri, LinkedIn), and download PDF without watermarks.
        </p>
      </div>
    </div>
  </article>
</Layout>