---
import Layout from '../layouts/Layout.astro';

const title = "24-Day $3K Trading Mission Terminal | Rules-Based Futures Protocol";
const description = "Mechanical 24-session operating system for futures traders. 1-2 micros, $125 max risk per trade, $250 max daily loss, 1-win/2-loss day-over enforcement.";
---

<Layout title={title} description={description} currentPath="/mission-24-days">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-12 space-y-10">

    <!-- Mission Header & HUD -->
    <header class="relative p-6 sm:p-10 rounded-3xl bg-gradient-to-br from-slate-950 via-slate-900 to-emerald-950/40 border border-emerald-500/30 text-white shadow-2xl overflow-hidden">
      <!-- Glow ambient background -->
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-xs font-mono font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Active Mission Protocol • 24 Weekdays</span>
          </div>

          <div class="flex items-center gap-2 text-xs font-mono">
            <button id="reset-mission-btn" class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-rose-950/60 border border-slate-700 hover:border-rose-500/50 text-slate-300 hover:text-rose-300 transition-all">
              ⚠️ Reset Ledger
            </button>
            <button id="export-json-btn" class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700 border border-slate-700 text-slate-200 transition-all">
              💾 Export JSON
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          <div class="lg:col-span-7 space-y-2">
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white">
              The 24-Day <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-200">+$3,000 Mission</span>
            </h1>
            <p class="text-slate-300 text-sm sm:text-base font-medium leading-relaxed max-w-xl">
              August 19 → September 21, 2026. Execute one A+ setup per session. Protect the account first, obey the stop, and let mechanical compounding work.
            </p>
          </div>

          <!-- Quick Stats Matrix -->
          <div class="lg:col-span-5 grid grid-cols-2 sm:grid-cols-3 gap-3 text-center">
            <div class="p-3.5 rounded-2xl bg-slate-900/80 border border-slate-800">
              <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider font-mono">Cumulative P&L</span>
              <span id="hud-total-pnl" class="text-xl sm:text-2xl font-extrabold text-emerald-400 font-mono">+$0.00</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-slate-900/80 border border-slate-800">
              <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider font-mono">Target Pace</span>
              <span class="text-xl sm:text-2xl font-extrabold text-white font-mono">$125<span class="text-xs text-slate-400 font-normal">/day</span></span>
            </div>
            <div class="p-3.5 rounded-2xl bg-slate-900/80 border border-slate-800 col-span-2 sm:col-span-1">
              <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider font-mono">Discipline Rate</span>
              <span id="hud-discipline-rate" class="text-xl sm:text-2xl font-extrabold text-amber-300 font-mono">100%</span>
            </div>
          </div>
        </div>

        <!-- Milestones Progress Bar -->
        <div class="space-y-3 pt-2">
          <div class="flex justify-between text-xs font-mono font-bold text-slate-300">
            <span>Progress toward $3,000 Target</span>
            <span id="hud-progress-percent">0% Completed</span>
          </div>
          <div class="w-full h-3.5 bg-slate-800/80 rounded-full overflow-hidden p-0.5 border border-slate-700">
            <div id="hud-progress-bar" class="h-full bg-gradient-to-r from-emerald-500 via-teal-400 to-cyan-400 rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>

          <!-- Milestones checkpoints -->
          <div class="grid grid-cols-3 text-center gap-2 pt-1 text-[11px] font-mono">
            <div class="p-2 rounded-xl bg-slate-900/60 border border-slate-800/80">
              <span class="text-slate-400 block">Milestone 1</span>
              <strong class="text-white">+$1,250 Base Target</strong>
            </div>
            <div class="p-2 rounded-xl bg-slate-900/60 border border-slate-800/80">
              <span class="text-slate-400 block">Milestone 2</span>
              <strong class="text-amber-300">+$1,800 ($900 Payout)</strong>
            </div>
            <div class="p-2 rounded-xl bg-slate-900/60 border border-slate-800/80">
              <span class="text-slate-400 block">Mission Summit</span>
              <strong class="text-emerald-400">+$3,000 Target</strong>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Grid: Live Session Protocol + Risk Calculator -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Left Column: Active Daily Execution Engine (7 Cols) -->
      <section class="lg:col-span-7 space-y-6">
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl space-y-6">
          
          <div class="flex items-center justify-between flex-wrap gap-4 border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
              <h2 class="text-xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
                <span>⚡ Active Session Protocol</span>
              </h2>
              <p class="text-xs text-slate-600 dark:text-slate-400 font-mono mt-0.5">Execution & Exit State Machine</p>
            </div>

            <!-- Day Selector -->
            <div class="flex items-center gap-2">
              <label for="session-select" class="text-xs font-bold text-slate-700 dark:text-slate-300 font-mono">Session:</label>
              <select id="session-select" class="px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-xs font-bold font-mono text-slate-900 dark:text-white outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer">
                <!-- Dynamically populated 1 to 24 -->
              </select>
            </div>
          </div>

          <!-- Dynamic Status Banner (Locks or Encourages) -->
          <div id="session-status-banner" class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-slate-900 dark:text-white space-y-1 transition-all">
            <div class="flex items-center justify-between font-mono font-bold text-xs">
              <span id="session-banner-title" class="text-emerald-800 dark:text-emerald-300">🟢 READY FOR TRADE 1</span>
              <span id="session-trade-count-badge" class="px-2 py-0.5 rounded bg-emerald-800/20 text-emerald-800 dark:text-emerald-300">0/3 Trades Taken</span>
            </div>
            <p id="session-banner-desc" class="text-xs text-slate-700 dark:text-slate-300">
              Wait patiently for your premier A+ setup. Maximum risk: $125. Target: +$200 to +$250 (1.6R - 2R).
            </p>
          </div>

          <!-- Decision Tree Trades Container -->
          <div class="space-y-4">
            
            <!-- Trade 1 Card -->
            <div id="trade-1-box" class="p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 space-y-3 transition-all">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider font-mono text-slate-800 dark:text-slate-200">Trade #1 (Primary Setup)</span>
                <span class="text-[11px] text-slate-600 dark:text-slate-400 font-mono">Max Risk: $125</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">Outcome</label>
                  <select id="t1-outcome" class="w-full p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-xs font-bold font-mono outline-none">
                    <option value="NONE">Select Outcome...</option>
                    <option value="WIN">🟢 WIN (Target Hit)</option>
                    <option value="LOSS">🔴 LOSS (Stop Hit)</option>
                    <option value="BE">⚪ BREAKEVEN ($0)</option>
                  </select>
                </div>
                <div>
                  <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">P&L ($)</label>
                  <input type="number" id="t1-pnl" placeholder="e.g. 250 or -125" class="w-full p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-xs font-bold font-mono outline-none" />
                </div>
              </div>
            </div>

            <!-- Trade 2 Card -->
            <div id="trade-2-box" class="p-4 sm:p-5 rounded-2xl bg-slate-50/50 dark:bg-slate-950/40 border border-dashed border-slate-300 dark:border-slate-800 space-y-3 opacity-50 pointer-events-none transition-all">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider font-mono text-slate-800 dark:text-slate-200">Trade #2 (Secondary)</span>
                <span id="t2-status-tag" class="text-[11px] text-slate-600 dark:text-slate-400 font-mono">Locked</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">Outcome</label>
                  <select id="t2-outcome" class="w-full p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-xs font-bold font-mono outline-none">
                    <option value="NONE">Select Outcome...</option>
                    <option value="WIN">🟢 WIN (Target Hit)</option>
                    <option value="LOSS">🔴 LOSS (Stop Hit)</option>
                    <option value="BE">⚪ BREAKEVEN ($0)</option>
                  </select>
                </div>
                <div>
                  <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">P&L ($)</label>
                  <input type="number" id="t2-pnl" placeholder="e.g. 220 or -125" class="w-full p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-xs font-bold font-mono outline-none" />
                </div>
              </div>
            </div>

            <!-- Trade 3 Card -->
            <div id="trade-3-box" class="p-4 sm:p-5 rounded-2xl bg-slate-50/50 dark:bg-slate-950/40 border border-dashed border-slate-300 dark:border-slate-800 space-y-3 opacity-50 pointer-events-none transition-all">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider font-mono text-slate-800 dark:text-slate-200">Trade #3 (Final Contingency Only)</span>
                <span id="t3-status-tag" class="text-[11px] text-slate-600 dark:text-slate-400 font-mono">Locked</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">Outcome</label>
                  <select id="t3-outcome" class="w-full p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-xs font-bold font-mono outline-none">
                    <option value="NONE">Select Outcome...</option>
                    <option value="WIN">🟢 WIN (Target Hit)</option>
                    <option value="LOSS">🔴 LOSS (Stop Hit)</option>
                    <option value="BE">⚪ BREAKEVEN ($0)</option>
                  </select>
                </div>
                <div>
                  <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 block mb-1">P&L ($)</label>
                  <input type="number" id="t3-pnl" placeholder="e.g. 200 or -125" class="w-full p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-xs font-bold font-mono outline-none" />
                </div>
              </div>
            </div>
          </div>

          <!-- Session Compliance Check & Notes -->
          <div class="space-y-3 pt-2">
            <div class="flex items-center gap-3">
              <input type="checkbox" id="rules-followed-check" checked class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 cursor-pointer" />
              <label for="rules-followed-check" class="text-xs font-bold text-slate-800 dark:text-slate-200 cursor-pointer">
                I followed all mission rules 100% (No overtrading, stopped when day ended)
              </label>
            </div>

            <div>
              <label for="session-notes" class="text-xs font-bold text-slate-700 dark:text-slate-300 font-mono block mb-1">Session Reflection & Key Setup Notes</label>
              <textarea id="session-notes" rows="2" placeholder="e.g. Waited for 10am liquidity grab on MNQ, clean 2R exit at +$240. Done for the day in 1 trade." class="w-full p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs text-slate-900 dark:text-white outline-none focus:ring-2 focus:ring-emerald-500 font-mono resize-none"></textarea>
            </div>

            <button id="save-session-btn" class="w-full py-3 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-extrabold text-sm tracking-wide transition-all shadow-lg font-mono">
              💾 Save Session to Ledger
            </button>
          </div>

        </div>
      </section>

      <!-- Right Column: Micro Sizing Calculator + 10 Commandments (5 Cols) -->
      <section class="lg:col-span-5 space-y-6">
        
        <!-- Risk & Stop Distance Calculator -->
        <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 text-white space-y-4 shadow-xl">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <h3 class="text-base font-extrabold text-white flex items-center gap-2">
              <span>🎯 Position Size & Stop Matrix</span>
            </h3>
            <span class="text-[11px] font-mono text-emerald-400">1–2 Micros Only</span>
          </div>

          <div class="grid grid-cols-2 gap-3 text-xs font-mono">
            <div>
              <label class="text-slate-400 block mb-1 font-bold">Instrument</label>
              <select id="calc-instrument" class="w-full p-2 rounded-xl bg-slate-950 border border-slate-700 text-white outline-none">
                <option value="MNQ" data-point="2" data-tick="0.5">MNQ (Micro Nasdaq)</option>
                <option value="MES" data-point="5" data-tick="1.25">MES (Micro S&P)</option>
                <option value="MYM" data-point="0.5" data-tick="0.5">MYM (Micro Dow)</option>
                <option value="MCL" data-point="10" data-tick="1">MCL (Micro Crude)</option>
              </select>
            </div>
            <div>
              <label class="text-slate-400 block mb-1 font-bold">Contracts</label>
              <select id="calc-contracts" class="w-full p-2 rounded-xl bg-slate-950 border border-slate-700 text-white outline-none">
                <option value="1">1 Micro</option>
                <option value="2">2 Micros</option>
              </select>
            </div>
          </div>

          <!-- Output metrics -->
          <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 space-y-2 text-xs font-mono">
            <div class="flex justify-between">
              <span class="text-slate-400">Max Risk Budget:</span>
              <strong class="text-rose-400 font-bold">$125.00</strong>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Max Stop Loss Distance:</span>
              <strong id="calc-stop-pts" class="text-amber-300 font-bold">62.50 pts (250 ticks)</strong>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Target 2R Profit (+2R):</span>
              <strong id="calc-target-pts" class="text-emerald-400 font-bold">+$250.00 (125.0 pts)</strong>
            </div>
            <div class="flex justify-between border-t border-slate-800 pt-2">
              <span class="text-slate-400">Max Daily Loss (2 Losses):</span>
              <strong class="text-rose-500 font-bold">-$250.00 (Stop Trading)</strong>
            </div>
          </div>
        </div>

        <!-- The 10 Commandments of Discipline -->
        <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-3 shadow-lg">
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
            <h3 class="text-sm font-extrabold text-slate-900 dark:text-white uppercase tracking-wider font-mono">
              🛡️ The 10 Iron Rules
            </h3>
            <span class="text-[10px] text-emerald-800 dark:text-emerald-300 font-mono font-bold">Non-Negotiable</span>
          </div>

          <ol class="space-y-2 text-xs text-slate-700 dark:text-slate-300 font-medium">
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">1.</span>
              <span><strong>1–2 Micros Only:</strong> No sizing up on confidence.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">2.</span>
              <span><strong>Max $125 Risk:</strong> Stop is fixed at entry. Never widen.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">3.</span>
              <span><strong>-$250 = Market Closed:</strong> Two losses ends your day instantly.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">4.</span>
              <span><strong>1 Win = Day Over:</strong> You got what you came for. Close charts.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">5.</span>
              <span><strong>Max 3 Trades:</strong> No Trade #4 ever exists in your universe.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">6.</span>
              <span><strong>BE ≠ Reason to Force:</strong> Breakeven is a protected account.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">7.</span>
              <span><strong>No "Make It Back":</strong> Yesterday's P&L does not exist today.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">8.</span>
              <span><strong>No Deadline Urgency:</strong> The market owes you zero trades.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">9.</span>
              <span><strong>A+ Quality First:</strong> Take trades only with full confluence.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">10.</span>
              <span><strong>Discipline is Victory:</strong> 24/24 rule following is the goal.</span>
            </li>
          </ol>
        </div>

      </section>

    </div>

    <!-- Full 24-Day Interactive Ledger & Trajectory Matrix -->
    <section class="space-y-4">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            📊 24-Day Mission Ledger & Pacing Grid
          </h2>
          <p class="text-xs text-slate-600 dark:text-slate-400 font-mono mt-0.5">
            Target pacing: +$125 per session • Final Deadline: Monday, Sept 21, 2026
          </p>
        </div>
      </div>

      <div class="overflow-x-auto rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl">
        <table class="w-full text-left text-xs font-mono">
          <thead class="bg-slate-100 dark:bg-slate-950 text-slate-900 dark:text-white uppercase font-bold text-[11px] border-b border-slate-200 dark:border-slate-800">
            <tr>
              <th class="p-3.5">Session</th>
              <th class="p-3.5">Date</th>
              <th class="p-3.5">Trades</th>
              <th class="p-3.5">Outcome</th>
              <th class="p-3.5 text-right">Daily P&L</th>
              <th class="p-3.5 text-right">Running Total</th>
              <th class="p-3.5 text-right">Target Pace</th>
              <th class="p-3.5 text-center">Rules?</th>
              <th class="p-3.5">Notes</th>
              <th class="p-3.5 text-center">Action</th>
            </tr>
          </thead>
          <tbody id="ledger-table-body" class="divide-y divide-slate-100 dark:divide-slate-800">
            <!-- Populated dynamically via JS -->
          </tbody>
        </table>
      </div>
    </section>

  </div>
</Layout>

<!-- Client Side Ledger & State Engine -->
<script is:inline>
  const TOTAL_SESSIONS = 24;
  const DAILY_PACE = 125;
  const STORAGE_KEY = 'mission_3k_trading_ledger_v1';

  // Generate 24 Weekdays starting Wed Aug 19, 2026
  function get24Weekdays() {
    const dates = [];
    let current = new Date(2026, 7, 19); // Aug 19, 2026
    while (dates.length < TOTAL_SESSIONS) {
      const dayOfWeek = current.getDay();
      if (dayOfWeek !== 0 && dayOfWeek !== 6) { // Skip Sunday(0) and Saturday(6)
        const dateStr = current.toLocaleDateString('en-US', {
          weekday: 'short',
          month: 'short',
          day: 'numeric'
        });
        dates.push(dateStr);
      }
      current.setDate(current.getDate() + 1);
    }
    return dates;
  }

  const sessionDates = get24Weekdays();

  function getDefaultSessions() {
    return sessionDates.map((date, idx) => ({
      day: idx + 1,
      date: date,
      t1: { outcome: 'NONE', pnl: 0 },
      t2: { outcome: 'NONE', pnl: 0 },
      t3: { outcome: 'NONE', pnl: 0 },
      pnl: 0,
      tradesCount: 0,
      rulesFollowed: true,
      notes: '',
      status: 'PENDING' // 'WIN', 'LOSS', 'BE', 'PENDING'
    }));
  }

  function loadSessions() {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        return JSON.parse(saved);
      } catch (e) {
        console.error("Error loading session log:", e);
      }
    }
    return getDefaultSessions();
  }

  function saveSessions(sessions) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(sessions));
  }

  let sessions = loadSessions();
  let currentSessionDay = 1;

  document.addEventListener('DOMContentLoaded', () => {
    const sessionSelect = document.getElementById('session-select');
    const hudTotalPnl = document.getElementById('hud-total-pnl');
    const hudDisciplineRate = document.getElementById('hud-discipline-rate');
    const hudProgressBar = document.getElementById('hud-progress-bar');
    const hudProgressPercent = document.getElementById('hud-progress-percent');
    
    const bannerTitle = document.getElementById('session-banner-title');
    const bannerDesc = document.getElementById('session-banner-desc');
    const bannerTradeCount = document.getElementById('session-trade-count-badge');
    const sessionStatusBanner = document.getElementById('session-status-banner');

    const t1Box = document.getElementById('trade-1-box');
    const t1Outcome = document.getElementById('t1-outcome');
    const t1Pnl = document.getElementById('t1-pnl');

    const t2Box = document.getElementById('trade-2-box');
    const t2Outcome = document.getElementById('t2-outcome');
    const t2Pnl = document.getElementById('t2-pnl');
    const t2StatusTag = document.getElementById('t2-status-tag');

    const t3Box = document.getElementById('trade-3-box');
    const t3Outcome = document.getElementById('t3-outcome');
    const t3Pnl = document.getElementById('t3-pnl');
    const t3StatusTag = document.getElementById('t3-status-tag');

    const rulesCheck = document.getElementById('rules-followed-check');
    const notesInput = document.getElementById('session-notes');
    const saveSessionBtn = document.getElementById('save-session-btn');
    const ledgerTableBody = document.getElementById('ledger-table-body');

    // Sizing Calculator elements
    const calcInstrument = document.getElementById('calc-instrument');
    const calcContracts = document.getElementById('calc-contracts');
    const calcStopPts = document.getElementById('calc-stop-pts');
    const calcTargetPts = document.getElementById('calc-target-pts');

    // Populate Session Dropdown
    sessionSelect.innerHTML = '';
    sessions.forEach((s) => {
      const opt = document.createElement('option');
      opt.value = s.day;
      opt.textContent = `Session ${s.day} (${s.date})`;
      sessionSelect.appendChild(opt);
    });

    // Populate Risk Calculator
    function updateRiskCalculator() {
      const inst = calcInstrument.value;
      const contracts = parseInt(calcContracts.value) || 1;
      let pointValue = 2; // MNQ
      if (inst === 'MES') pointValue = 5;
      if (inst === 'MYM') pointValue = 0.5;
      if (inst === 'MCL') pointValue = 10;

      const totalPointValue = pointValue * contracts;
      const maxRisk = 125;
      const stopPts = (maxRisk / totalPointValue).toFixed(2);
      const stopTicks = (maxRisk / (totalPointValue / 4)).toFixed(0);

      const targetGain = 250;
      const targetPts = (targetGain / totalPointValue).toFixed(2);

      calcStopPts.textContent = `${stopPts} pts (${stopTicks} ticks)`;
      calcTargetPts.textContent = `+$250.00 (${targetPts} pts)`;
    }

    calcInstrument.addEventListener('change', updateRiskCalculator);
    calcContracts.addEventListener('change', updateRiskCalculator);
    updateRiskCalculator();

    // Load selected session into UI
    function loadSessionIntoUI(dayNum) {
      currentSessionDay = dayNum;
      const s = sessions.find(x => x.day === dayNum) || sessions[0];

      t1Outcome.value = s.t1?.outcome || 'NONE';
      t1Pnl.value = s.t1?.pnl || '';

      t2Outcome.value = s.t2?.outcome || 'NONE';
      t2Pnl.value = s.t2?.pnl || '';

      t3Outcome.value = s.t3?.outcome || 'NONE';
      t3Pnl.value = s.t3?.pnl || '';

      rulesCheck.checked = s.rulesFollowed !== false;
      notesInput.value = s.notes || '';

      evaluateDecisionTree();
    }

    // Interactive Protocol State Machine
    function evaluateDecisionTree() {
      const o1 = t1Outcome.value;
      const p1 = parseFloat(t1Pnl.value) || 0;

      const o2 = t2Outcome.value;
      const p2 = parseFloat(t2Pnl.value) || 0;

      const o3 = t3Outcome.value;
      const p3 = parseFloat(t3Pnl.value) || 0;

      let tradesCount = 0;
      if (o1 !== 'NONE') tradesCount++;
      if (o2 !== 'NONE') tradesCount++;
      if (o3 !== 'NONE') tradesCount++;

      // Reset styles
      t2Box.classList.add('opacity-50', 'pointer-events-none');
      t2StatusTag.textContent = 'Locked';
      t3Box.classList.add('opacity-50', 'pointer-events-none');
      t3StatusTag.textContent = 'Locked';

      sessionStatusBanner.className = "p-4 rounded-2xl border transition-all text-slate-900 dark:text-white space-y-1";

      if (o1 === 'NONE') {
        sessionStatusBanner.classList.add('bg-emerald-500/10', 'border-emerald-500/30');
        bannerTitle.textContent = "🟢 READY FOR TRADE 1";
        bannerTitle.className = "text-emerald-800 dark:text-emerald-300";
        bannerDesc.textContent = "Wait patiently for your premier A+ setup. Maximum risk: $125. Target: +$200 to +$250 (1.6R - 2R).";
        bannerTradeCount.textContent = "0/3 Trades Taken";
        return;
      }

      if (o1 === 'WIN') {
        sessionStatusBanner.classList.add('bg-emerald-600/20', 'border-emerald-500');
        bannerTitle.textContent = "🏆 ONE WIN ACHIEVED! DAY OVER — CLOSE PLATFORM.";
        bannerTitle.className = "text-emerald-400 font-extrabold text-sm";
        bannerDesc.textContent = "You got what you came for. Do not give profits back. Close charts and protect the capital.";
        bannerTradeCount.textContent = "1/1 Trade • Day Complete";
        return;
      }

      // If Trade 1 is LOSS or BE -> Unlock Trade 2
      t2Box.classList.remove('opacity-50', 'pointer-events-none');
      t2StatusTag.textContent = 'Unlocked';

      if (o2 === 'NONE') {
        sessionStatusBanner.classList.add('bg-amber-500/10', 'border-amber-500/30');
        bannerTitle.textContent = "⚠️ TRADE 2 UNLOCKED (SECOND OPPORTUNITY)";
        bannerTitle.className = "text-amber-800 dark:text-amber-300";
        bannerDesc.textContent = "Trade 1 did not win. Stay calm. Only take a valid setup. If this trade loses, your day is over.";
        bannerTradeCount.textContent = "1/3 Trades Taken";
        return;
      }

      if (o2 === 'WIN') {
        sessionStatusBanner.classList.add('bg-emerald-600/20', 'border-emerald-500');
        bannerTitle.textContent = "🏆 WIN SECURED ON TRADE 2! DAY OVER — CLOSE PLATFORM.";
        bannerTitle.className = "text-emerald-400 font-extrabold text-sm";
        bannerDesc.textContent = "Target achieved. Platform shutdown engaged.";
        bannerTradeCount.textContent = "2/2 Trades • Day Complete";
        return;
      }

      if (o1 === 'LOSS' && o2 === 'LOSS') {
        sessionStatusBanner.classList.add('bg-rose-600/20', 'border-rose-500');
        bannerTitle.textContent = "🛑 2 LOSSES REACHED (-$250 MAX DAMAGE). DAY OVER!";
        bannerTitle.className = "text-rose-400 font-extrabold text-sm";
        bannerDesc.textContent = "Hard stop protocol active. No revenge trading. Log off and return fresh for the next session.";
        bannerTradeCount.textContent = "2/2 Losses • Platform Locked";
        return;
      }

      // If BE + LOSS or LOSS + BE or BE + BE -> Trade 3 Contingency
      t3Box.classList.remove('opacity-50', 'pointer-events-none');
      t3StatusTag.textContent = 'Unlocked (Final)';

      if (o3 === 'NONE') {
        sessionStatusBanner.classList.add('bg-cyan-500/10', 'border-cyan-500/30');
        bannerTitle.textContent = "ℹ️ TRADE 3 AVAILABLE (FINAL CONTINGENCY)";
        bannerTitle.className = "text-cyan-800 dark:text-cyan-300";
        bannerDesc.textContent = "BE sequence active. This is your final trade of the session regardless of outcome.";
        bannerTradeCount.textContent = "2/3 Trades Taken";
        return;
      }

      // Trade 3 filled
      sessionStatusBanner.classList.add('bg-slate-800', 'border-slate-700');
      bannerTitle.textContent = "🔒 MAX 3 TRADES COMPLETED. DAY OVER.";
      bannerTitle.className = "text-slate-200 font-extrabold";
      bannerDesc.textContent = "Session capacity reached. Step away from the screens.";
      bannerTradeCount.textContent = "3/3 Trades Completed";
    }

    t1Outcome.addEventListener('change', evaluateDecisionTree);
    t1Pnl.addEventListener('input', evaluateDecisionTree);
    t2Outcome.addEventListener('change', evaluateDecisionTree);
    t2Pnl.addEventListener('input', evaluateDecisionTree);
    t3Outcome.addEventListener('change', evaluateDecisionTree);
    t3Pnl.addEventListener('input', evaluateDecisionTree);

    sessionSelect.addEventListener('change', (e) => {
      loadSessionIntoUI(parseInt(e.target.value));
    });

    // Save Session Handler
    saveSessionBtn.addEventListener('click', () => {
      const dayNum = parseInt(sessionSelect.value);
      const s = sessions.find(x => x.day === dayNum);
      if (!s) return;

      s.t1 = { outcome: t1Outcome.value, pnl: parseFloat(t1Pnl.value) || 0 };
      s.t2 = { outcome: t2Outcome.value, pnl: parseFloat(t2Pnl.value) || 0 };
      s.t3 = { outcome: t3Outcome.value, pnl: parseFloat(t3Pnl.value) || 0 };

      let totalPnl = 0;
      let count = 0;
      let status = 'PENDING';

      if (s.t1.outcome !== 'NONE') { totalPnl += s.t1.pnl; count++; }
      if (s.t2.outcome !== 'NONE') { totalPnl += s.t2.pnl; count++; }
      if (s.t3.outcome !== 'NONE') { totalPnl += s.t3.pnl; count++; }

      if (s.t1.outcome === 'WIN' || s.t2.outcome === 'WIN' || s.t3.outcome === 'WIN') status = 'WIN';
      else if (s.t1.outcome === 'LOSS' && s.t2.outcome === 'LOSS') status = '2 LOSSES';
      else if (count > 0 && totalPnl < 0) status = 'LOSS';
      else if (count > 0 && totalPnl === 0) status = 'BE';

      s.pnl = totalPnl;
      s.tradesCount = count;
      s.rulesFollowed = rulesCheck.checked;
      s.notes = notesInput.value.trim();
      s.status = status;

      saveSessions(sessions);
      renderLedger();
      updateHUD();

      saveSessionBtn.textContent = '✅ Session Saved!';
      setTimeout(() => {
        saveSessionBtn.textContent = '💾 Save Session to Ledger';
      }, 1500);
    });

    // Render Ledger Table
    function renderLedger() {
      ledgerTableBody.innerHTML = '';
      let runningTotal = 0;

      sessions.forEach((s) => {
        runningTotal += s.pnl;
        const targetPace = s.day * DAILY_PACE;
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50 dark:hover:bg-slate-950/60 transition-colors";

        let outcomeBadge = '<span class="text-slate-400">Pending</span>';
        if (s.status === 'WIN') outcomeBadge = '<span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 font-bold">🟢 Win</span>';
        else if (s.status === '2 LOSSES') outcomeBadge = '<span class="px-2 py-0.5 rounded bg-rose-500/20 text-rose-800 dark:text-rose-300 font-bold">🔴 2 Losses</span>';
        else if (s.status === 'LOSS') outcomeBadge = '<span class="px-2 py-0.5 rounded bg-rose-500/10 text-rose-700 dark:text-rose-400 font-bold">🔴 Loss</span>';
        else if (s.status === 'BE') outcomeBadge = '<span class="px-2 py-0.5 rounded bg-slate-500/20 text-slate-300 font-bold">⚪ BE</span>';

        const pnlColor = s.pnl > 0 ? 'text-emerald-800 dark:text-emerald-300 font-bold' : (s.pnl < 0 ? 'text-rose-800 dark:text-rose-300 font-bold' : 'text-slate-400');
        const totalColor = runningTotal >= targetPace ? 'text-emerald-800 dark:text-emerald-300 font-bold' : (runningTotal > 0 ? 'text-slate-900 dark:text-white font-bold' : 'text-rose-800 dark:text-rose-300 font-bold');

        tr.innerHTML = `
          <td class="p-3.5 font-bold text-slate-900 dark:text-white">Day ${s.day}</td>
          <td class="p-3.5 text-slate-600 dark:text-slate-400">${s.date}</td>
          <td class="p-3.5">${s.tradesCount > 0 ? s.tradesCount : '—'}</td>
          <td class="p-3.5">${outcomeBadge}</td>
          <td class="p-3.5 text-right ${pnlColor}">${s.tradesCount > 0 ? (s.pnl >= 0 ? '+' : '') + '$' + s.pnl.toLocaleString() : '—'}</td>
          <td class="p-3.5 text-right ${totalColor}">${s.tradesCount > 0 ? (runningTotal >= 0 ? '+' : '') + '$' + runningTotal.toLocaleString() : '—'}</td>
          <td class="p-3.5 text-right text-slate-500">$${targetPace.toLocaleString()}</td>
          <td class="p-3.5 text-center">${s.tradesCount > 0 ? (s.rulesFollowed ? '✅' : '⚠️') : '—'}</td>
          <td class="p-3.5 text-slate-600 dark:text-slate-400 max-w-[180px] truncate" title="${s.notes || ''}">${s.notes || '—'}</td>
          <td class="p-3.5 text-center">
            <button onclick="window.selectSessionDirect(${s.day})" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-emerald-600 hover:text-white text-slate-700 dark:text-slate-300 text-[10px] font-bold transition-all">
              Edit
            </button>
          </td>
        `;
        ledgerTableBody.appendChild(tr);
      });
    }

    // Expose direct selector
    window.selectSessionDirect = function(day) {
      sessionSelect.value = day;
      loadSessionIntoUI(day);
      window.scrollTo({ top: document.getElementById('trade-1-box').offsetTop - 120, behavior: 'smooth' });
    };

    // Update HUD Metrics
    function updateHUD() {
      let totalPnl = 0;
      let daysLogged = 0;
      let rulesFollowedCount = 0;

      sessions.forEach(s => {
        if (s.tradesCount > 0) {
          totalPnl += s.pnl;
          daysLogged++;
          if (s.rulesFollowed) rulesFollowedCount++;
        }
      });

      hudTotalPnl.textContent = (totalPnl >= 0 ? '+' : '') + '$' + totalPnl.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      hudTotalPnl.className = totalPnl >= 0 ? "text-xl sm:text-2xl font-extrabold text-emerald-400 font-mono" : "text-xl sm:text-2xl font-extrabold text-rose-400 font-mono";

      const disciplineRate = daysLogged > 0 ? Math.round((rulesFollowedCount / daysLogged) * 100) : 100;
      hudDisciplineRate.textContent = `${disciplineRate}% (${rulesFollowedCount}/${daysLogged || TOTAL_SESSIONS})`;

      const progress = Math.min(100, Math.max(0, Math.round((totalPnl / 3000) * 100)));
      hudProgressBar.style.width = `${progress}%`;
      hudProgressPercent.textContent = `${progress}% ($${totalPnl.toLocaleString()} / $3,000)`;
    }

    // Reset handler
    document.getElementById('reset-mission-btn').addEventListener('click', () => {
      if (confirm("Reset the 24-day ledger back to Day 1 default?")) {
        sessions = getDefaultSessions();
        saveSessions(sessions);
        loadSessionIntoUI(1);
        renderLedger();
        updateHUD();
      }
    });

    // Export JSON handler
    document.getElementById('export-json-btn').addEventListener('click', () => {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(sessions, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `mission_3k_ledger_${new Date().toISOString().slice(0,10)}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    });

    // Initial render
    loadSessionIntoUI(1);
    renderLedger();
    updateHUD();
  });
</script>
