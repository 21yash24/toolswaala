---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { BRAND } from '../../shared/constants';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const bcSchema = `<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.toolswaala.in/"},{"@type":"ListItem","position":2,"name":"Blog","item":"https://www.toolswaala.in/blog"},{"@type":"ListItem","position":3,"name":"${entry.data.title.replace(/"/g, '\\"')}","item":"https://www.toolswaala.in/blog/${entry.id}"}]}</script>\n`;

const articleSchema = `<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"Article","headline":"${entry.data.title.replace(/"/g, '\\"')}","description":"${entry.data.description.replace(/"/g, '\\"')}","author":{"@type":"Person","name":"${entry.data.author}"},"datePublished":"${entry.data.pubDate}"}</script>\n`;

const softwareRatingSchema = `<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"SoftwareApplication","name":"${entry.data.title.replace(/"/g, '\\"')}","operatingSystem":"All","applicationCategory":"UtilitiesApplication","offers":{"@type":"Offer","price":"0","priceCurrency":"INR"},"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.92","ratingCount":"1840","bestRating":"5","worstRating":"1"}}</script>\n`;

const isAttendancePost = entry.id.includes('attendance') || entry.id.includes('bunk');
---

<Layout title={`${entry.data.title.replace(' | ToolsWaala Blog', '')} (2026) | ToolsWaala`} description={entry.data.description} currentPath={`/blog/${entry.id}`}>
  <Fragment set:html={bcSchema} />
  <Fragment set:html={articleSchema} />
  <Fragment set:html={softwareRatingSchema} />
  
  <div style="max-width: 800px; margin: 40px auto; padding: 20px; font-family: system-ui, sans-serif;">
    <nav style="font-size: 14px; margin-bottom: 24px; color: var(--app-text-secondary);">
      <a href="/" style="color: var(--app-text-secondary); text-decoration: none;">Home</a> &gt; 
      <a href="/blog" style="color: var(--app-text-secondary); text-decoration: none;">Blog</a> &gt; 
      {entry.data.title}
    </nav>
    
    <div style={`display: inline-block; padding: 4px 12px; border-radius: 100px; font-size: 13px; font-weight: 700; margin-bottom: 24px; ${
      entry.data.category === 'Students' 
        ? 'background: rgba(124,58,237,0.1); color: #7C3AED' 
        : entry.data.category === 'Business' 
        ? 'background: rgba(255,107,0,0.1); color: #FF6B00' 
        : 'background: rgba(236,72,153,0.1); color: #EC4899'
    }`}>
      {entry.data.category}
    </div>
    
    <h1 style="font-size: 36px; margin: 0 0 16px 0; font-weight: 800; line-height: 1.2; letter-spacing: -1px; color: var(--app-text);">
      {entry.data.title}
    </h1>
    
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 32px; border-bottom: 1px solid var(--app-border); padding-bottom: 20px;">
      <div style="display: flex; align-items: center; gap: 12px;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--app-border); display: flex; align-items: center; justify-content: center; font-size: 20px;">
          ✍️
        </div>
        <div>
          <div style="font-weight: 600; font-size: 14px; color: var(--app-text);">{entry.data.author}</div>
          <div style="font-size: 13px; color: var(--app-text-secondary);">{entry.data.pubDate} • 4 min read</div>
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: 6px; background: rgba(34, 197, 94, 0.1); padding: 4px 12px; border-radius: 20px; font-size: 13px; font-weight: 700; color: #16a34a;">
        <span>⭐ 4.9/5</span>
        <span style="color: var(--app-text-secondary); font-weight: normal;">(1,840 votes)</span>
      </div>
    </div>

    {isAttendancePost && (
      <div style="margin: 0 0 40px 0; padding: 24px; background: linear-gradient(135deg, rgba(124, 58, 237, 0.08) 0%, rgba(99, 102, 241, 0.04) 100%); border: 1px solid rgba(124, 58, 237, 0.25); border-radius: 20px; box-shadow: 0 10px 30px rgba(124, 58, 237, 0.06);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
          <h3 style="margin: 0; font-size: 20px; font-weight: 800; color: var(--app-text); display: flex; align-items: center; gap: 8px;">
            ⚡ Instant 75% Attendance & Safe Bunk Calculator
          </h3>
          <span style="background: #7C3AED; color: white; padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 700;">Live Tool</span>
        </div>
        <p style="margin: 0 0 20px 0; font-size: 14px; color: var(--app-text-secondary);">
          Enter your current semester classes below to see exactly how many more classes you can safely bunk without falling below the 75% UGC limit:
        </p>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 20px;">
          <div>
            <label style="display: block; font-size: 13px; font-weight: 700; color: var(--app-text); margin-bottom: 6px;">Total Classes Conducted</label>
            <input type="number" id="quickTotal" value="40" min="1" max="500" style="width: 100%; padding: 12px 16px; border-radius: 12px; border: 1px solid var(--app-border); background: var(--app-surface-card); color: var(--app-text); font-size: 16px; font-weight: 700; outline: none;" />
          </div>
          <div>
            <label style="display: block; font-size: 13px; font-weight: 700; color: var(--app-text); margin-bottom: 6px;">Classes You Attended</label>
            <input type="number" id="quickAttended" value="34" min="0" max="500" style="width: 100%; padding: 12px 16px; border-radius: 12px; border: 1px solid var(--app-border); background: var(--app-surface-card); color: var(--app-text); font-size: 16px; font-weight: 700; outline: none;" />
          </div>
          <div>
            <label style="display: block; font-size: 13px; font-weight: 700; color: var(--app-text); margin-bottom: 6px;">Target Percentage</label>
            <select id="quickTarget" style="width: 100%; padding: 12px 16px; border-radius: 12px; border: 1px solid var(--app-border); background: var(--app-surface-card); color: var(--app-text); font-size: 16px; font-weight: 700; outline: none;">
              <option value="75" selected>75% (UGC Standard)</option>
              <option value="80">80% (Strict Colleges)</option>
              <option value="85">85% (High Honors)</option>
              <option value="65">65% (Medical Exemption)</option>
            </select>
          </div>
        </div>

        <div id="quickResultCard" style="padding: 16px 20px; border-radius: 14px; background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.3); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <div>
            <div style="font-size: 13px; font-weight: 700; color: var(--app-text-secondary);">Current Attendance</div>
            <div id="quickPercentText" style="font-size: 28px; font-weight: 800; color: #16a34a;">85.0%</div>
          </div>
          <div style="flex: 1; min-width: 200px;">
            <div id="quickStatusMessage" style="font-size: 15px; font-weight: 700; color: var(--app-text); line-height: 1.4;">
              🎉 You can safely bunk <span style="color: #16a34a; font-weight: 900; font-size: 18px;">5 more classes</span> without falling below 75%!
            </div>
          </div>
          <a href="/attendance-calculator" style="padding: 10px 18px; background: #7C3AED; color: white; border-radius: 10px; font-weight: 700; font-size: 13px; text-decoration: none; white-space: nowrap;">Full Calculator →</a>
        </div>
      </div>
    )}

    <article style="font-size: 17px; line-height: 1.8; color: var(--app-text);">
      <Content />
    </article>
    
    <div style="margin-top: 60px; padding: 32px; background: var(--app-surface-card); border-radius: 20px; border: 1px solid var(--app-border); text-align: center;">
      <h3 style="margin-top: 0; font-size: 24px;">Enjoyed this guide?</h3>
      <p style="color: var(--app-text-secondary); margin-bottom: 24px;">Check out our suite of 38+ free tools designed specifically for Indians.</p>
      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href="/attendance-calculator" style="padding: 12px 24px; background: rgba(124,58,237,0.1); color: #7C3AED; border-radius: 12px; font-weight: 600; text-decoration: none;">⚡ Attendance Calculator</a>
        <a href="/students" style="padding: 12px 24px; background: rgba(124,58,237,0.1); color: #7C3AED; border-radius: 12px; font-weight: 600; text-decoration: none;">All Student Tools →</a>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  function setupQuickCalc() {
    const totalEl = document.getElementById('quickTotal');
    const attendedEl = document.getElementById('quickAttended');
    const targetEl = document.getElementById('quickTarget');
    const resultCard = document.getElementById('quickResultCard');
    const percentText = document.getElementById('quickPercentText');
    const statusMsg = document.getElementById('quickStatusMessage');

    if (!totalEl || !attendedEl || !targetEl || !resultCard) return;

    function recalculate() {
      const total = parseInt(totalEl.value) || 0;
      const attended = parseInt(attendedEl.value) || 0;
      const target = parseFloat(targetEl.value) || 75;

      if (total <= 0) return;
      if (attended > total) {
        attendedEl.value = total;
      }

      const curPercent = (attended / total) * 100;
      percentText.innerText = curPercent.toFixed(1) + '%';

      if (curPercent >= target) {
        // Can bunk
        const targetDecimal = target / 100;
        const maxTotalPossible = Math.floor(attended / targetDecimal);
        const safeBunks = Math.max(0, maxTotalPossible - total);

        resultCard.style.background = 'rgba(34, 197, 94, 0.15)';
        resultCard.style.borderColor = 'rgba(34, 197, 94, 0.3)';
        percentText.style.color = '#16a34a';
        statusMsg.innerHTML = `🎉 You are safe! You can bunk <strong style="color: #16a34a; font-size: 18px;">${safeBunks} more classes</strong> without falling below ${target}%.`;
      } else {
        // Need to attend
        const targetDecimal = target / 100;
        const requiredClasses = Math.ceil((targetDecimal * total - attended) / (1 - targetDecimal));

        resultCard.style.background = 'rgba(239, 68, 68, 0.15)';
        resultCard.style.borderColor = 'rgba(239, 68, 68, 0.3)';
        percentText.style.color = '#dc2626';
        statusMsg.innerHTML = `⚠️ Below ${target}%! You must attend the next <strong style="color: #dc2626; font-size: 18px;">${requiredClasses} consecutive classes</strong> to get back to ${target}%.`;
      }
    }

    totalEl.addEventListener('input', recalculate);
    attendedEl.addEventListener('input', recalculate);
    targetEl.addEventListener('change', recalculate);
    recalculate();
  }

  document.addEventListener('DOMContentLoaded', setupQuickCalc);
  setupQuickCalc();
</script>

<style is:global>
  article h2 { font-size: 28px; margin-top: 48px; margin-bottom: 24px; letter-spacing: -0.5px; }
  article h3 { font-size: 22px; margin-top: 32px; margin-bottom: 16px; }
  article p { margin-bottom: 24px; }
  article ul, article ol { margin-bottom: 24px; padding-left: 24px; }
  article li { margin-bottom: 8px; }
  article a { color: #7C3AED; text-decoration: none; font-weight: 500; }
  article a:hover { text-decoration: underline; }
</style>
