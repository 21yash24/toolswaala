---
import Layout from '../../layouts/Layout.astro';
import PdfPageWrapper from '../../shared/PdfPageWrapper';
import { ImageToPdf } from '../../react-pages/pdf';

const title = "Convert JPG to PDF Online Free 2025 | Combine PNG & Photos into PDF";
const description = "Convert JPG, PNG, WEBP images to PDF document online. Combine multiple photos into a single PDF file. 100% free client-side conversion, zero server uploads.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/pdf-tools/image-to-pdf">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala Image to PDF Converter",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.97",
        "ratingCount": "4890"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I merge multiple JPG images into a single multi-page PDF?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Select all your JPG images at once or drag and drop them into our converter box. Drag to reorder pages as needed, set page orientation (Portrait/Landscape), and click 'Convert to PDF'."
          }
        },
        {
          "@type": "Question",
          "name": "Is converting private ID photos (Aadhaar, Passport) safe on ToolsWaala?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! All image processing happens 100% locally inside your web browser HTML5 Canvas memory. Your images are never sent over the internet or saved to any cloud server."
          }
        },
        {
          "@type": "Question",
          "name": "What image formats are supported for PDF conversion?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ToolsWaala supports JPG, JPEG, PNG, WEBP, BMP, and GIF image formats for instant conversion into standardized PDF documents."
          }
        }
      ]
    }
  ]
  </script>

  <PdfPageWrapper title="Image to PDF" hindi="इमेज से पीडीएफ" client:load>
    <ImageToPdf client:only="react" />
  </PdfPageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article class="max-w-4xl mx-auto px-4 py-8 text-slate-800 dark:text-slate-200 leading-relaxed font-sans">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:underline">Home</a> &gt; <a href="/pdf-tools" class="hover:underline">PDF Tools</a> &gt; <span class="font-medium text-slate-700 dark:text-slate-300">Image to PDF</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
      Convert JPG & PNG Images to PDF Online Free 2025
    </h1>
    
    <p class="text-lg text-slate-600 dark:text-slate-300 mb-8">
      Combine multiple photos, mobile camera scans, and graphics into a single clean <strong>PDF document</strong>. Ideal for college assignment submissions, passport/Aadhaar ID cards, expense receipts, and job application attachments.
    </p>

    <div class="bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 rounded-xl p-6 mb-8">
      <h2 class="text-xl font-bold text-indigo-950 dark:text-indigo-200 mb-3">🔒 100% Browser Canvas Privacy Guarantee</h2>
      <p class="text-slate-700 dark:text-slate-300 text-sm mb-3">
        ToolsWaala converts your images to PDF using **HTML5 Canvas and PDFLib WebAssembly**. Your sensitive personal photos (PAN card, Aadhaar card, certificates) are processed strictly in your device memory and **NEVER uploaded to a remote server**.
      </p>
      <ul class="space-y-1 text-slate-700 dark:text-slate-300 text-xs">
        <li>✅ No Watermarks — 100% clean, professional PDF output without promotional branding.</li>
        <li>✅ Auto Page Formatting — Auto-fit image dimensions to standard A4 page size with custom margins.</li>
        <li>✅ Mobile Camera Scanner — Take photos directly from Android or iPhone and convert to PDF in seconds.</li>
      </ul>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Standard PDF Page Layout Settings Guide</h2>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-left border-collapse border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden text-sm">
        <thead class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-semibold">
          <tr>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Setting Option</th>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Available Choices</th>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Best Practice Usage</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Page Orientation</td>
            <td class="p-3 text-indigo-600 font-medium">Portrait / Landscape / Auto</td>
            <td class="p-3">Use Portrait for documents; Landscape for wide presentation slides.</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Page Margin</td>
            <td class="p-3 text-indigo-600 font-medium">No Margin / Small / Big</td>
            <td class="p-3">Use Small Margin to ensure text on scanned pages is not cut off during printing.</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Paper Size</td>
            <td class="p-3 text-indigo-600 font-medium">A4 / US Letter / Fit to Image</td>
            <td class="p-3">Standard A4 size is mandatory for Indian government and university filings.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Frequently Asked Questions (FAQs)</h2>
    <div class="space-y-6">
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">How do I merge multiple JPG images into a single multi-page PDF?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          Select all your JPG images at once or drag and drop them into our converter box. Drag to reorder pages as needed and click 'Convert to PDF'.
        </p>
      </div>
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Is converting private ID photos safe on ToolsWaala?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          Yes! All image processing happens 100% locally inside your web browser. Your images are never sent over the internet or saved to any server.
        </p>
      </div>
    </div>
  </article>
</Layout>