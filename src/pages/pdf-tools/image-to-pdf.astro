---
import Layout from '../../layouts/Layout.astro';
import PdfPageWrapper from '../../shared/PdfPageWrapper';
import { ImageToPdf } from '../../react-pages/pdf';

const title = "Image to PDF Converter Free";
const description = "Convert JPG, PNG images to professional PDF. No upload, 100% private.";

const faqs = [
  {
    "q": "How to convert JPG or PNG to PDF?",
    "a": "Upload one or multiple images, arrange them in order, adjust page orientation, and click convert. The PDF downloads immediately."
  },
  {
    "q": "Can I merge multiple images into one PDF?",
    "a": "Yes, you can upload multiple images and compile them into a single multi-page PDF document."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/pdf-tools/image-to-pdf">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"PDF Tools","item":"https://toolswaala.in/pdf-tools"},{"@type":"ListItem","position":3,"name":"Image to PDF Converter Free","item":"https://toolswaala.in/pdf-tools/image-to-pdf"}]}</script>

  <PdfPageWrapper title={title} hindi="इमेज से पीडीएफ" client:load>
    <ImageToPdf client:only="react" />
  </PdfPageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; <a href="/pdf-tools">PDF Tools</a> &gt; Image to PDF Converter Free</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>