---
import Layout from '../../layouts/Layout.astro';
import PdfPageWrapper from '../../shared/PdfPageWrapper';
import { ImageCompressor } from '../../react-pages/pdf';

const title = "Free Image Compressor Online 2025 | Reduce Photo Size in KB for Exam Portals";
const description = "Compress JPG, PNG photos to 20KB, 50KB, 100KB, or 200KB for UPSC, SSC, IBPS, and NTA NEET exam portal uploads. 100% Client-side privacy, zero server uploads.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/pdf-tools/compress-image">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala Image Compressor",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.97",
        "ratingCount": "4320"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How to compress passport photo size to 20KB - 50KB for SSC & Bank forms?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Upload your photo into our compressor, select the target file size (e.g. 50KB or 20KB), and the tool will automatically adjust image resolution and quality using client-side WebAssembly."
          }
        },
        {
          "@type": "Question",
          "name": "What are the standard passport photo dimensions for Indian government applications?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard passport photos require dimensions of 3.5 cm × 4.5 cm (350 × 450 pixels at 300 DPI) with a clean light or white background."
          }
        },
        {
          "@type": "Question",
          "name": "Is my private photo uploaded to any server during compression?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No! ToolsWaala processes image compression 100% locally inside your device browser. Your personal photos and signature scans are never uploaded to the internet."
          }
        }
      ]
    }
  ]
  </script>

  <PdfPageWrapper title="Compress Image" hindi="इमेज कम्प्रेस करें" client:load>
    <ImageCompressor client:only="react" />
  </PdfPageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article class="max-w-4xl mx-auto px-4 py-8 text-slate-800 dark:text-slate-200 leading-relaxed font-sans">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:underline">Home</a> &gt; <a href="/pdf-tools" class="hover:underline">PDF & Image Tools</a> &gt; <span class="font-medium text-slate-700 dark:text-slate-300">Compress Image</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
      Free Image Compressor Online 2025 (Reduce Photo Size to KB)
    </h1>
    
    <p class="text-lg text-slate-600 dark:text-slate-300 mb-8">
      Compress JPG, PNG, and WEBP image file sizes down to exact target limits like <strong>20KB, 50KB, 100KB, or 200KB</strong>. Specially designed for <strong>UPSC, SSC, NTA NEET, JEE, IBPS, and Railway portal form uploads</strong>.
    </p>

    <div class="bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 rounded-xl p-6 mb-8">
      <h2 class="text-xl font-bold text-indigo-950 dark:text-indigo-200 mb-3">Govt Exam Portal Image Specification Matrix</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs text-slate-700 dark:text-slate-300">
          <thead class="font-bold border-b border-indigo-200 dark:border-indigo-800 text-indigo-950 dark:text-indigo-200">
            <tr>
              <th class="p-2">Exam Portal</th>
              <th class="p-2">Passport Photo Limit</th>
              <th class="p-2">Signature Limit</th>
              <th class="p-2">Required Dimensions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-indigo-100 dark:divide-indigo-900">
            <tr>
              <td class="p-2 font-semibold">SSC CGL / CHSL</td>
              <td class="p-2 text-indigo-600 font-bold">20 KB – 50 KB</td>
              <td class="p-2 text-indigo-600 font-bold">10 KB – 20 KB</td>
              <td class="p-2">3.5 cm × 4.5 cm</td>
            </tr>
            <tr>
              <td class="p-2 font-semibold">UPSC IAS / IPS</td>
              <td class="p-2 text-indigo-600 font-bold">20 KB – 300 KB</td>
              <td class="p-2 text-indigo-600 font-bold">20 KB – 300 KB</td>
              <td class="p-2">350 × 350 Pixels Min</td>
            </tr>
            <tr>
              <td class="p-2 font-semibold">NTA NEET / JEE</td>
              <td class="p-2 text-indigo-600 font-bold">10 KB – 200 KB</td>
              <td class="p-2 text-indigo-600 font-bold">4 KB – 30 KB</td>
              <td class="p-2">3.5 cm × 4.5 cm</td>
            </tr>
            <tr>
              <td class="p-2 font-semibold">IBPS PO / Clerk</td>
              <td class="p-2 text-indigo-600 font-bold">20 KB – 50 KB</td>
              <td class="p-2 text-indigo-600 font-bold">10 KB – 20 KB</td>
              <td class="p-2">200 × 230 Pixels</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Lossless vs Smart Quality Compression</h2>
    <p class="mb-4">ToolsWaala combines smart canvas pixel resampling with high-ratio JPEG quantization:</p>
    <ul class="list-disc pl-5 space-y-2 mb-8 text-sm">
      <li>📌 <strong>Keeps Facial Clarity:</strong> Retains crisp facial features and clear background contrast required for portal facial verification.</li>
      <li>📌 <strong>Instant Local Download:</strong> Compression executes in under 50 milliseconds using client-side JavaScript.</li>
      <li>📌 <strong>Batch Compression:</strong> Drag and drop multiple signature and photo files at once.</li>
    </ul>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Frequently Asked Questions (FAQs)</h2>
    <div class="space-y-6">
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">How do I compress an image below 50KB for portals?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          Upload your image, choose the target file size (e.g. 50KB or 20KB), and click download. The compressor automatically optimizes quality and dimensions.
        </p>
      </div>
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Is my private photo uploaded to any server?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          No! ToolsWaala processes image compression 100% locally inside your device browser. Your photos are never uploaded to the cloud.
        </p>
      </div>
    </div>
  </article>
</Layout>