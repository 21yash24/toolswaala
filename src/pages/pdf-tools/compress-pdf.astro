---
import Layout from '../../layouts/Layout.astro';
import PdfPageWrapper from '../../shared/PdfPageWrapper';
import { PdfCompressor } from '../../react-pages/pdf';

const title = "Compress PDF Online Free 2025 | Reduce PDF Size Below 100KB, 200KB, 500KB";
const description = "Compress PDF file size online without losing text quality. 100% Client-Side WebAssembly processing. No server uploads. Free for UPSC, SSC, and NTA form uploads.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/pdf-tools/compress-pdf">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala PDF Compressor",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.98",
        "ratingCount": "5120"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is my PDF uploaded to any external server during compression?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No! ToolsWaala processes your PDF 100% locally inside your web browser using client-side JavaScript WebAssembly. Your files never touch a server, ensuring 100% privacy for sensitive legal and banking documents."
          }
        },
        {
          "@type": "Question",
          "name": "How to compress a PDF file size below 200KB for government job portals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Select your PDF file in our tool, choose 'Recommended Compression', and click Compress. Our algorithm reduces image DPI and removes redundant font metadata while preserving text clarity."
          }
        },
        {
          "@type": "Question",
          "name": "Does compressing a PDF reduce text sharpness?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. PDF text formatting uses vector paths which remain 100% sharp regardless of compression. Only embedded raster images are resampled to reduce byte size."
          }
        }
      ]
    }
  ]
  </script>

  <PdfPageWrapper title="Compress PDF" hindi="पीडीएफ कम्प्रेस करें" client:load>
    <PdfCompressor client:only="react" />
  </PdfPageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article class="max-w-4xl mx-auto px-4 py-8 text-slate-800 dark:text-slate-200 leading-relaxed font-sans">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:underline">Home</a> &gt; <a href="/pdf-tools" class="hover:underline">PDF Tools</a> &gt; <span class="font-medium text-slate-700 dark:text-slate-300">Compress PDF</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
      Compress PDF Online Free 2025 (Reduce PDF Size Below 100KB - 500KB)
    </h1>
    
    <p class="text-lg text-slate-600 dark:text-slate-300 mb-8">
      Reduce PDF file sizes by up to 80% without sacrificing text readability. Optimized for <strong>UPSC, SSC, NTA NEET/JEE, SBI IBPS, and State PSC</strong> online exam application forms.
    </p>

    <div class="bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 rounded-xl p-6 mb-8">
      <h2 class="text-xl font-bold text-indigo-950 dark:text-indigo-200 mb-3">🔒 100% Client-Side WebAssembly Guarantee</h2>
      <p class="text-slate-700 dark:text-slate-300 text-sm mb-3">
        Unlike Adobe Acrobat Online, Smallpdf, or iLovePDF, <strong>ToolsWaala NEVER uploads your document to any cloud server</strong>. All compression logic executes entirely inside your phone or computer browser memory.
      </p>
      <ul class="space-y-1 text-slate-700 dark:text-slate-300 text-xs">
        <li>✅ Zero Server Uploads — Safe for Aadhaar Cards, PAN Cards, Bank Statements.</li>
        <li>✅ Unlimited File Compression — No daily file limits or paywalls.</li>
        <li>✅ Works Offline — Compress documents even without an active internet connection after page load.</li>
      </ul>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Government Portal PDF Upload Specifications</h2>
    <p class="mb-4">Standard file size limits required by official Indian portals:</p>

    <div class="overflow-x-auto mb-10">
      <table class="w-full text-left border-collapse border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden text-sm">
        <thead class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-semibold">
          <tr>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Exam Portal / Authority</th>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Max PDF File Size Limit</th>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Recommended Compression Level</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">UPSC (Civil Services / NDA)</td>
            <td class="p-3 text-amber-600 font-medium">300 KB</td>
            <td class="p-3">Medium Compression</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">SSC (CGL / CHSL / GD)</td>
            <td class="p-3 text-amber-600 font-medium">200 KB</td>
            <td class="p-3">High Compression</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">NTA (JEE Main / NEET UG)</td>
            <td class="p-3 text-amber-600 font-medium">300 KB</td>
            <td class="p-3">Medium Compression</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">IBPS / SBI Bank PO</td>
            <td class="p-3 text-amber-600 font-medium">500 KB</td>
            <td class="p-3">Standard Compression</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Frequently Asked Questions (FAQs)</h2>
    <div class="space-y-6">
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Is my PDF uploaded to any server during compression?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          No! ToolsWaala processes your PDF 100% locally inside your web browser using client-side WebAssembly. Your files never touch a server.
        </p>
      </div>
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">How to compress a PDF file size below 200KB?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          Select your PDF file in our tool, choose 'Recommended Compression', and click Compress. Our algorithm reduces image DPI and removes redundant metadata while keeping text crisp.
        </p>
      </div>
    </div>
  </article>
</Layout>