---
import Layout from '../../layouts/Layout.astro';
import PdfPageWrapper from '../../shared/PdfPageWrapper';
import { PdfToWord } from '../../react-pages/pdf';

const title = "PDF to Word Converter Free";
const description = "Extract PDF text to Word document locally. No server upload.";

const faqs = [
  {
    "q": "How to convert PDF to editable Word document?",
    "a": "Upload your PDF. The tool extracts text and layouts, compiling them into a `.docx` file that you can open and edit in Microsoft Word or Google Docs."
  },
  {
    "q": "Will the formatting remain the same in Word?",
    "a": "Our converter preserves the layout, tables, and font styles as closely as possible during the conversion."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/pdf-tools/pdf-to-word">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"PDF Tools","item":"https://toolswaala.in/pdf-tools"},{"@type":"ListItem","position":3,"name":"PDF to Word Converter Free","item":"https://toolswaala.in/pdf-tools/pdf-to-word"}]}</script>

  <PdfPageWrapper title={title} hindi="पीडीएफ से वर्ड" client:load>
    <PdfToWord client:only="react" />
  </PdfPageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; <a href="/pdf-tools">PDF Tools</a> &gt; PDF to Word Converter Free</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>