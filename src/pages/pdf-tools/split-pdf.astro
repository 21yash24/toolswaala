---
import Layout from '../../layouts/Layout.astro';
import PdfPageWrapper from '../../shared/PdfPageWrapper';
import { SplitPdf } from '../../react-pages/pdf';

const title = "Split PDF Free — Extract Pages";
const description = "Extract pages or split PDF into separate files. 100% browser-based.";

const faqs = [
  {
    "q": "How to extract specific pages from a PDF?",
    "a": "Upload your PDF, specify the page range (e.g. pages 2-5 or page 9), and click split to generate a new PDF containing only those pages."
  },
  {
    "q": "Can I split a PDF into multiple separate files?",
    "a": "Yes, you can split by page ranges, creating separate PDF files for each range."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/pdf-tools/split-pdf">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"PDF Tools","item":"https://toolswaala.in/pdf-tools"},{"@type":"ListItem","position":3,"name":"Split PDF Free — Extract Pages","item":"https://toolswaala.in/pdf-tools/split-pdf"}]}</script>

  <PdfPageWrapper title={title} hindi="पीडीएफ स्प्लिट करें" client:load>
    <SplitPdf client:only="react" />
  </PdfPageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; <a href="/pdf-tools">PDF Tools</a> &gt; Split PDF Free — Extract Pages</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>