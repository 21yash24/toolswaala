---
import Layout from '../../layouts/Layout.astro';
import PdfPageWrapper from '../../shared/PdfPageWrapper';
import { MergePdf } from '../../react-pages/pdf';

const title = "Merge PDF Files Free Online";
const description = "Combine multiple PDF documents into one. No signup, no upload.";

const faqs = [
  {
    "q": "How to combine multiple PDF files?",
    "a": "Upload the PDF files, arrange their order using our drag-and-drop builder, and click merge. All pages will be consolidated into a single file."
  },
  {
    "q": "Is there a file size limit for merging PDFs?",
    "a": "No! Since all processing happens locally inside your browser, there is no file size limit and your files are never uploaded to any server."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/pdf-tools/merge-pdf">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"PDF Tools","item":"https://toolswaala.in/pdf-tools"},{"@type":"ListItem","position":3,"name":"Merge PDF Files Free Online","item":"https://toolswaala.in/pdf-tools/merge-pdf"}]}</script>

  <PdfPageWrapper title={title} hindi="पीडीएफ मर्ज करें" client:load>
    <MergePdf client:only="react" />
  </PdfPageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; <a href="/pdf-tools">PDF Tools</a> &gt; Merge PDF Files Free Online</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>