---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { LegalHubTool } from '../react-pages/BusinessTools';

const title = "Free Legal Agreement Generator 2025 | Rent, NDA, MSA & Contracts";
const description = "Draft legally binding Rent Agreements, Non-Disclosure Agreements (NDA), Master Service Agreements (MSA), and Freelance Contracts online for free.";

const faqSchemaStr = `<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Are online legal agreement drafts legally valid in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, under the Indian Contract Act 1872, online drafts are legally binding once printed on appropriate non-judicial stamp paper, executed with physical or digital signatures by all parties, and witnessed or notarized as required by state law."
      }
    },
    {
      "@type": "Question",
      "name": "What non-judicial stamp paper value is required for rent agreements in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Stamp duty varies by state: Maharashtra (0.25% of total rent + deposit), Karnataka (Rs. 100 to Rs. 500 depending on rent amount), Delhi (Rs. 100 to Rs. 500), Uttar Pradesh (4% of annual rent). Check your local sub-registrar office for exact state rates."
      }
    },
    {
      "@type": "Question",
      "name": "Is notarization or registration mandatory for 11-month rent agreements?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under Section 17 of the Registration Act 1908, lease agreements exceeding 11 months require mandatory registration with the Sub-Registrar. 11-month agreements are traditionally notarized to save registration overhead while remaining legally valid in court."
      }
    }
  ]
}
</script>\n`;

const bcSchema = `<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://toolswaala.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "${title}",
      "item": "https://toolswaala.in/legal-hub"
    }
  ]
}
</script>\n`;
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/legal-hub">
  <Fragment set:html={faqSchemaStr} />
  <Fragment set:html={bcSchema} />

  <PageWrapper title="Legal Hub & Contract Generator" hindi="कानूनी दस्तावेज़" client:load>
    <LegalHubTool client:only="react" />
  </PageWrapper>

  <!-- Comprehensive High-Depth SEO Content Block -->
  <article class="seo-article">
    <div style="margin-bottom: 32px;">
      <span class="seo-badge">
        ⚖️ Indian Contract Act 1872 Compliant
      </span>
      <h2 style="font-size: clamp(24px, 4vw, 36px); font-weight: 800; color: var(--app-text); margin-bottom: 12px; letter-spacing: -0.02em;">
        Free Legal Agreement & Contract Generator (2025-26)
      </h2>
      <p style="font-size: 16px; color: var(--app-text-secondary); line-height: 1.7;">
        ToolsWaala Legal Hub enables small business owners, freelancers, tenants, and landlords to draft legally sound contracts without hiring expensive lawyers. Generate print-ready <strong>House Rent Agreements, Non-Disclosure Agreements (NDA), Master Service Agreements (MSA), and Commercial Invoices</strong> in minutes.
      </p>
    </div>

    <!-- Supported Legal Contracts Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-bottom: 40px;">
      <div class="seo-card" style="margin-bottom: 0;">
        <h3 style="font-size: 16px; font-weight: 800; color: var(--app-text); margin-bottom: 8px;">🏠 House Rent Agreement (11 Months)</h3>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">
          Standard residential lease contract specifying monthly rent, security deposit, lock-in period, maintenance charges, and notice period.
        </p>
      </div>
      <div class="seo-card" style="margin-bottom: 0;">
        <h3 style="font-size: 16px; font-weight: 800; color: var(--app-text); margin-bottom: 8px;">🛡️ Non-Disclosure Agreement (NDA)</h3>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">
          Unilateral and mutual confidentiality contract for startups, agencies, and software developers protecting trade secrets and IP.
        </p>
      </div>
      <div class="seo-card" style="margin-bottom: 0;">
        <h3 style="font-size: 16px; font-weight: 800; color: var(--app-text); margin-bottom: 8px;">💼 Master Service Agreement (MSA)</h3>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">
          B2B consulting & software development agreement governing payment milestones, scope of work, warranty, and liability caps.
        </p>
      </div>
    </div>

    <!-- State Non-Judicial Stamp Duty Guide -->
    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 36px; margin-bottom: 16px;">
      Indian State Stamp Duty Rate Guide (2025)
    </h3>
    <p style="font-size: 15px; color: var(--app-text-secondary); margin-bottom: 24px; line-height: 1.7;">
      To make your agreement legally enforceable in court, print your generated document on non-judicial e-stamp paper issued by Stock Holding Corporation of India Limited (SHCIL) or local sub-registrars:
    </p>
    <div class="seo-table-wrapper">
      <table class="seo-table">
        <thead>
          <tr>
            <th>State</th>
            <th>Rent Agreement Stamp Duty</th>
            <th>NDA / Service Contract Duty</th>
            <th>Recommended E-Stamp Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td style="font-weight: 700; color: var(--app-text);">Maharashtra</td>
            <td>0.25% of Total Rent + Deposit</td>
            <td>Rs. 500</td>
            <td style="color: #FF6B00; font-weight: 700;">Rs. 500 / E-Stamp</td>
          </tr>
          <tr>
            <td style="font-weight: 700; color: var(--app-text);">Karnataka</td>
            <td>0.5% - 1% of Total Annual Rent</td>
            <td>Rs. 200</td>
            <td style="color: #FF6B00; font-weight: 700;">Rs. 200 / E-Stamp</td>
          </tr>
          <tr>
            <td style="font-weight: 700; color: var(--app-text);">Delhi / NCR</td>
            <td>2% of Total Average Annual Rent</td>
            <td>Rs. 100</td>
            <td style="color: #FF6B00; font-weight: 700;">Rs. 100 / E-Stamp</td>
          </tr>
          <tr>
            <td style="font-weight: 700; color: var(--app-text);">Tamil Nadu / Telangana</td>
            <td>1% of Total Rent + Deposit</td>
            <td>Rs. 100 - 200</td>
            <td style="color: #FF6B00; font-weight: 700;">Rs. 100 / E-Stamp</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- FAQ Cards -->
    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 36px; margin-bottom: 16px;">
      Frequently Asked Questions (FAQs)
    </h3>
    <div class="seo-faq-grid">
      <div class="seo-faq-card">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">
          Are online legal agreement drafts legally valid in India?
        </h4>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">
          Yes, under the Indian Contract Act 1872, online drafts are legally binding once printed on appropriate non-judicial stamp paper, executed with physical or digital signatures by all parties, and witnessed or notarized.
        </p>
      </div>
      <div class="seo-faq-card">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">
          Is notarization or registration mandatory for 11-month rent agreements?
        </h4>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">
          Under Section 17 of the Registration Act 1908, lease agreements exceeding 11 months require mandatory registration with the Sub-Registrar. 11-month agreements are traditionally notarized to save registration overhead.
        </p>
      </div>
    </div>
  </article>
</Layout>