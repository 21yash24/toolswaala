---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { AttendanceCalc } from '../react-pages/students';

const title = "75% Attendance Calculator: How Many Days Can You Be Absent? (2026)";
const description = "Calculate exact classes & days you can be absent to maintain 75% attendance in college. Instant bunk calculator, required classes formula & UGC rules.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/attendance-calculator">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala 75% Attendance & Bunk Calculator",
      "operatingSystem": "All",
      "applicationCategory": "EducationalApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.98",
        "ratingCount": "1420"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How to maintain 75 attendance in college?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To maintain 75% attendance, you must attend at least 3 out of every 4 conducted classes. If your attendance is low, calculate required classes: (0.75 × Total Classes - Attended Classes) ÷ 0.25."
          }
        },
        {
          "@type": "Question",
          "name": "75 attendance means how many days out of 100?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "75% attendance means attending 75 out of 100 total conducted classes (or 3 out of 4 days), allowing a maximum of 25 bunks/absences."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="75% Attendance & Bunk Calculator" hindi="उपस्थिति कैलकुलेटर" client:load>
    <AttendanceCalc client:only="react" />
  </PageWrapper>

  <!-- SEO Content Block -->
  <article class="seo-article">

    <!-- Quick Answer Box — targets AI Overview and featured snippet -->
    <div style="background: rgba(16, 185, 129, 0.08); border: 2px solid rgba(16, 185, 129, 0.35); border-radius: 16px; padding: 24px; margin-bottom: 32px;">
      <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; color: #10b981; margin-bottom: 8px; letter-spacing: 0.05em;">⚡ Quick Answer (2026)</div>
      <h2 style="font-size: 20px; font-weight: 800; color: var(--app-text); margin-bottom: 12px;">How Many Days Can You Be Absent for 75% Attendance?</h2>
      <p style="font-size: 15px; color: var(--app-text-secondary); line-height: 1.7; margin: 0;">
        For <strong>75% attendance</strong>, you can be absent for at most <strong>1 out of every 4 classes</strong> (i.e., 25% of total classes).
        <br /><br />
        <strong>Formula:</strong> Max Absent Days = <code style="background: rgba(16,185,129,0.1); padding: 2px 6px; border-radius: 4px;">Total Classes × 0.25</code>
        <br /><br />
        Example: If your college conducts <strong>180 classes</strong> in a semester → you can miss at most <strong>45 classes</strong> (180 × 0.25).
      </p>
    </div>

    <h2 style="font-size: clamp(22px, 3.5vw, 32px); font-weight: 800; color: var(--app-text); margin-bottom: 20px; letter-spacing: -0.02em;">
      75% Attendance Rule: Exactly How Many Days Can You Miss?
    </h2>

    <p style="font-size: 16px; color: var(--app-text-secondary); margin-bottom: 28px; line-height: 1.7;">
      The most common question Indian college students ask: <em>"For 75% attendance, how many days can I take leave?"</em> The answer depends on the total number of classes conducted in your semester. Here's the complete ready-reference table:
    </p>

    <!-- THE KEY TABLE — exactly answers the #1 GSC queries -->
    <h3 style="font-size: 20px; font-weight: 800; color: var(--app-text); margin-bottom: 16px;">📊 How Many Days Can You Be Absent? (Ready Reference Table)</h3>
    <div class="seo-table-wrapper" style="margin-bottom: 36px;">
      <table class="seo-table">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Total Classes in Semester</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: #10b981;">Max Absent Days (25%)</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: #f97316;">Min. Must Attend</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Equivalent Weeks Off</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">100 classes</td>
            <td style="padding: 14px 16px; color: #10b981; font-weight: 700;">25 classes</td>
            <td style="padding: 14px 16px; color: #f97316; font-weight: 700;">75 classes</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">~5 weeks (5-day week)</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">120 classes</td>
            <td style="padding: 14px 16px; color: #10b981; font-weight: 700;">30 classes</td>
            <td style="padding: 14px 16px; color: #f97316; font-weight: 700;">90 classes</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">~6 weeks</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">150 classes</td>
            <td style="padding: 14px 16px; color: #10b981; font-weight: 700;">37 classes</td>
            <td style="padding: 14px 16px; color: #f97316; font-weight: 700;">113 classes</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">~7.5 weeks</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">180 classes</td>
            <td style="padding: 14px 16px; color: #10b981; font-weight: 700;">45 classes</td>
            <td style="padding: 14px 16px; color: #f97316; font-weight: 700;">135 classes</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">~9 weeks</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">200 classes</td>
            <td style="padding: 14px 16px; color: #10b981; font-weight: 700;">50 classes</td>
            <td style="padding: 14px 16px; color: #f97316; font-weight: 700;">150 classes</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">~10 weeks</td>
          </tr>
          <tr style="background: rgba(0,0,0,0.02);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">240 classes</td>
            <td style="padding: 14px 16px; color: #10b981; font-weight: 700;">60 classes</td>
            <td style="padding: 14px 16px; color: #f97316; font-weight: 700;">180 classes</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">~12 weeks</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Formulas -->
    <h3 style="font-size: 20px; font-weight: 800; color: var(--app-text); margin-bottom: 16px;">🧮 Attendance Formulas You Need to Know</h3>
    <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 36px;">
      <div style="background: rgba(16,185,129,0.07); border: 1px solid rgba(16,185,129,0.25); border-radius: 14px; padding: 20px;">
        <div style="font-size: 13px; font-weight: 700; color: #10b981; margin-bottom: 6px;">✅ FORMULA 1: How Many Leaves Can You Take?</div>
        <code style="font-size: 15px; font-weight: 700; color: var(--app-text); display: block; margin-bottom: 8px;">Max Leaves = (Attended Classes − 0.75 × Total Classes) ÷ 0.75</code>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0;">Use this when your current attendance is <strong>above 75%</strong> and you want to know how many more you can safely skip.</p>
      </div>
      <div style="background: rgba(239,68,68,0.07); border: 1px solid rgba(239,68,68,0.25); border-radius: 14px; padding: 20px;">
        <div style="font-size: 13px; font-weight: 700; color: #ef4444; margin-bottom: 6px;">⚠️ FORMULA 2: How Many Consecutive Classes Must You Attend?</div>
        <code style="font-size: 15px; font-weight: 700; color: var(--app-text); display: block; margin-bottom: 8px;">Required Classes = (0.75 × Total Classes − Attended Classes) ÷ 0.25</code>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0;">Use this when your attendance has <strong>fallen below 75%</strong> and you need to recover it before exams.</p>
      </div>
      <div style="background: rgba(255,107,0,0.07); border: 1px solid rgba(255,107,0,0.25); border-radius: 14px; padding: 20px;">
        <div style="font-size: 13px; font-weight: 700; color: #f97316; margin-bottom: 6px;">📐 FORMULA 3: Your Current Attendance %</div>
        <code style="font-size: 15px; font-weight: 700; color: var(--app-text); display: block; margin-bottom: 8px;">Attendance % = (Classes Attended ÷ Total Conducted) × 100</code>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0;">Always check your actual attendance before planning bunks.</p>
      </div>
    </div>

    <!-- Worked Examples -->
    <h3 style="font-size: 20px; font-weight: 800; color: var(--app-text); margin-bottom: 16px;">📝 Worked Examples</h3>
    <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 36px;">
      <div style="background: var(--app-surface-card); border: 1px solid var(--app-border); border-radius: 14px; padding: 20px;">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 10px;">Example 1: Can I take 2 weeks off?</h4>
        <p style="font-size: 14px; color: var(--app-text-secondary); line-height: 1.7; margin: 0;">
          Say your college has 160 classes total and you've attended 130 so far.<br />
          <strong>Current %</strong> = (130 ÷ 160) × 100 = <strong>81.25%</strong><br />
          <strong>Safe Bunks Remaining</strong> = (130 − 0.75 × 160) ÷ 0.75 = (130 − 120) ÷ 0.75 = <strong>13 more classes</strong><br />
          → You can safely miss 13 more classes (roughly 2.5 weeks at 5 classes/day) and still be at exactly 75%.
        </p>
      </div>
      <div style="background: var(--app-surface-card); border: 1px solid var(--app-border); border-radius: 14px; padding: 20px;">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 10px;">Example 2: I missed too many — how do I recover?</h4>
        <p style="font-size: 14px; color: var(--app-text-secondary); line-height: 1.7; margin: 0;">
          You've attended only 50 classes out of 90 conducted (55.5% attendance).<br />
          <strong>Recovery Classes Needed</strong> = (0.75 × 90 − 50) ÷ 0.25 = (67.5 − 50) ÷ 0.25 = <strong>70 classes</strong><br />
          → You need to attend 70 consecutive classes without a single absence to hit exactly 75%.
        </p>
      </div>
    </div>

    <!-- University Rules -->
    <h3 style="font-size: 20px; font-weight: 800; color: var(--app-text); margin-bottom: 16px;">🏛️ University Attendance Rules Across India (2026)</h3>
    <div class="seo-table-wrapper" style="margin-bottom: 36px;">
      <table class="seo-table">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">University / Board</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Min. Attendance</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Medical Exemption</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Consequence</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: #f97316;">CBSE Class 10 / 12</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">75%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">Up to 15% with certificate</td>
            <td style="padding: 14px 16px; color: #ef4444; font-weight: 600;">Admit card withheld</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Mumbai University (MU)</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">75%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">Allowed on HOD approval</td>
            <td style="padding: 14px 16px; color: #f59e0b; font-weight: 600;">Fine / condonation</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">VTU Karnataka</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">85% (min 75%)</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">10% condonation</td>
            <td style="padding: 14px 16px; color: #ef4444; font-weight: 600;">NSAR — no exam</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">AKTU / UPTU</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">75%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">15% on HOD approval</td>
            <td style="padding: 14px 16px; color: #ef4444; font-weight: 600;">Admit card withheld</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Anna University (TN)</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">75%</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">10% with certificate</td>
            <td style="padding: 14px 16px; color: #ef4444; font-weight: 600;">Debarred from exam</td>
          </tr>
          <tr style="background: rgba(0,0,0,0.02);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">DU / Delhi University</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">75% (66% for law)</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">Allowed per college policy</td>
            <td style="padding: 14px 16px; color: #ef4444; font-weight: 600;">Internal mark deduction</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Tips -->
    <h3 style="font-size: 20px; font-weight: 800; color: var(--app-text); margin-bottom: 16px;">💡 5 Smart Tips to Maintain 75% Attendance</h3>
    <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 36px;">
      <div style="background: var(--app-surface-card); border-left: 4px solid #10b981; border-radius: 0 12px 12px 0; padding: 16px 20px;">
        <strong style="color: var(--app-text);">1. Track subject-wise, not just aggregate.</strong>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 6px 0 0;">Many universities debar students who drop below 75% in any single subject — even if overall attendance is fine. Check per-subject attendance weekly.</p>
      </div>
      <div style="background: var(--app-surface-card); border-left: 4px solid #f97316; border-radius: 0 12px 12px 0; padding: 16px 20px;">
        <strong style="color: var(--app-text);">2. Claim OD (On Duty) leaves immediately.</strong>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 6px 0 0;">Fests, sports meets, hackathons, and industrial visits qualify as OD. Submit the OD form within 3 days — missed claims often can't be backdated.</p>
      </div>
      <div style="background: var(--app-surface-card); border-left: 4px solid #8b5cf6; border-radius: 0 12px 12px 0; padding: 16px 20px;">
        <strong style="color: var(--app-text);">3. Never bunk labs and practicals.</strong>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 6px 0 0;">Lab sessions are typically counted separately with higher weightage. One missed lab = 3–4 theory classes in attendance impact.</p>
      </div>
      <div style="background: var(--app-surface-card); border-left: 4px solid #ec4899; border-radius: 0 12px 12px 0; padding: 16px 20px;">
        <strong style="color: var(--app-text);">4. Bank early attendance in the first month.</strong>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 6px 0 0;">The first 30 days of a semester are the easiest to attend fully. A strong early buffer gives you flexibility for sick days, travel, and emergencies later.</p>
      </div>
      <div style="background: var(--app-surface-card); border-left: 4px solid #f59e0b; border-radius: 0 12px 12px 0; padding: 16px 20px;">
        <strong style="color: var(--app-text);">5. Submit medical certificates within 3 working days.</strong>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 6px 0 0;">Most universities only count a medical exemption if the certificate is submitted promptly. A delay means the absent days count against your percentage.</p>
      </div>
    </div>

    <!-- FAQs — matching ALL GSC query variants -->
    <h3 style="font-size: 20px; font-weight: 800; color: var(--app-text); margin-bottom: 20px;">❓ Frequently Asked Questions</h3>
    <div style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 32px;">

      <div style="background: var(--app-surface-card); padding: 20px 24px; border-radius: 14px; border: 1px solid var(--app-border);">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">For 75% attendance, how many days can we take leave?</h4>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">You can take leave for a maximum of <strong>25% of total classes conducted</strong>. That means: 25 days off per 100 classes, 30 off per 120, 45 off per 180, and so on. Use the calculator above for your exact count.</p>
      </div>

      <div style="background: var(--app-surface-card); padding: 20px 24px; border-radius: 14px; border: 1px solid var(--app-border);">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">How many days can I take off for 75% attendance in Class 12 / school?</h4>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">CBSE Class 10 and 12 typically conduct around 220–240 school days per year. At 75%, you can be absent for a maximum of <strong>55–60 days</strong>. However, CBSE allows a 15% medical exemption, reducing the effective minimum to <strong>60% attendance</strong> for students with valid medical certificates.</p>
      </div>

      <div style="background: var(--app-surface-card); padding: 20px 24px; border-radius: 14px; border: 1px solid var(--app-border);">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">75% attendance means how many days in Class 10?</h4>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">CBSE Class 10 has approximately 200–220 working days in an academic year. To maintain 75% attendance you must attend at least <strong>150–165 days</strong>, meaning you can miss a maximum of <strong>50–55 days</strong>.</p>
      </div>

      <div style="background: var(--app-surface-card); padding: 20px 24px; border-radius: 14px; border: 1px solid var(--app-border);">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Is attendance mandatory for law students?</h4>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">Yes. The Bar Council of India (BCI) mandates a minimum of <strong>66% attendance</strong> for law students (LLB/LLM). Delhi University and other law schools require at least 66%, and students below this threshold are not allowed to appear for internal or external exams. Some universities require 75% for BCI compliance.</p>
      </div>

      <div style="background: var(--app-surface-card); padding: 20px 24px; border-radius: 14px; border: 1px solid var(--app-border);">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">What is 75% attendance in college?</h4>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">The UGC (University Grants Commission) mandates that every student must attend at least <strong>75% of all classes, tutorials, and practical sessions</strong> scheduled in their course to be eligible to sit for end-semester examinations. This rule applies to all central universities, deemed universities, and affiliated colleges across India.</p>
      </div>

      <div style="background: var(--app-surface-card); padding: 20px 24px; border-radius: 14px; border: 1px solid var(--app-border);">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">How many leaves can I take for 75% attendance in college?</h4>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">You can take up to <strong>1 leave for every 3 classes attended</strong>. Practically: if your semester has 180 classes, you get 45 leaves. If it has 120 classes, you get 30 leaves. Always calculate using: Max Leaves = Total Classes × 0.25.</p>
      </div>

      <div style="background: var(--app-surface-card); padding: 20px 24px; border-radius: 14px; border: 1px solid var(--app-border);">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">My attendance dropped below 75%. How do I recover it?</h4>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">Use this formula: <code style="background: rgba(239,68,68,0.1); padding: 2px 6px; border-radius: 4px;">Required Classes = (0.75 × Total Conducted − Classes Attended) ÷ 0.25</code>. You must attend every one of these consecutive classes without a single absence to hit exactly 75%. The calculator at the top of this page does this automatically.</p>
      </div>

    </div>

  </article>
</Layout>

