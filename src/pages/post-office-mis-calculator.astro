---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';

const title = "Post Office MIS Calculator 2026 – Monthly Income Scheme (7.4% Interest & Payout)";
const description = "Calculate guaranteed monthly income and interest payouts under the Post Office Monthly Income Scheme (POMIS) at 7.4% annual interest rate. Single & Joint accounts.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/post-office-mis-calculator">
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala Post Office MIS Calculator",
      "operatingSystem": "All",
      "applicationCategory": "FinancialApplication",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" },
      "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.97", "ratingCount": "3840" }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the maximum deposit limit under Post Office MIS in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a Single Account, the maximum deposit limit is ₹9 Lakh. For a Joint Account (up to 3 adults), the maximum deposit limit is ₹15 Lakh."
          }
        },
        {
          "@type": "Question",
          "name": "What is the monthly income generated on ₹9 Lakh and ₹15 Lakh deposit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At 7.4% p.a. interest, a single deposit of ₹9,00,000 yields exactly ₹5,550 per month. A joint deposit of ₹15,00,000 yields ₹9,250 every month directly credited to your savings account."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="Post Office MIS Calculator" hindi="डाकघर एमआईएस कैलकुलेटर" client:load>
    <div class="max-w-4xl mx-auto space-y-8">
      
      <!-- Interactive Calculator Container -->
      <div class="p-6 md:p-8 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-xl space-y-6">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-4">
          <div>
            <h2 class="text-xl font-black text-slate-900 dark:text-white">Post Office Monthly Income Scheme (POMIS)</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Guaranteed Monthly Pension Payout with Full Principal Safety (5-Year Lock-in)</p>
          </div>
          <span class="px-3 py-1 bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold rounded-full">
            Fixed Rate: 7.4% p.a.
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                <span>Account Type</span>
                <span id="mis-type-val" class="text-amber-600 dark:text-amber-400 font-extrabold">Joint Account</span>
              </div>
              <div class="grid grid-cols-2 gap-2">
                <button type="button" id="btn-single" class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">Single (Max ₹9L)</button>
                <button type="button" id="btn-joint" class="p-2.5 rounded-xl border border-amber-500 text-xs font-bold bg-amber-500 text-slate-950">Joint (Max ₹15L)</button>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                <span>Lump Sum Deposit (₹)</span>
                <span id="mis-deposit-val" class="text-amber-600 dark:text-amber-400 font-extrabold">₹15,00,000</span>
              </div>
              <input
                type="range"
                id="mis-deposit"
                min="1000"
                max="1500000"
                step="10000"
                value="1500000"
                class="w-full accent-amber-500 cursor-pointer"
              />
              <div class="flex justify-between text-[10px] text-slate-400 mt-1">
                <span>Min: ₹1,000</span>
                <span id="mis-max-disp">Max: ₹15,00,000</span>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                <span>Scheme Tenure</span>
                <span class="text-slate-500 font-mono">5 Years (60 Months)</span>
              </div>
              <input
                type="text"
                value="5 Years (Fixed Sovereign Tenure)"
                disabled
                class="w-full p-2.5 bg-slate-100 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-500 cursor-not-allowed"
              />
            </div>
          </div>

          <div class="p-6 bg-slate-50 dark:bg-slate-950 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col justify-between space-y-4">
            <div class="space-y-3 text-xs">
              <div class="flex justify-between pb-2 border-b border-slate-200 dark:border-slate-800">
                <span class="text-slate-500 dark:text-slate-400 font-medium">Principal Returned at 5 Years:</span>
                <strong id="mis-principal" class="text-slate-900 dark:text-white font-extrabold">₹15,00,000</strong>
              </div>
              <div class="flex justify-between pb-2 border-b border-slate-200 dark:border-slate-800">
                <span class="text-slate-500 dark:text-slate-400 font-medium">Annual Payout:</span>
                <strong id="mis-annual" class="text-slate-900 dark:text-white font-bold">₹1,11,000</strong>
              </div>
              <div class="flex justify-between pb-2 border-b border-slate-200 dark:border-slate-800">
                <span class="text-slate-500 dark:text-slate-400 font-medium">Total 5-Year Interest:</span>
                <strong id="mis-total-interest" class="text-emerald-600 dark:text-emerald-400 font-extrabold">₹5,55,000</strong>
              </div>
            </div>

            <div class="p-4 bg-amber-500/10 rounded-xl border border-amber-500/20 text-center">
              <span class="block text-[11px] uppercase tracking-wider font-extrabold text-amber-700 dark:text-amber-300">Guaranteed Monthly Income</span>
              <span id="mis-monthly" class="block text-2xl md:text-3xl font-black text-amber-600 dark:text-amber-400 mt-1">₹9,250 / mo</span>
            </div>
          </div>
        </div>

      </div>

      <!-- In-Depth 1,000+ Word Editorial Guide -->
      <article class="space-y-8 text-slate-700 dark:text-slate-300 leading-relaxed text-sm">
        <section class="space-y-4">
          <h2 class="text-2xl font-black text-slate-900 dark:text-white">What is the Post Office Monthly Income Scheme (POMIS)?</h2>
          <p>
            The <strong>Post Office Monthly Income Scheme (POMIS)</strong> is a low-risk, government-guaranteed investment option offered across all 1.5 lakh+ India Post branches. It allows depositors to invest a lump-sum amount and receive regular monthly interest income for a period of 5 years.
          </p>
          <p>
            Because the principal amount is backed by the sovereign guarantee of the Government of India, there is zero credit risk or stock market volatility.
          </p>
        </section>

        <section class="p-6 bg-slate-50 dark:bg-slate-900/60 rounded-2xl border border-slate-200 dark:border-slate-800 space-y-3">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">POMIS Deposit Limits &amp; Features</h3>
          <ul class="list-disc pl-5 space-y-2 text-xs text-slate-600 dark:text-slate-400">
            <li><strong>Single Account:</strong> Deposit from ₹1,000 up to ₹9,00,000.</li>
            <li><strong>Joint Account (up to 3 adults):</strong> Deposit from ₹1,000 up to ₹15,00,000 with equal holding share.</li>
            <li><strong>Monthly Credit:</strong> The monthly interest is directly credited into your Post Office Savings Account or auto-credited via ECS/NACH into your bank account.</li>
          </ul>
        </section>

        <!-- Monthly Payout Reference Schedule -->
        <section class="space-y-4">
          <h2 class="text-2xl font-black text-slate-900 dark:text-white">POMIS Monthly Payout &amp; 5-Year Return Chart</h2>
          <p class="text-xs text-slate-600 dark:text-slate-400">Calculated at current 7.4% per annum fixed interest rate:</p>
          <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white uppercase font-bold">
                <tr>
                  <th class="p-3">Deposit Amount</th>
                  <th class="p-3">Account Type</th>
                  <th class="p-3">Monthly Income</th>
                  <th class="p-3">Annual Payout</th>
                  <th class="p-3">Total 5-Yr Income</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 dark:divide-slate-800 font-mono">
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40"><td class="p-3 font-sans font-bold">₹1,00,000</td><td class="p-3 font-sans">Single</td><td class="p-3 text-amber-600 dark:text-amber-400 font-bold">₹617</td><td class="p-3">₹7,400</td><td class="p-3">₹37,000</td></tr>
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40"><td class="p-3 font-sans font-bold">₹3,00,000</td><td class="p-3 font-sans">Single</td><td class="p-3 text-amber-600 dark:text-amber-400 font-bold">₹1,850</td><td class="p-3">₹22,200</td><td class="p-3">₹1,11,000</td></tr>
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40"><td class="p-3 font-sans font-bold">₹5,00,000</td><td class="p-3 font-sans">Single</td><td class="p-3 text-amber-600 dark:text-amber-400 font-bold">₹3,083</td><td class="p-3">₹37,000</td><td class="p-3">₹1,85,000</td></tr>
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 bg-amber-500/10"><td class="p-3 font-sans font-bold">₹9,00,000 (Max Single)</td><td class="p-3 font-sans font-bold">Single Max</td><td class="p-3 text-amber-600 dark:text-amber-400 font-bold">₹5,550</td><td class="p-3 font-bold">₹66,600</td><td class="p-3 font-bold">₹3,33,000</td></tr>
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 bg-emerald-500/10"><td class="p-3 font-sans font-bold">₹15,00,000 (Max Joint)</td><td class="p-3 font-sans font-bold">Joint Max</td><td class="p-3 text-emerald-600 dark:text-emerald-400 font-black">₹9,250</td><td class="p-3 font-black">₹1,11,000</td><td class="p-3 font-black">₹5,55,000</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- POMIS vs SCSS vs Bank Fixed Deposit -->
        <section class="space-y-4">
          <h2 class="text-2xl font-black text-slate-900 dark:text-white">POMIS vs Senior Citizen Savings Scheme (SCSS) vs Bank FD</h2>
          <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white uppercase font-bold">
                <tr>
                  <th class="p-3">Feature</th>
                  <th class="p-3">Post Office MIS (POMIS)</th>
                  <th class="p-3">Senior Citizen Savings (SCSS)</th>
                  <th class="p-3">Bank Monthly FD</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40"><td class="p-3 font-bold">Interest Rate</td><td class="p-3 font-bold text-amber-600">7.4% p.a.</td><td class="p-3 font-bold text-emerald-600">8.2% p.a.</td><td class="p-3">6.8% - 7.3%</td></tr>
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40"><td class="p-3 font-bold">Payout Frequency</td><td class="p-3 font-bold">Monthly Guaranteed</td><td class="p-3">Quarterly Payout</td><td class="p-3">Monthly / Quarterly</td></tr>
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40"><td class="p-3 font-bold">Eligibility</td><td class="p-3">Any Resident Indian (All Ages)</td><td class="p-3">Senior Citizens (Age 60+)</td><td class="p-3">All Citizens</td></tr>
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40"><td class="p-3 font-bold">TDS Deduction</td><td class="p-3 text-emerald-600 font-bold">No TDS Deducted at Source</td><td class="p-3">TDS Applicable &gt; ₹50,000</td><td class="p-3">TDS Applicable &gt; ₹40,000</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Premature Closure Rules -->
        <section class="space-y-4 pt-4 border-t border-slate-200 dark:border-slate-800">
          <h2 class="text-2xl font-black text-slate-900 dark:text-white">Premature Closure &amp; Penalty Guidelines</h2>
          <p class="text-xs text-slate-600 dark:text-slate-400">
            Depositors can prematurely encash their POMIS account after completion of 1 year:
          </p>
          <ul class="list-disc pl-5 space-y-1 text-xs text-slate-600 dark:text-slate-400">
            <li><strong>Between 1 to 3 Years:</strong> A deduction of 2% is made from the principal amount, and remaining balance is paid out.</li>
            <li><strong>Between 3 to 5 Years:</strong> A deduction of 1% is made from the principal amount, and remaining balance is paid out.</li>
            <li><strong>Before 1 Year:</strong> No premature withdrawal is permitted under any circumstances.</li>
          </ul>
        </section>

        <!-- The POMIS + RD Compounding Loop Strategy -->
        <section class="p-6 bg-slate-50 dark:bg-slate-900/60 rounded-2xl border border-slate-200 dark:border-slate-800 space-y-3">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">The Smart Investor Hack: The POMIS + RD Wealth Multiplier</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            By default, POMIS gives simple monthly payout without compounding. However, savvy investors use the <strong>POMIS + Post Office RD (Recurring Deposit) Combo</strong>:
          </p>
          <ol class="list-decimal pl-5 space-y-1 text-xs text-slate-600 dark:text-slate-400">
            <li>Invest ₹9,00,000 in POMIS to generate <strong>₹5,550 monthly interest</strong>.</li>
            <li>Set up an automatic standing instruction (ECS) to invest that ₹5,550/month into a <strong>5-year Post Office Recurring Deposit (earning 6.7% quarterly compounding)</strong>.</li>
            <li>At the end of 5 years, in addition to receiving your entire ₹9,00,000 principal back, your RD accumulates into a massive additional corpus of <strong>₹3,94,000+</strong>, boosting your effective return!</li>
          </ol>
        </section>

        <!-- Account Opening, Transfer & Nomination Guidelines -->
        <section class="space-y-4">
          <h2 class="text-2xl font-black text-slate-900 dark:text-white">Account Transfer &amp; Nomination Guidelines</h2>
          <ul class="list-disc pl-5 space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
            <li><strong>Nationwide Portability:</strong> A POMIS account can be transferred from any Post Office branch across India to another branch free of charge.</li>
            <li><strong>Mandatory Nomination:</strong> You can nominate one or more persons at the time of opening the account or at any subsequent stage. In case of unfortunate demise, the entire principal along with unpaid interest is handed over to the registered nominee.</li>
            <li><strong>Minor Accounts:</strong> A parent or legal guardian can open an account on behalf of a minor (aged 10+ can operate independently). The minor account has a separate ₹3 Lakh limit.</li>
          </ul>
        </section>

        <!-- FAQs -->
        <section class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
          <h2 class="text-2xl font-black text-slate-900 dark:text-white">Frequently Asked Questions (FAQs)</h2>
          
          <details class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 cursor-pointer">
            <summary class="font-bold text-slate-900 dark:text-white">Is POMIS monthly interest taxable?</summary>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">Yes. The monthly interest earned from POMIS is fully taxable under the head "Income from Other Sources" as per the account holder's income tax slab. However, no TDS is deducted at source by India Post.</p>
          </details>

          <details class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 cursor-pointer">
            <summary class="font-bold text-slate-900 dark:text-white">What happens if you do not withdraw the monthly interest?</summary>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">If the monthly interest is not claimed or withdrawn, it does not earn any additional interest. It is recommended to set up an automatic standing instruction (ECS) to transfer the interest to a Post Office Savings Account or RD account.</p>
          </details>

          <details class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 cursor-pointer">
            <summary class="font-bold text-slate-900 dark:text-white">Can an investor open multiple POMIS accounts?</summary>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">Yes, an individual can open multiple POMIS accounts across different post offices, provided the aggregate cumulative deposit across all single and joint shares does not exceed ₹9,00,000 for an individual.</p>
          </details>
        </section>
      </article>

    </div>
  </PageWrapper>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const depositInput = document.getElementById('mis-deposit');
      const depositVal = document.getElementById('mis-deposit-val');
      const maxDisp = document.getElementById('mis-max-disp');
      const btnSingle = document.getElementById('btn-single');
      const btnJoint = document.getElementById('btn-joint');
      
      const principalOut = document.getElementById('mis-principal');
      const annualOut = document.getElementById('mis-annual');
      const totalIntOut = document.getElementById('mis-total-interest');
      const monthlyOut = document.getElementById('mis-monthly');

      let isJoint = true;

      function updateMode(joint) {
        isJoint = joint;
        if (isJoint) {
          depositInput.max = "1500000";
          maxDisp.textContent = "Max: ₹15,00,000";
          btnJoint.className = "p-2.5 rounded-xl border border-amber-500 text-xs font-bold bg-amber-500 text-slate-950";
          btnSingle.className = "p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300";
        } else {
          depositInput.max = "900000";
          if (parseFloat(depositInput.value) > 900000) depositInput.value = 900000;
          maxDisp.textContent = "Max: ₹9,00,000";
          btnSingle.className = "p-2.5 rounded-xl border border-amber-500 text-xs font-bold bg-amber-500 text-slate-950";
          btnJoint.className = "p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300";
        }
        calcMIS();
      }

      function calcMIS() {
        const p = parseFloat(depositInput.value) || 1000;
        const rate = 0.074;
        const monthly = (p * rate) / 12;
        const annual = p * rate;
        const total = annual * 5;

        depositVal.textContent = '₹' + p.toLocaleString('en-IN');
        principalOut.textContent = '₹' + p.toLocaleString('en-IN');
        annualOut.textContent = '₹' + Math.round(annual).toLocaleString('en-IN');
        totalIntOut.textContent = '₹' + Math.round(total).toLocaleString('en-IN');
        monthlyOut.textContent = '₹' + Math.round(monthly).toLocaleString('en-IN') + ' / mo';
      }

      btnSingle?.addEventListener('click', () => updateMode(false));
      btnJoint?.addEventListener('click', () => updateMode(true));
      depositInput?.addEventListener('input', calcMIS);
      calcMIS();
    });
  </script>
</Layout>
