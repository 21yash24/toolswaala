---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { ResumeBuilder } from '../react-pages/students';

const title = "Free Resume Builder for Freshers 2025 | ATS Friendly PDF Generator";
const description = "Free online ATS Resume Builder for college graduates and freshers. Create professional, single-page PDF resumes optimized for Naukri, LinkedIn, and campus placements.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/resume-builder">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala ATS Resume Builder for Freshers",
      "operatingSystem": "All",
      "applicationCategory": "BusinessApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.92",
        "ratingCount": "2150"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is an ATS-friendly resume format?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An ATS (Applicant Tracking System) friendly resume uses clean single-column layouts, standard fonts (Arial, Helvetica, Inter), standard section headings (Education, Experience, Skills), and no complex graphic elements or tables that confuse HR parsing software."
          }
        },
        {
          "@type": "Question",
          "name": "Should freshers create a single page resume?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Candidates with under 3 years of work experience should strictly keep their resume to a 1-page format. HR recruiters spend an average of 6 seconds reviewing each resume."
          }
        },
        {
          "@type": "Question",
          "name": "What key sections should a fresher resume include?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A fresher resume must include 5 key sections: 1. Contact Information & LinkedIn Profile, 2. Professional Summary / Career Objective, 3. Education & CGPA, 4. Academic Projects & Internships, 5. Technical & Soft Skills."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="ATS Resume Builder" hindi="रिज्यूमे बनाएं" client:load>
    <ResumeBuilder client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article class="max-w-4xl mx-auto px-4 py-8 text-slate-800 dark:text-slate-200 leading-relaxed font-sans">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:underline">Home</a> &gt; <a href="/students" class="hover:underline">Student Tools</a> &gt; <span class="font-medium text-slate-700 dark:text-slate-300">Free Resume Builder for Freshers</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
      Free ATS Resume Builder for Freshers & Students 2025
    </h1>
    
    <p class="text-lg text-slate-600 dark:text-slate-300 mb-8">
      Build a professional, single-page <strong>ATS-compliant resume</strong> in minutes. Specially designed for college graduates, engineering freshers, and entry-level job seekers applying on <strong>Naukri, LinkedIn, Indeed, and Campus Placements</strong>.
    </p>

    <div class="bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 rounded-xl p-6 mb-8">
      <h2 class="text-xl font-bold text-indigo-950 dark:text-indigo-200 mb-3">Why 75% of Freshers Get Rejected by ATS</h2>
      <p class="text-slate-700 dark:text-slate-300 text-sm mb-3">
        Over 90% of Fortune 500 companies and top Indian IT recruiters (TCS, Infosys, Wipro, Accenture) use Applicant Tracking Systems (ATS) like Taleo, Workday, and Greenhouse to screen candidate applications before a human recruiter sees them.
      </p>
      <ul class="space-y-2 text-slate-700 dark:text-slate-300 text-sm">
        <li>❌ <strong>Mistake 1:</strong> Using multi-column Canva graphics templates (ATS cannot read graphic columns).</li>
        <li>❌ <strong>Mistake 2:</strong> Putting skills inside image rating bars instead of text.</li>
        <li>❌ <strong>Mistake 3:</strong> Saving resumes as scanned images instead of text-searchable PDFs.</li>
        <li>✅ <strong>ToolsWaala Fix:</strong> Our templates output clean, text-parsed single-column PDFs scored for 100% ATS compatibility.</li>
      </ul>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">5 Must-Have Sections for a Fresher Resume</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
      <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="font-bold text-slate-900 dark:text-white mb-2">1. Header & Links</h3>
        <p class="text-xs text-slate-600 dark:text-slate-300">Full name, phone, email, city, and hyperlinked GitHub/LinkedIn profiles.</p>
      </div>
      <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="font-bold text-slate-900 dark:text-white mb-2">2. Education & CGPA</h3>
        <p class="text-xs text-slate-600 dark:text-slate-300">Degree, college name, graduation year, and converted percentage or CGPA.</p>
      </div>
      <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="font-bold text-slate-900 dark:text-white mb-2">3. Academic Projects</h3>
        <p class="text-xs text-slate-600 dark:text-slate-300">Highlight 2-3 final year or major projects with technologies used and quantifiable results.</p>
      </div>
      <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="font-bold text-slate-900 dark:text-white mb-2">4. Technical Skills</h3>
        <p class="text-xs text-slate-600 dark:text-slate-300">Categorize skills: Languages (Java, Python), Frameworks (React, Node), Databases (SQL, MongoDB).</p>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Action Verbs to Boost Resume Impact</h2>
    <p class="mb-4">Begin every project bullet point with strong action verbs:</p>
    <div class="flex flex-wrap gap-2 mb-8">
      <span class="px-3 py-1 bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 rounded-full text-xs font-semibold">Developed</span>
      <span class="px-3 py-1 bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 rounded-full text-xs font-semibold">Architected</span>
      <span class="px-3 py-1 bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 rounded-full text-xs font-semibold">Implemented</span>
      <span class="px-3 py-1 bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 rounded-full text-xs font-semibold">Optimized</span>
      <span class="px-3 py-1 bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 rounded-full text-xs font-semibold">Automated</span>
      <span class="px-3 py-1 bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 rounded-full text-xs font-semibold">Engineered</span>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Frequently Asked Questions (FAQs)</h2>
    <div class="space-y-6">
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">What is an ATS-friendly resume format?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          An ATS (Applicant Tracking System) friendly resume uses clean single-column layouts, standard fonts, clear headings, and text-based bullet points that software can parse cleanly.
        </p>
      </div>
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Should freshers create a single page resume?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          Yes! Candidates with under 3 years of work experience should strictly keep their resume to a 1-page format.
        </p>
      </div>
    </div>
  </article>
</Layout>