---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { AgeCalculator } from '../react-pages/students';

const title = "Exact Age Calculator Online 2025 | Calculate Age for Govt Exams";
const description = "Calculate your exact age in years, months, days, hours, and minutes as of any cut-off date. Ideal for UPSC, SSC, IBPS, and Railway job application forms.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/age-calculator">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala Exact Age Calculator",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.96",
        "ratingCount": "2410"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How to calculate age as of a specific cut-off date for government exams?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Select your Date of Birth in the first field, and set the 'Age at Date' field to the official cut-off date specified in the exam notification (e.g. 1st August 2025 for UPSC or 1st January 2025 for SSC)."
          }
        },
        {
          "@type": "Question",
          "name": "Does the calculator account for leap years?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! The calculation engine accounts for leap years (366 days with February 29th) and varying days in calendar months (28, 30, or 31 days) to give 100% mathematical precision."
          }
        },
        {
          "@type": "Question",
          "name": "What additional information does the age calculator show?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Along with age in years, months, and days, it displays total days lived, total hours, total minutes, zodiac sign, generation classification, and a countdown to your next birthday."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="Age Calculator" hindi="आयु कैलकुलेटर" client:load>
    <AgeCalculator client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article class="seo-article">
    

    <h2 style="font-size: clamp(24px, 4vw, 36px); font-weight: 800; color: var(--app-text); margin-bottom: 16px; letter-spacing: -0.02em;">
      Exact Age Calculator Online 2025 (Govt Exam Cut-off Age)
    </h2>
    
    <p style="font-size: 16px; color: var(--app-text-secondary); margin-bottom: 32px; line-height: 1.7;">
      Calculate your exact age down to <strong>years, months, weeks, days, hours, and minutes</strong>. Easily determine your eligibility for <strong>UPSC Civil Services, SSC CGL, IBPS Bank PO, State PSC, and Railway exam application forms</strong>.
    </p>

    <div style="background: var(--app-surface-card); border: 1px solid var(--app-border); border-radius: 20px; padding: 28px; margin-bottom: 40px; box-shadow: 0 4px 20px -2px rgba(0,0,0,0.05);">
      <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Govt Job Exam Cut-off Date Matrix</h3>
      <p class="text-slate-700 dark:text-slate-300 text-sm mb-3">
        Most recruitment notifications specify an exact eligibility cut-off date:
      </p>
      <ul class="space-y-1 text-slate-700 dark:text-slate-300 text-xs">
        <li>📌 <strong>UPSC IAS / IPS:</strong> Age as of August 1st of the exam year (Min 21 - Max 32 years for General).</li>
        <li>📌 <strong>SSC CGL / CHSL:</strong> Age as of January 1st or August 1st depending on notification tier.</li>
        <li>📌 <strong>IBPS / SBI PO:</strong> Age as of April 1st of the financial year.</li>
        <li>📌 <strong>RRB NTPC / Group D:</strong> Age as of July 1st.</li>
      </ul>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Demographic Generation Classification Table</h3>
    <div class="seo-table-wrapper">
      <table class="seo-table">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Generation Name</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Birth Year Range</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">Current Approximate Age (2025)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Gen Alpha</td>
            <td class="p-3 text-indigo-600 font-medium">2013 – 2024</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">1 to 12 Years</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Gen Z (Zoomers)</td>
            <td class="p-3 text-indigo-600 font-medium">1997 – 2012</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">13 to 28 Years</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Millennials (Gen Y)</td>
            <td class="p-3 text-indigo-600 font-medium">1981 – 1996</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">29 to 44 Years</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Gen X</td>
            <td class="p-3 text-indigo-600 font-medium">1965 – 1980</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">45 to 60 Years</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Baby Boomers</td>
            <td class="p-3 text-indigo-600 font-medium">1946 – 1964</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">61 to 79 Years</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Frequently Asked Questions (FAQs)</h3>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">How to calculate age as of a specific cut-off date for government exams?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          Select your Date of Birth in the first field, and set the 'Age at Date' field to the official cut-off date specified in the exam notification.
        </p>
      </div>
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Does the calculator account for leap years?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          Yes! The calculation engine accounts for leap years (366 days) and varying days in calendar months to give 100% mathematical precision.
        </p>
      </div>
    </div>
  </article>
</Layout>