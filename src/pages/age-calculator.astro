---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { AgeCalculator } from '../react-pages/students';

const title = "Exact Age Calculator Online 2025 | Calculate Age for Govt Exams";
const description = "Calculate your exact age in years, months, days, hours, and minutes as of any cut-off date. Ideal for UPSC, SSC, IBPS, and Railway job application forms.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/age-calculator">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala Exact Age Calculator",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.96",
        "ratingCount": "2410"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How to calculate age as of a specific cut-off date for government exams?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Select your Date of Birth in the first field, and set the 'Age at Date' field to the official cut-off date specified in the exam notification (e.g. 1st August 2025 for UPSC or 1st January 2025 for SSC)."
          }
        },
        {
          "@type": "Question",
          "name": "Does the calculator account for leap years?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! The calculation engine accounts for leap years (366 days with February 29th) and varying days in calendar months (28, 30, or 31 days) to give 100% mathematical precision."
          }
        },
        {
          "@type": "Question",
          "name": "What additional information does the age calculator show?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Along with age in years, months, and days, it displays total days lived, total hours, total minutes, zodiac sign, generation classification, and a countdown to your next birthday."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="Age Calculator" hindi="आयु कैलकुलेटर" client:load>
    <AgeCalculator client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article class="max-w-4xl mx-auto px-4 py-8 text-slate-800 dark:text-slate-200 leading-relaxed font-sans">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:underline">Home</a> &gt; <a href="/students" class="hover:underline">Student Tools</a> &gt; <span class="font-medium text-slate-700 dark:text-slate-300">Age Calculator</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
      Exact Age Calculator Online 2025 (Govt Exam Cut-off Age)
    </h1>
    
    <p class="text-lg text-slate-600 dark:text-slate-300 mb-8">
      Calculate your exact age down to <strong>years, months, weeks, days, hours, and minutes</strong>. Easily determine your eligibility for <strong>UPSC Civil Services, SSC CGL, IBPS Bank PO, State PSC, and Railway exam application forms</strong>.
    </p>

    <div class="bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 rounded-xl p-6 mb-8">
      <h2 class="text-xl font-bold text-indigo-950 dark:text-indigo-200 mb-3">Govt Job Exam Cut-off Date Matrix</h2>
      <p class="text-slate-700 dark:text-slate-300 text-sm mb-3">
        Most recruitment notifications specify an exact eligibility cut-off date:
      </p>
      <ul class="space-y-1 text-slate-700 dark:text-slate-300 text-xs">
        <li>📌 <strong>UPSC IAS / IPS:</strong> Age as of August 1st of the exam year (Min 21 - Max 32 years for General).</li>
        <li>📌 <strong>SSC CGL / CHSL:</strong> Age as of January 1st or August 1st depending on notification tier.</li>
        <li>📌 <strong>IBPS / SBI PO:</strong> Age as of April 1st of the financial year.</li>
        <li>📌 <strong>RRB NTPC / Group D:</strong> Age as of July 1st.</li>
      </ul>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Demographic Generation Classification Table</h2>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-left border-collapse border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden text-sm">
        <thead class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-semibold">
          <tr>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Generation Name</th>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Birth Year Range</th>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">Current Approximate Age (2025)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Gen Alpha</td>
            <td class="p-3 text-indigo-600 font-medium">2013 – 2024</td>
            <td class="p-3">1 to 12 Years</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Gen Z (Zoomers)</td>
            <td class="p-3 text-indigo-600 font-medium">1997 – 2012</td>
            <td class="p-3">13 to 28 Years</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Millennials (Gen Y)</td>
            <td class="p-3 text-indigo-600 font-medium">1981 – 1996</td>
            <td class="p-3">29 to 44 Years</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Gen X</td>
            <td class="p-3 text-indigo-600 font-medium">1965 – 1980</td>
            <td class="p-3">45 to 60 Years</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Baby Boomers</td>
            <td class="p-3 text-indigo-600 font-medium">1946 – 1964</td>
            <td class="p-3">61 to 79 Years</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Frequently Asked Questions (FAQs)</h2>
    <div class="space-y-6">
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">How to calculate age as of a specific cut-off date for government exams?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          Select your Date of Birth in the first field, and set the 'Age at Date' field to the official cut-off date specified in the exam notification.
        </p>
      </div>
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Does the calculator account for leap years?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          Yes! The calculation engine accounts for leap years (366 days) and varying days in calendar months to give 100% mathematical precision.
        </p>
      </div>
    </div>
  </article>
</Layout>