---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { AgeCalculator } from '../react-pages/students';

const title = "Exact Age Calculator Online 2025 | Calculate Age for Govt Exams";
const description = "Calculate your exact age in years, months, days, hours, and minutes as of any cut-off date. Ideal for UPSC, SSC, IBPS, and Railway job application forms.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/age-calculator">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala Exact Age Calculator",
      "operatingSystem": "All",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.96",
        "ratingCount": "2410"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How to calculate age as of a specific cut-off date for government exams?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Select your Date of Birth in the first field, and set the 'Age at Date' field to the official cut-off date specified in the exam notification (e.g. 1st August 2025 for UPSC or 1st January 2025 for SSC)."
          }
        },
        {
          "@type": "Question",
          "name": "Does the calculator account for leap years?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! The calculation engine accounts for leap years (366 days with February 29th) and varying days in calendar months (28, 30, or 31 days) to give 100% mathematical precision."
          }
        },
        {
          "@type": "Question",
          "name": "What additional information does the age calculator show?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Along with age in years, months, and days, it displays total days lived, total hours, total minutes, zodiac sign, generation classification, and a countdown to your next birthday."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="Age Calculator" hindi="आयु कैलकुलेटर" client:load>
    <AgeCalculator client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article class="seo-article">

    <!-- Quick Answer Box -->
    <div style="background: rgba(99,102,241,0.08); border: 2px solid rgba(99,102,241,0.3); border-radius: 16px; padding: 24px; margin-bottom: 32px;">
      <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; color: #6366f1; margin-bottom: 8px; letter-spacing: 0.05em;">⚡ Quick Answer</div>
      <h2 style="font-size: 20px; font-weight: 800; color: var(--app-text); margin-bottom: 12px;">How to Calculate Your Exact Age?</h2>
      <p style="font-size: 15px; color: var(--app-text-secondary); line-height: 1.7; margin: 0;">
        <strong>Age = Current Date − Date of Birth</strong><br /><br />
        Example: Born on <strong>15 March 1998</strong>, age on <strong>1 August 2025</strong> = <strong style="color: #6366f1;">27 years, 4 months, 17 days</strong>. Use the calculator above to get your exact age for any cut-off date.
      </p>
    </div>

    <h2 style="font-size: clamp(22px, 3.5vw, 32px); font-weight: 800; color: var(--app-text); margin-bottom: 20px; letter-spacing: -0.02em;">
      Age Calculator for Government Exams — Cut-off Dates & Age Limits (2026)
    </h2>

    <!-- Govt Exam Age Limits Table -->
    <h3 style="font-size: 18px; font-weight: 800; color: var(--app-text); margin-bottom: 14px;">📋 Age Limits for Major Indian Government Exams (2026)</h3>
    <p style="font-size: 14px; color: var(--app-text-secondary); margin-bottom: 16px; line-height: 1.6;">These are the official minimum and maximum age limits as per 2024–2026 notifications. Always verify with the current official notification:</p>
    <div class="seo-table-wrapper" style="margin-bottom: 36px;">
      <table class="seo-table">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 13px 14px; font-weight: 800; color: var(--app-text);">Exam</th>
            <th style="padding: 13px 14px; font-weight: 800; color: var(--app-text);">Min Age</th>
            <th style="padding: 13px 14px; font-weight: 800; color: #f97316;">Max Age (General)</th>
            <th style="padding: 13px 14px; font-weight: 800; color: var(--app-text);">Age Cut-off Date</th>
            <th style="padding: 13px 14px; font-weight: 800; color: var(--app-text);">OBC Relaxation</th>
            <th style="padding: 13px 14px; font-weight: 800; color: var(--app-text);">SC/ST Relaxation</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 13px 14px; font-weight: 700; color: var(--app-text);">UPSC IAS/IPS/IFS</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">21 years</td>
            <td style="padding: 13px 14px; font-weight: 700; color: #f97316;">32 years</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">1 August of exam year</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">+3 years (max 35)</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">+5 years (max 37)</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);">
            <td style="padding: 13px 14px; font-weight: 700; color: var(--app-text);">SSC CGL</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">18 years</td>
            <td style="padding: 13px 14px; font-weight: 700; color: #f97316;">27–32 years (post-wise)</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">1 August of notification year</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">+3 years</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">+5 years</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 13px 14px; font-weight: 700; color: var(--app-text);">IBPS PO / SBI PO</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">20 years</td>
            <td style="padding: 13px 14px; font-weight: 700; color: #f97316;">30 years</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">Date specified in notification</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">+3 years</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">+5 years</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);">
            <td style="padding: 13px 14px; font-weight: 700; color: var(--app-text);">IBPS Clerk / SBI Clerk</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">20 years</td>
            <td style="padding: 13px 14px; font-weight: 700; color: #f97316;">28 years</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">1 April of exam year</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">+3 years</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">+5 years</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 13px 14px; font-weight: 700; color: var(--app-text);">RRB NTPC (Graduate)</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">18 years</td>
            <td style="padding: 13px 14px; font-weight: 700; color: #f97316;">33 years</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">1 January of notification year</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">+3 years</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">+5 years</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);">
            <td style="padding: 13px 14px; font-weight: 700; color: var(--app-text);">SSC CHSL (10+2)</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">18 years</td>
            <td style="padding: 13px 14px; font-weight: 700; color: #f97316;">27 years</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">1 August of notification year</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">+3 years</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">+5 years</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 13px 14px; font-weight: 700; color: var(--app-text);">NDA / NA</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">16.5 years</td>
            <td style="padding: 13px 14px; font-weight: 700; color: #f97316;">19.5 years</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">1 January (Paper 1) / 1 July (Paper 2)</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">No relaxation</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">No relaxation</td>
          </tr>
          <tr style="background: rgba(0,0,0,0.02);">
            <td style="padding: 13px 14px; font-weight: 700; color: var(--app-text);">CDS (Combined Defence)</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">19 years</td>
            <td style="padding: 13px 14px; font-weight: 700; color: #f97316;">24–25 years (service-wise)</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">1 January / 1 July (per notification)</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">No relaxation</td>
            <td style="padding: 13px 14px; color: var(--app-text-secondary);">No relaxation</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Age relaxation table -->
    <h3 style="font-size: 18px; font-weight: 800; color: var(--app-text); margin-bottom: 14px;">🧾 Age Relaxation Rules — UPSC & SSC (All Categories)</h3>
    <div class="seo-table-wrapper" style="margin-bottom: 36px;">
      <table class="seo-table">
        <thead style="background: rgba(99,102,241,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 12px 14px; font-weight: 800; color: var(--app-text);">Category</th>
            <th style="padding: 12px 14px; font-weight: 800; color: #6366f1;">UPSC Relaxation</th>
            <th style="padding: 12px 14px; font-weight: 800; color: #f97316;">SSC CGL Relaxation</th>
            <th style="padding: 12px 14px; font-weight: 800; color: var(--app-text);">Maximum Permissible Age</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 12px 14px; font-weight: 700;">General / UR</td><td style="padding: 12px 14px; color: var(--app-text-secondary);">0 years</td><td style="padding: 12px 14px; color: var(--app-text-secondary);">0 years</td><td style="padding: 12px 14px; font-weight: 600;">32 / 27 years</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);"><td style="padding: 12px 14px; font-weight: 700;">OBC (Non-Creamy Layer)</td><td style="padding: 12px 14px; color: #10b981; font-weight: 600;">+3 years</td><td style="padding: 12px 14px; color: #10b981; font-weight: 600;">+3 years</td><td style="padding: 12px 14px; font-weight: 600;">35 / 30 years</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 12px 14px; font-weight: 700;">SC / ST</td><td style="padding: 12px 14px; color: #6366f1; font-weight: 600;">+5 years</td><td style="padding: 12px 14px; color: #6366f1; font-weight: 600;">+5 years</td><td style="padding: 12px 14px; font-weight: 600;">37 / 32 years</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);"><td style="padding: 12px 14px; font-weight: 700;">PwD (General)</td><td style="padding: 12px 14px; color: #f97316; font-weight: 600;">+10 years</td><td style="padding: 12px 14px; color: #f97316; font-weight: 600;">+10 years</td><td style="padding: 12px 14px; font-weight: 600;">42 / 37 years</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 12px 14px; font-weight: 700;">PwD (OBC)</td><td style="padding: 12px 14px; color: #f97316; font-weight: 600;">+13 years</td><td style="padding: 12px 14px; color: #f97316; font-weight: 600;">+13 years</td><td style="padding: 12px 14px; font-weight: 600;">45 / 40 years</td></tr>
          <tr style="background: rgba(0,0,0,0.02);"><td style="padding: 12px 14px; font-weight: 700;">PwD (SC/ST)</td><td style="padding: 12px 14px; color: #f97316; font-weight: 600;">+15 years</td><td style="padding: 12px 14px; color: #f97316; font-weight: 600;">+15 years</td><td style="padding: 12px 14px; font-weight: 600;">47 / 42 years</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Generation Table -->
    <h3 style="font-size: 18px; font-weight: 800; color: var(--app-text); margin-bottom: 14px;">👥 Generation Classification by Birth Year (2026)</h3>
    <div class="seo-table-wrapper" style="margin-bottom: 36px;">
      <table class="seo-table">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 12px 14px; font-weight: 800; color: var(--app-text);">Generation</th>
            <th style="padding: 12px 14px; font-weight: 800; color: var(--app-text);">Birth Years</th>
            <th style="padding: 12px 14px; font-weight: 800; color: var(--app-text);">Age in 2026</th>
            <th style="padding: 12px 14px; font-weight: 800; color: var(--app-text);">Defining Event</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 12px 14px; font-weight: 700;">Gen Alpha</td><td style="padding: 12px 14px; color: #6366f1;">2013–2025</td><td style="padding: 12px 14px; color: var(--app-text-secondary);">0–13 years</td><td style="padding: 12px 14px; color: var(--app-text-secondary);">Born with AI & smart devices</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);"><td style="padding: 12px 14px; font-weight: 700;">Gen Z</td><td style="padding: 12px 14px; color: #6366f1;">1997–2012</td><td style="padding: 12px 14px; color: var(--app-text-secondary);">14–29 years</td><td style="padding: 12px 14px; color: var(--app-text-secondary);">First smartphone-native generation</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 12px 14px; font-weight: 700;">Millennials</td><td style="padding: 12px 14px; color: #6366f1;">1981–1996</td><td style="padding: 12px 14px; color: var(--app-text-secondary);">30–45 years</td><td style="padding: 12px 14px; color: var(--app-text-secondary);">Grew up with the internet boom</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);"><td style="padding: 12px 14px; font-weight: 700;">Gen X</td><td style="padding: 12px 14px; color: #6366f1;">1965–1980</td><td style="padding: 12px 14px; color: var(--app-text-secondary);">46–61 years</td><td style="padding: 12px 14px; color: var(--app-text-secondary);">Latchkey kids, MTV era</td></tr>
          <tr style="background: rgba(0,0,0,0.02);"><td style="padding: 12px 14px; font-weight: 700;">Baby Boomers</td><td style="padding: 12px 14px; color: #6366f1;">1946–1964</td><td style="padding: 12px 14px; color: var(--app-text-secondary);">62–80 years</td><td style="padding: 12px 14px; color: var(--app-text-secondary);">Post-WWII economic boom</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Western Zodiac Reference -->
    <h3 style="font-size: 18px; font-weight: 800; color: var(--app-text); margin-bottom: 14px;">♈ Western Zodiac Sign by Birth Date</h3>
    <div class="seo-table-wrapper" style="margin-bottom: 36px;">
      <table class="seo-table">
        <thead style="background: rgba(99,102,241,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 11px 13px; font-weight: 800; color: var(--app-text);">Zodiac Sign</th>
            <th style="padding: 11px 13px; font-weight: 800; color: var(--app-text);">Date Range</th>
            <th style="padding: 11px 13px; font-weight: 800; color: var(--app-text);">Element</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 11px 13px; font-weight: 700;">♈ Aries</td><td style="padding: 11px 13px; color: var(--app-text-secondary);">21 Mar – 19 Apr</td><td style="padding: 11px 13px; color: #f97316;">Fire</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);"><td style="padding: 11px 13px; font-weight: 700;">♉ Taurus</td><td style="padding: 11px 13px; color: var(--app-text-secondary);">20 Apr – 20 May</td><td style="padding: 11px 13px; color: #10b981;">Earth</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 11px 13px; font-weight: 700;">♊ Gemini</td><td style="padding: 11px 13px; color: var(--app-text-secondary);">21 May – 20 Jun</td><td style="padding: 11px 13px; color: #6366f1;">Air</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);"><td style="padding: 11px 13px; font-weight: 700;">♋ Cancer</td><td style="padding: 11px 13px; color: var(--app-text-secondary);">21 Jun – 22 Jul</td><td style="padding: 11px 13px; color: #3b82f6;">Water</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 11px 13px; font-weight: 700;">♌ Leo</td><td style="padding: 11px 13px; color: var(--app-text-secondary);">23 Jul – 22 Aug</td><td style="padding: 11px 13px; color: #f97316;">Fire</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);"><td style="padding: 11px 13px; font-weight: 700;">♍ Virgo</td><td style="padding: 11px 13px; color: var(--app-text-secondary);">23 Aug – 22 Sep</td><td style="padding: 11px 13px; color: #10b981;">Earth</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 11px 13px; font-weight: 700;">♎ Libra</td><td style="padding: 11px 13px; color: var(--app-text-secondary);">23 Sep – 22 Oct</td><td style="padding: 11px 13px; color: #6366f1;">Air</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);"><td style="padding: 11px 13px; font-weight: 700;">♏ Scorpio</td><td style="padding: 11px 13px; color: var(--app-text-secondary);">23 Oct – 21 Nov</td><td style="padding: 11px 13px; color: #3b82f6;">Water</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 11px 13px; font-weight: 700;">♐ Sagittarius</td><td style="padding: 11px 13px; color: var(--app-text-secondary);">22 Nov – 21 Dec</td><td style="padding: 11px 13px; color: #f97316;">Fire</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border); background: rgba(0,0,0,0.02);"><td style="padding: 11px 13px; font-weight: 700;">♑ Capricorn</td><td style="padding: 11px 13px; color: var(--app-text-secondary);">22 Dec – 19 Jan</td><td style="padding: 11px 13px; color: #10b981;">Earth</td></tr>
          <tr style="border-bottom: 1px solid var(--app-border);"><td style="padding: 11px 13px; font-weight: 700;">♒ Aquarius</td><td style="padding: 11px 13px; color: var(--app-text-secondary);">20 Jan – 18 Feb</td><td style="padding: 11px 13px; color: #6366f1;">Air</td></tr>
          <tr><td style="padding: 11px 13px; font-weight: 700;">♓ Pisces</td><td style="padding: 11px 13px; color: var(--app-text-secondary);">19 Feb – 20 Mar</td><td style="padding: 11px 13px; color: #3b82f6;">Water</td></tr>
        </tbody>
      </table>
    </div>

    <!-- FAQs -->
    <h3 style="font-size: 20px; font-weight: 800; color: var(--app-text); margin-bottom: 20px;">❓ Frequently Asked Questions</h3>
    <div style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 32px;">
      <div style="background: var(--app-surface-card); padding: 20px 24px; border-radius: 14px; border: 1px solid var(--app-border);">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">How to calculate my age as of a specific government exam cut-off date?</h4>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">Enter your date of birth in the first field, then change the "Age at date" field to the official cut-off date mentioned in the exam notification (e.g., 01 August 2026 for UPSC CSE 2026). The calculator will show your exact age on that date.</p>
      </div>
      <div style="background: var(--app-surface-card); padding: 20px 24px; border-radius: 14px; border: 1px solid var(--app-border);">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">What is the maximum age limit for UPSC 2026 for OBC candidates?</h4>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">General category maximum is 32 years. OBC (Non-Creamy Layer) candidates get a 3-year relaxation, making the maximum 35 years. SC/ST candidates get 5-year relaxation (max 37 years). PwD General candidates get 10-year relaxation (max 42 years).</p>
      </div>
      <div style="background: var(--app-surface-card); padding: 20px 24px; border-radius: 14px; border: 1px solid var(--app-border);">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">How many years, months, days have I lived if I was born on 1 January 2000?</h4>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">If born on 1 January 2000, as of 1 August 2026, you would be exactly 26 years, 7 months, and 0 days old. Use the calculator above for any specific birthday and reference date.</p>
      </div>
      <div style="background: var(--app-surface-card); padding: 20px 24px; border-radius: 14px; border: 1px solid var(--app-border);">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Does the age calculator account for leap years?</h4>
        <p style="font-size: 14px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">Yes. The calculator accurately handles leap years (February 29 birthdays) and different month lengths (28, 29, 30, 31 days). If your birthday is February 29, your age is typically counted on either February 28 or March 1 in non-leap years, depending on the exam body's rules.</p>
      </div>
      <div style="background: var(--app-surface-card); padding: 20px 24px; border-radius: 14px; border: 1px solid var(--app-border);">
