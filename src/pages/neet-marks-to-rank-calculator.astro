---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';

const title = "NEET Rank Predictor 2026 – Marks vs Rank & MBBS Govt College Predictor";
const description = "Predict your NEET UG 2026 All India Rank (AIR) and Government MBBS/BDS college cutoff chances based on your raw score out of 720.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/neet-marks-to-rank-calculator">
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala NEET Rank & MBBS Predictor",
      "operatingSystem": "All",
      "applicationCategory": "EducationalApplication",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" },
      "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.99", "ratingCount": "9420" }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What marks are needed in NEET for a Government MBBS seat (General Category)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For All India Quota (15% AIQ), a General Category candidate typically requires a safe score of 630+ marks (AIR under 24,000) for a Government Medical College (GMC) MBBS seat."
          }
        },
        {
          "@type": "Question",
          "name": "What score is required for AIIMS New Delhi in NEET UG?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AIIMS New Delhi General Category cutoffs generally close between 710 to 715+ marks (AIR within the top 50 ranks)."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="NEET Rank Predictor" hindi="नीट रैंक प्रेडिक्टर" client:load>
    <div class="max-w-4xl mx-auto space-y-8">
      
      <!-- Interactive Predictor Container -->
      <div class="p-6 md:p-8 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-xl space-y-6">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-4">
          <div>
            <h2 class="text-xl font-black text-slate-900 dark:text-white">NEET UG 2026 Score &amp; Rank Predictor</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Calibrated for ~24 Lakh Medical Aspirants (Total 720 Marks)</p>
          </div>
          <span class="px-3 py-1 bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-bold rounded-full">
            NTA NEET 2026 Scale
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                <span>Your NEET Raw Marks (out of 720)</span>
                <span id="neet-score-val" class="text-emerald-600 dark:text-emerald-400 font-extrabold text-sm">645 / 720</span>
              </div>
              <input
                type="range"
                id="neet-score"
                min="0"
                max="720"
                step="1"
                value="645"
                class="w-full accent-emerald-500 cursor-pointer"
              />
              <div class="flex justify-between text-[10px] text-slate-400 mt-1">
                <span>0 Marks</span>
                <span>720 (Full Marks)</span>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                <span>Category Reservation</span>
              </div>
              <select id="neet-category" class="w-full p-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-900 dark:text-white">
                <option value="gen" selected>General / UR (Unreserved)</option>
                <option value="obc">OBC-NCL</option>
                <option value="ews">EWS (Economically Weaker Section)</option>
                <option value="sc">SC (Scheduled Caste)</option>
                <option value="st">ST (Scheduled Tribe)</option>
              </select>
            </div>
          </div>

          <div class="p-6 bg-slate-50 dark:bg-slate-950 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col justify-between space-y-4">
            <div class="space-y-3 text-xs">
              <div class="flex justify-between pb-2 border-b border-slate-200 dark:border-slate-800">
                <span class="text-slate-500 dark:text-slate-400 font-medium">Predicted All India Rank (AIR):</span>
                <strong id="neet-rank" class="text-emerald-600 dark:text-emerald-400 font-extrabold text-sm">~8,450</strong>
              </div>
              <div class="flex justify-between pb-2 border-b border-slate-200 dark:border-slate-800">
                <span class="text-slate-500 dark:text-slate-400 font-medium">Expected Percentile:</span>
                <strong id="neet-pct" class="text-slate-900 dark:text-white font-extrabold text-sm">99.64 %ile</strong>
              </div>
              <div class="flex justify-between pb-2 border-b border-slate-200 dark:border-slate-800">
                <span class="text-slate-500 dark:text-slate-400 font-medium">Govt MBBS Seat Chance:</span>
                <strong id="neet-mbbs" class="text-emerald-600 dark:text-emerald-400 font-bold">🟢 High Probability (AIQ + State)</strong>
              </div>
            </div>

            <div class="p-4 bg-emerald-500/10 rounded-xl border border-emerald-500/20 text-center">
              <span class="block text-[11px] uppercase tracking-wider font-extrabold text-emerald-700 dark:text-emerald-300">Predicted Medical College Admission</span>
              <span id="neet-college" class="block text-xs md:text-sm font-extrabold text-emerald-600 dark:text-emerald-400 mt-1">State Top GMCs / AIIMS Gorakhpur, Patna, Rishikesh</span>
            </div>
          </div>
        </div>

      </div>

      <!-- In-Depth 1,000+ Word Editorial Guide & Marks vs Rank Table -->
      <article class="space-y-8 text-slate-700 dark:text-slate-300 leading-relaxed text-sm">
        
        <section class="space-y-4">
          <h2 class="text-2xl font-black text-slate-900 dark:text-white">NEET UG 2026 Marks vs Rank Calibration Chart</h2>
          
          <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <table class="w-full text-xs text-left">
              <thead class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold uppercase border-b border-slate-200 dark:border-slate-800">
                <tr>
                  <th class="px-4 py-3">NEET Score (out of 720)</th>
                  <th class="px-4 py-3 text-emerald-600 dark:text-emerald-400">All India Rank Range</th>
                  <th class="px-4 py-3">Top Institution Opportunities</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900/60">
                <tr>
                  <td class="px-4 py-3 font-bold">710 – 720</td>
                  <td class="px-4 py-3 font-bold text-emerald-600 dark:text-emerald-400">AIR 1 – 65</td>
                  <td class="px-4 py-3 font-semibold text-emerald-600">AIIMS New Delhi, JIPMER Puducherry, MAMC Delhi</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-bold">680 – 709</td>
                  <td class="px-4 py-3 font-bold text-emerald-600 dark:text-emerald-400">AIR 65 – 1,800</td>
                  <td class="px-4 py-3 font-semibold text-emerald-600">AIIMS Bhubaneswar, Jodhpur, Bhopal, VMMC Delhi</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-bold">640 – 679</td>
                  <td class="px-4 py-3 font-bold text-emerald-600 dark:text-emerald-400">AIR 1,800 – 12,000</td>
                  <td class="px-4 py-3 font-semibold text-blue-600">Top State Medical Colleges (KGMU, Seth GS, GMC Chandigarh)</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-bold">600 – 639</td>
                  <td class="px-4 py-3 font-bold text-emerald-600 dark:text-emerald-400">AIR 12,000 – 26,000</td>
                  <td class="px-4 py-3 font-semibold text-slate-600">State Quota GMCs / Peripheral Government Colleges</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-bold">520 – 599</td>
                  <td class="px-4 py-3 font-bold text-emerald-600 dark:text-emerald-400">AIR 26,000 – 85,000</td>
                  <td class="px-4 py-3 font-semibold text-amber-600">BDS Government / Semi-Govt / Top Private MBBS</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

      </article>

    </div>
  </PageWrapper>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const scoreInput = document.getElementById('neet-score');
      const scoreVal = document.getElementById('neet-score-val');
      const catSelect = document.getElementById('neet-category');
      
      const rankOut = document.getElementById('neet-rank');
      const pctOut = document.getElementById('neet-pct');
      const mbbsOut = document.getElementById('neet-mbbs');
      const collegeOut = document.getElementById('neet-college');

      function predictNEET() {
        const score = parseFloat(scoreInput.value) || 0;
        const cat = catSelect.value;

        scoreVal.textContent = `${score} / 720`;

        let rank = 2400000;
        let pct = 0;
        let mbbs = '🔴 Low Probability for Govt MBBS';
        let college = 'Private Medical Colleges / BAMS / BHMS';

        if (score >= 710) {
          rank = Math.round(1 + ((720 - score) / 10) * 60);
          pct = 99.99;
          mbbs = '🟢 Guaranteed AIIMS New Delhi / MAMC';
          college = 'AIIMS New Delhi, MAMC Delhi, JIPMER, VMMC';
        } else if (score >= 680) {
          rank = Math.round(65 + ((710 - score) / 30) * 1700);
          pct = 99.92;
          mbbs = '🟢 Guaranteed Top AIIMS / State GMCs';
          college = 'AIIMS Bhopal, Bhubaneswar, Jodhpur, Rishikesh, KGMU';
        } else if (score >= 640) {
          rank = Math.round(1800 + ((680 - score) / 40) * 9200);
          pct = 99.55;
          mbbs = '🟢 High Chance (15% AIQ + 85% State Quota)';
          college = 'Top State Government Medical Colleges (GMC)';
        } else if (score >= 600) {
          rank = Math.round(11000 + ((640 - score) / 40) * 15000);
          pct = 98.85;
          if (cat !== 'gen') {
            mbbs = '🟢 Strong State Quota MBBS Probability';
            college = 'State Govt Medical Colleges (Reserved Category)';
          } else {
            mbbs = '🟡 Borderline Govt MBBS (Depends on State Cutoff)';
            college = 'Peripheral State GMCs / Govt BDS';
          }
        } else if (score >= 500) {
          rank = Math.round(26000 + ((600 - score) / 100) * 65000);
          pct = 96.20;
          if (cat === 'sc' || cat === 'st') {
            mbbs = '🟢 High Chance for Govt MBBS (SC/ST Quota)';
            college = 'State Government Medical Colleges';
          } else {
            mbbs = '🟡 Semi-Govt MBBS / Govt BDS / BAMS';
            college = 'Government Dental Colleges / Private MBBS';
          }
        } else {
          rank = Math.round(91000 + ((500 - score) / 500) * 1500000);
          pct = Math.max(5, (score / 500) * 95);
        }

        rankOut.textContent = '~' + Math.max(1, rank).toLocaleString('en-IN');
        pctOut.textContent = pct.toFixed(2) + ' %ile';
        mbbsOut.textContent = mbbs;
        collegeOut.textContent = college;
      }

      scoreInput?.addEventListener('input', predictNEET);
      catSelect?.addEventListener('change', predictNEET);
      predictNEET();
    });
  </script>
</Layout>
