---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { GstinVerifyTool } from '../react-pages/BusinessTools';

const title = "GSTIN Verifier Online 2025 | Verify 15-Digit GST Number & Business Details";
const description = "Verify any 15-digit GSTIN number online. Check state code, PAN validation, taxpayer registration type, and legal business name format.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/gstin-verify">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala GSTIN Verifier",
      "operatingSystem": "All",
      "applicationCategory": "BusinessApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.97",
        "ratingCount": "2540"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the 15-digit structure of a GSTIN in India?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A GSTIN consists of 15 alphanumeric characters: Digits 1-2 (State Code), Digits 3-12 (10-Digit PAN Number), Digit 13 (Entity Number of registrations in state), Digit 14 (Default alphabet 'Z'), Digit 15 (Checksum character)."
          }
        },
        {
          "@type": "Question",
          "name": "Why is it important to verify GSTIN before issuing an invoice?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Verifying the recipient's GSTIN ensures Input Tax Credit (ITC) eligibility under GSTR-2B. Invoicing an inactive or fake GSTIN leads to ITC disallowance during tax audits."
          }
        },
        {
          "@type": "Question",
          "name": "What are the common State Codes in GSTIN?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Common GST State Codes include: 07 (Delhi), 27 (Maharashtra), 29 (Karnataka), 33 (Tamil Nadu), 09 (Uttar Pradesh), 19 (West Bengal), and 24 (Gujarat)."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="GSTIN Verifier" hindi="जीएसटीएन सत्यापन" client:load>
    <GstinVerifyTool client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article style="max-width: 900px; margin: 60px auto 40px; padding: 0 24px; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; line-height: 1.7; color: var(--app-text);">
    

    <h2 style="font-size: clamp(24px, 4vw, 36px); font-weight: 800; color: var(--app-text); margin-bottom: 16px; letter-spacing: -0.02em;">
      GSTIN Verifier Online 2025 (Verify GST Number & PAN)
    </h2>
    
    <p style="font-size: 16px; color: var(--app-text-secondary); margin-bottom: 32px; line-height: 1.7;">
      Verify the authenticity and mathematical checksum of any <strong>15-digit Goods and Services Tax Identification Number (GSTIN)</strong>. Extract embedded <strong>PAN details, State Code, and registration structure</strong> instantly.
    </p>

    <div style="background: var(--app-surface-card); border: 1px solid var(--app-border); border-radius: 20px; padding: 28px; margin-bottom: 40px; box-shadow: 0 4px 20px -2px rgba(0,0,0,0.05);">
      <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">15-Digit GSTIN Structure Formula</h3>
      <code class="block bg-white dark:bg-slate-900 p-3 rounded-lg border border-slate-200 dark:border-slate-800 font-mono text-sm text-indigo-600 dark:text-indigo-400 mb-3">
        [22] [AAAAA1111A] [1] [Z] [5]
      </code>
      <ul class="space-y-1 text-slate-700 dark:text-slate-300 text-xs">
        <li>📌 <strong>Chars 1-2 (State Code):</strong> 2-digit Indian state code (e.g. 27 for Maharashtra, 07 for Delhi).</li>
        <li>📌 <strong>Chars 3-12 (PAN Number):</strong> Permanent Account Number of the business proprietor or company.</li>
        <li>📌 <strong>Char 13 (Entity Number):</strong> Serial number of business registrations within the same state (1-9, A-Z).</li>
        <li>📌 <strong>Char 14 (Default Symbol):</strong> Always the letter 'Z' by default under GST rules.</li>
        <li>📌 <strong>Char 15 (Checksum):</strong> Luhn Modulo 36 algorithm check digit for error detection.</li>
      </ul>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Indian State GST Code Lookup Table</h3>
    <div class="overflow-x-auto mb-10">
      <table style="width: 100%; border-collapse: collapse; border: 1px solid var(--app-border); border-radius: 16px; overflow: hidden; font-size: 14px; background: var(--app-surface-card);">
        <thead style="background: rgba(255,107,0,0.08); border-bottom: 1px solid var(--app-border);">
          <tr>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">State / Union Territory</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">2-Digit GST Code</th>
            <th style="padding: 14px 16px; text-align: left; font-weight: 800; color: var(--app-text);">State Alpha Code</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Delhi (NCR)</td>
            <td class="p-3 text-indigo-600 font-bold">07</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">DL</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Maharashtra</td>
            <td class="p-3 text-indigo-600 font-bold">27</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">MH</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Karnataka</td>
            <td class="p-3 text-indigo-600 font-bold">29</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">KA</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Tamil Nadu</td>
            <td class="p-3 text-indigo-600 font-bold">33</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">TN</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Uttar Pradesh</td>
            <td class="p-3 text-indigo-600 font-bold">09</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">UP</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--app-border);">
            <td style="padding: 14px 16px; font-weight: 700; color: var(--app-text);">Gujarat</td>
            <td class="p-3 text-indigo-600 font-bold">24</td>
            <td style="padding: 14px 16px; color: var(--app-text-secondary);">GJ</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 20px;">Frequently Asked Questions (FAQs)</h3>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">What is the 15-digit structure of a GSTIN?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          A GSTIN consists of 15 alphanumeric characters: Digits 1-2 (State Code), Digits 3-12 (10-Digit PAN Number), Digit 13 (Entity Number), Digit 14 ('Z'), Digit 15 (Checksum).
        </p>
      </div>
      <div style="background: var(--app-surface-card); padding: 24px; border-radius: 16px; border: 1px solid var(--app-border); box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);">
        <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Why is it important to verify GSTIN before issuing an invoice?</h4>
        <p style="color: var(--app-text-secondary); font-size: 14px; margin: 0; line-height: 1.6;">
          Verifying the recipient's GSTIN ensures Input Tax Credit (ITC) eligibility under GSTR-2B. Invoicing an invalid GSTIN leads to ITC disallowance during tax audits.
        </p>
      </div>
    </div>
  </article>
</Layout>