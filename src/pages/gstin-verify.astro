---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { GstinVerifyTool } from '../react-pages/BusinessTools';

const title = "GSTIN Verifier Online 2025 | Verify 15-Digit GST Number & Business Details";
const description = "Verify any 15-digit GSTIN number online. Check state code, PAN validation, taxpayer registration type, and legal business name format.";
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/gstin-verify">
  <!-- SoftwareApplication & FAQ Structured Data -->
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ToolsWaala GSTIN Verifier",
      "operatingSystem": "All",
      "applicationCategory": "BusinessApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.97",
        "ratingCount": "2540"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the 15-digit structure of a GSTIN in India?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A GSTIN consists of 15 alphanumeric characters: Digits 1-2 (State Code), Digits 3-12 (10-Digit PAN Number), Digit 13 (Entity Number of registrations in state), Digit 14 (Default alphabet 'Z'), Digit 15 (Checksum character)."
          }
        },
        {
          "@type": "Question",
          "name": "Why is it important to verify GSTIN before issuing an invoice?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Verifying the recipient's GSTIN ensures Input Tax Credit (ITC) eligibility under GSTR-2B. Invoicing an inactive or fake GSTIN leads to ITC disallowance during tax audits."
          }
        },
        {
          "@type": "Question",
          "name": "What are the common State Codes in GSTIN?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Common GST State Codes include: 07 (Delhi), 27 (Maharashtra), 29 (Karnataka), 33 (Tamil Nadu), 09 (Uttar Pradesh), 19 (West Bengal), and 24 (Gujarat)."
          }
        }
      ]
    }
  ]
  </script>

  <PageWrapper title="GSTIN Verifier" hindi="जीएसटीएन सत्यापन" client:load>
    <GstinVerifyTool client:only="react" />
  </PageWrapper>

  <!-- Comprehensive SEO Content Block -->
  <article class="max-w-4xl mx-auto px-4 py-8 text-slate-800 dark:text-slate-200 leading-relaxed font-sans">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:underline">Home</a> &gt; <a href="/legal-hub" class="hover:underline">Business Tools</a> &gt; <span class="font-medium text-slate-700 dark:text-slate-300">GSTIN Verifier</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
      GSTIN Verifier Online 2025 (Verify GST Number & PAN)
    </h1>
    
    <p class="text-lg text-slate-600 dark:text-slate-300 mb-8">
      Verify the authenticity and mathematical checksum of any <strong>15-digit Goods and Services Tax Identification Number (GSTIN)</strong>. Extract embedded <strong>PAN details, State Code, and registration structure</strong> instantly.
    </p>

    <div class="bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 rounded-xl p-6 mb-8">
      <h2 class="text-xl font-bold text-indigo-950 dark:text-indigo-200 mb-3">15-Digit GSTIN Structure Formula</h2>
      <code class="block bg-white dark:bg-slate-900 p-3 rounded-lg border border-slate-200 dark:border-slate-800 font-mono text-sm text-indigo-600 dark:text-indigo-400 mb-3">
        [22] [AAAAA1111A] [1] [Z] [5]
      </code>
      <ul class="space-y-1 text-slate-700 dark:text-slate-300 text-xs">
        <li>📌 <strong>Chars 1-2 (State Code):</strong> 2-digit Indian state code (e.g. 27 for Maharashtra, 07 for Delhi).</li>
        <li>📌 <strong>Chars 3-12 (PAN Number):</strong> Permanent Account Number of the business proprietor or company.</li>
        <li>📌 <strong>Char 13 (Entity Number):</strong> Serial number of business registrations within the same state (1-9, A-Z).</li>
        <li>📌 <strong>Char 14 (Default Symbol):</strong> Always the letter 'Z' by default under GST rules.</li>
        <li>📌 <strong>Char 15 (Checksum):</strong> Luhn Modulo 36 algorithm check digit for error detection.</li>
      </ul>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Indian State GST Code Lookup Table</h2>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-left border-collapse border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden text-sm">
        <thead class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-semibold">
          <tr>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">State / Union Territory</th>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">2-Digit GST Code</th>
            <th class="p-3 border-b border-slate-200 dark:border-slate-700">State Alpha Code</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Delhi (NCR)</td>
            <td class="p-3 text-indigo-600 font-bold">07</td>
            <td class="p-3">DL</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Maharashtra</td>
            <td class="p-3 text-indigo-600 font-bold">27</td>
            <td class="p-3">MH</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Karnataka</td>
            <td class="p-3 text-indigo-600 font-bold">29</td>
            <td class="p-3">KA</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Tamil Nadu</td>
            <td class="p-3 text-indigo-600 font-bold">33</td>
            <td class="p-3">TN</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Uttar Pradesh</td>
            <td class="p-3 text-indigo-600 font-bold">09</td>
            <td class="p-3">UP</td>
          </tr>
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-3 font-semibold">Gujarat</td>
            <td class="p-3 text-indigo-600 font-bold">24</td>
            <td class="p-3">GJ</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-4">Frequently Asked Questions (FAQs)</h2>
    <div class="space-y-6">
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">What is the 15-digit structure of a GSTIN?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          A GSTIN consists of 15 alphanumeric characters: Digits 1-2 (State Code), Digits 3-12 (10-Digit PAN Number), Digit 13 (Entity Number), Digit 14 ('Z'), Digit 15 (Checksum).
        </p>
      </div>
      <div class="bg-white dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Why is it important to verify GSTIN before issuing an invoice?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm">
          Verifying the recipient's GSTIN ensures Input Tax Credit (ITC) eligibility under GSTR-2B. Invoicing an invalid GSTIN leads to ITC disallowance during tax audits.
        </p>
      </div>
    </div>
  </article>
</Layout>