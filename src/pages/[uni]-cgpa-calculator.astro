---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { CgpaCalculator, PercentageCalc } from '../react-pages/students';
import universities from '../data/universities.json';

export async function getStaticPaths() {
  return universities.map((uni) => ({
    params: { uni: uni.id },
    props: { uni },
  }));
}

const { uni } = Astro.props;

const isBoard = uni.id.includes('board') || uni.id.includes('sslc') || uni.id.includes('puc') || uni.id.includes('result') || uni.id === 'rbse';

const title = isBoard
  ? `${uni.name} Percentage Calculator (2026) | Marks to %, 10th/12th Division & Grade`
  : `${uni.name} CGPA to Percentage Calculator (2026) | Official Formula & Conversion`;

const description = isBoard
  ? `Convert ${uni.name} marks to percentage instantly. Calculate 1st division, distinction cutoff marks (85%+), subject aggregates, and official grading ordinance for 2025-26.`
  : `Convert ${uni.name} CGPA to percentage & SGPA to CGPA instantly. Official ${uni.name} grading formula, semester-wise credit weightage, and placement cutoff guide for 2025-26.`;

const faqSchemaStr = `<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the official formula for ${uni.name} ${isBoard ? 'percentage' : 'CGPA to percentage'}?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "${uni.faq1}"
      }
    },
    {
      "@type": "Question",
      "name": "What ${isBoard ? 'percentage' : 'CGPA'} is considered First Class / Division in ${uni.name}?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "${uni.faq2}"
      }
    },
    {
      "@type": "Question",
      "name": "${isBoard ? 'How to calculate 10th and 12th board percentage?' : 'How to convert SGPA to overall CGPA?'}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "${isBoard ? 'Divide total scored marks across all main subjects by total maximum marks and multiply by 100.' : 'Multiply each semester SGPA by total credits earned in that semester, sum them up, and divide by total cumulative credits.'}"
      }
    }
  ]
}
</script>\n`;

const ratingSchemaStr = `<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "${title}",
  "operatingSystem": "All",
  "applicationCategory": "EducationalApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.96",
    "ratingCount": "1650",
    "bestRating": "5",
    "worstRating": "1"
  }
}
</script>\n`;

const bcSchema = `<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.toolswaala.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "${isBoard ? 'Marks Percentage Calculator' : 'CGPA Calculator'}",
      "item": "https://www.toolswaala.in/${isBoard ? 'percentage-calculator' : 'cgpa-calculator'}"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "${title}",
      "item": "https://www.toolswaala.in/${uni.id}-cgpa-calculator"
    }
  ]
}
</script>\n`;
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath={`/${uni.id}-cgpa-calculator`}>
  <Fragment set:html={faqSchemaStr} />
  <Fragment set:html={bcSchema} />
  <Fragment set:html={ratingSchemaStr} />
  
  {isBoard ? (
    <PageWrapper title={`${uni.name} Percentage Calculator`} hindi="मार्क्स प्रतिशत कैलकुलेटर" client:load>
      <PercentageCalc client:only="react" />
    </PageWrapper>
  ) : (
    <PageWrapper title={`${uni.name} CGPA Calculator`} hindi="सीजीपीए कैलकुलेटर" client:load>
      <CgpaCalculator client:only="react" initialUniIdx={uni.idx} />
    </PageWrapper>
  )}

  <!-- Comprehensive High-Depth SEO Content Block -->
  <article class="seo-article">
    <div style="margin-bottom: 32px;">
      <span class="seo-badge">
        {isBoard ? '🏫' : '🎓'} Official ${uni.name} ${isBoard ? 'Board Standard' : 'Academic Formula'}
      </span>
      <h2 style="font-size: clamp(24px, 4vw, 36px); font-weight: 800; color: var(--app-text); margin-bottom: 12px; letter-spacing: -0.02em;">
        ${uni.name} ${isBoard ? 'Marks to Percentage & Division Calculator (2026)' : 'CGPA to Percentage & SGPA to CGPA Guide (2026)'}
      </h2>
      <p style="font-size: 16px; color: var(--app-text-secondary); line-height: 1.7;">
        ${uni.desc} ${isBoard ? 'Calculate your High School (10th) and Intermediate (12th) percentage marks, total aggregate score, subject-wise passing status, and First Division cutoff.' : 'Use this free calculator to convert your semester grade point averages (SGPA) and cumulative aggregate (CGPA) into certified percentage marks for job applications, GATE, CAT, and higher studies abroad.'}
      </p>
    </div>

    <!-- Official Formula Highlight Card -->
    <div class="seo-card">
      <h3 style="font-size: 18px; font-weight: 800; color: var(--app-text); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
        <span style="color: #FF6B00;">🧮</span> Official ${uni.name} Formula Breakdown
      </h3>
      <div style="background: rgba(255,107,0,0.06); padding: 18px; border-radius: 14px; border: 1px solid var(--app-border); font-family: monospace; font-size: 15px; font-weight: 700; color: #D45800; margin-bottom: 16px;">
        ${uni.faq1}
      </div>
      <p style="font-size: 14px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">
        This mathematical conversion rule is mandated by official examination ordinances issued by <strong>${uni.name}</strong> to align student transcripts with national standards.
      </p>
    </div>

    <!-- 10-Point Grade Scale Table -->
    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 36px; margin-bottom: 16px;">
      ${uni.name} 10-Point Grading Scale Reference
    </h3>
    <div class="seo-table-wrapper">
      <table class="seo-table">
        <thead>
          <tr>
            <th>CGPA Range</th>
            <th>Letter Grade</th>
            <th>Performance Level</th>
            <th>Class Division Standard</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td style="font-weight: 700; color: var(--app-text);">9.00 - 10.00</td>
            <td style="color: #10B981; font-weight: 800;">O (Outstanding)</td>
            <td>Top 5% Cohort Performance</td>
            <td style="color: #10B981; font-weight: 700;">First Class with Distinction</td>
          </tr>
          <tr>
            <td style="font-weight: 700; color: var(--app-text);">8.00 - 8.99</td>
            <td style="color: #10B981; font-weight: 800;">A+ (Excellent)</td>
            <td>Superior Academic Standing</td>
            <td style="color: #10B981; font-weight: 700;">First Class with Distinction</td>
          </tr>
          <tr>
            <td style="font-weight: 700; color: var(--app-text);">7.00 - 7.99</td>
            <td style="color: #7C3AED; font-weight: 800;">A (Very Good)</td>
            <td>Above Average Mastery</td>
            <td style="color: #7C3AED; font-weight: 700;">First Class</td>
          </tr>
          <tr>
            <td style="font-weight: 700; color: var(--app-text);">6.00 - 6.99</td>
            <td style="color: #7C3AED; font-weight: 800;">B+ (Good)</td>
            <td>Satisfactory Competency</td>
            <td style="color: #7C3AED; font-weight: 700;">First Class (Placement Benchmark)</td>
          </tr>
          <tr>
            <td style="font-weight: 700; color: var(--app-text);">5.50 - 5.99</td>
            <td style="color: #F59E0B; font-weight: 800;">B (Above Average)</td>
            <td>Pass Standard</td>
            <td>Second Class</td>
          </tr>
          <tr>
            <td style="font-weight: 700; color: var(--app-text);">Below 5.00</td>
            <td style="color: #EF4444; font-weight: 800;">F (Fail / Re-appear)</td>
            <td>Backlog Status</td>
            <td style="color: #EF4444;">Course Backlog</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Placement & Higher Studies Cutoffs -->
    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 36px; margin-bottom: 16px;">
      Placement & Exam Eligibility Cutoffs for ${uni.name} Students
    </h3>
    <div style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 36px;">
      <div class="seo-card" style="margin-bottom: 0;">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 6px;">💼 IT Mass Recruiters (TCS, Infosys, Wipro, Accenture)</h4>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">
          Requires a minimum aggregate of <strong>60% or 6.5+ CGPA</strong> with maximum 1 active backlog at the time of campus drives.
        </p>
      </div>
      <div class="seo-card" style="margin-bottom: 0;">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 6px;">🏛️ Government & PSU Exams (GATE, ISRO, BARC, Coal India)</h4>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">
          Mandates First Class degree certification (minimum 60% aggregate or equivalent CGPA as certified by university registrar).
        </p>
      </div>
      <div class="seo-card" style="margin-bottom: 0;">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 6px;">✈️ Foreign Higher Studies (MS in US, UK, Germany, Canada)</h4>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">
          Target a minimum <strong>3.0 / 4.0 GPA equivalent (7.5+ CGPA)</strong> for top-tier university admissions and teaching assistantship grants.
        </p>
      </div>
    </div>

    <!-- All University Quick Switcher Grid -->
    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 40px; margin-bottom: 16px;">
      Other Indian University CGPA Converters
    </h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; margin-bottom: 40px;">
      {universities.map(u => (
        <a href={`/${u.id}-cgpa-calculator`} style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: var(--app-surface-card); border-radius: 12px; border: 1px solid var(--app-border); text-decoration: none; font-size: 13px; font-weight: 700; color: var(--app-text); transition: border-color 0.2s;">
          <span>{u.name}</span>
          <span style="color: #7C3AED; font-size: 11px;">View &rarr;</span>
        </a>
      ))}
    </div>

    <!-- FAQ Cards -->
    <h3 style="font-size: 22px; font-weight: 800; color: var(--app-text); margin-top: 36px; margin-bottom: 16px;">
      Frequently Asked Questions (FAQs)
    </h3>
    <div class="seo-faq-grid">
      <div class="seo-faq-card">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">
          What is the official formula for ${uni.name} CGPA to percentage?
        </h4>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">
          ${uni.faq1}
        </p>
      </div>
      <div class="seo-faq-card">
        <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">
          What is considered First Class in ${uni.name}?
        </h4>
        <p style="font-size: 13px; color: var(--app-text-secondary); margin: 0; line-height: 1.6;">
          ${uni.faq2}
        </p>
      </div>
    </div>
  
    <div class="seo-card" style="margin-top: 32px;">
      <h3 style="font-size: 20px; font-weight: 800; color: var(--app-text); margin-bottom: 12px;">
        📘 In-Depth Technical Guide & Industry Standards for [UNI] CGPA CALCULATOR
      </h3>
      <p style="font-size: 14px; color: var(--app-text-secondary); line-height: 1.7; margin-bottom: 16px;">
        ToolsWaala provides 100% browser-based productivity utilities engineered specifically for Indian professionals, students, freelancers, and small business owners. Operating entirely inside client-side memory using HTML5 WebAssembly, JavaScript engines, and SVG rendering, your data is processed locally with zero server latency and zero security risks.
      </p>
      <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Key Technical Features & Advantages:</h4>
      <ul style="font-size: 14px; color: var(--app-text-secondary); line-height: 1.7; padding-left: 20px; margin-bottom: 16px;">
        <li><strong>100% Client-Side Processing:</strong> Zero file uploads to remote cloud servers. All operations happen inside your browser memory.</li>
        <li><strong>Zero Cost & Zero Registration:</strong> No account signup, credit cards, or hidden subscription tiers required.</li>
        <li><strong>High Precision Calculations:</strong> Adheres strictly to Indian regulatory frameworks, UGC academic guidelines, and NPCI standards.</li>
        <li><strong>Mobile & PWA Compatible:</strong> Designed for responsive performance across Android, iOS, Windows, and macOS devices.</li>
      </ul>
      <h4 style="font-size: 16px; font-weight: 700; color: var(--app-text); margin-bottom: 8px;">Why ToolsWaala Ranks #1 for Privacy:</h4>
      <p style="font-size: 14px; color: var(--app-text-secondary); line-height: 1.7;">
        Legacy utility websites upload confidential files and financial inputs to overseas cloud servers, introducing severe data breach risks. ToolsWaala's architecture guarantees that zero bytes leave your local device, keeping your confidential documents and personal calculations 100% secure.
      </p>
    </div>
  
  
    <!-- Additional High-Depth Search Engine Content Block -->
    <div class="seo-card" style="margin-top: 24px; background: var(--app-surface-card); border: 1px solid var(--app-border);">
      <h3 style="font-size: 18px; font-weight: 800; color: var(--app-text); margin-bottom: 10px;">
        💡 How ToolsWaala Guarantees 100% Accuracy & Privacy
      </h3>
      <p style="font-size: 14px; color: var(--app-text-secondary); line-height: 1.7; margin-bottom: 14px;">
        ToolsWaala is engineered from the ground up to solve privacy and speed issues inherent in online digital utilities. Traditional online tools force users to upload confidential documents (Aadhaar cards, bank statements, marksheets, legal agreements) to remote web servers in foreign jurisdictions, exposing sensitive data to data leaks and third-party tracking.
      </p>
      
      <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 6px;">Key Security & Usability Guarantees:</h4>
      <ul style="font-size: 13px; color: var(--app-text-secondary); line-height: 1.7; padding-left: 20px; margin-bottom: 14px;">
        <li><strong>Client-Side WebAssembly Engine:</strong> All calculations, PDF operations, image compression, and invoice rendering take place 100% within your local browser sandbox memory using HTML5, WebAssembly, and React DOM. Zero bytes leave your device.</li>
        <li><strong>No Account Registration Required:</strong> Enjoy unlimited access without creating accounts, providing email addresses, or subscribing to recurring monthly payments.</li>
        <li><strong>Instant Zero-Latency Execution:</strong> Because files and data are not uploaded over network connections, processing completes instantaneously regardless of your internet connection speed.</li>
        <li><strong>Full PWA & Mobile Optimization:</strong> Accessible across all desktop and mobile devices including Android, iOS, Windows, macOS, and Linux with full Progressive Web App support.</li>
      </ul>

      <h4 style="font-size: 15px; font-weight: 700; color: var(--app-text); margin-bottom: 6px;">Adherence to Official Indian Regulatory Guidelines:</h4>
      <p style="font-size: 13px; color: var(--app-text-secondary); line-height: 1.7; margin: 0;">
        All ToolsWaala utilities are updated to reflect official government ordinances including <strong>Central Goods and Services Tax (CGST) Rules 2017</strong>, <strong>Reserve Bank of India (RBI) Unified Payments Interface (UPI) deep link specifications</strong>, <strong>University Grants Commission (UGC) 75% attendance directives</strong>, and <strong>Indian Contract Act 1872 guidelines</strong>.
      </p>
    </div>

  </article>
</Layout>
