---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { CgpaCalculator } from '../react-pages/students';
import universities from '../data/universities.json';

export async function getStaticPaths() {
  return universities.map((uni) => ({
    params: { uni: uni.id },
    props: { uni },
  }));
}

const { uni } = Astro.props;
const title = `${uni.name} CGPA to Percentage Calculator 2025`;
const description = uni.desc;

const breadcrumb = `<nav><a href="/">Home</a> &gt; <a href="/students">Student Tools</a> &gt; <a href="/cgpa-calculator">CGPA Calculator</a> &gt; ${uni.name}</nav>`;

const faqSchemaStr = `<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the formula for ${uni.name} CGPA to percentage?","acceptedAnswer":{"@type":"Answer","text":"${uni.faq1}"}},{"@type":"Question","name":"What is a good CGPA in ${uni.name}?","acceptedAnswer":{"@type":"Answer","text":"${uni.faq2}"}}]}</script>\n`;

const bcSchema = `<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"CGPA Calculator","item":"https://toolswaala.in/cgpa-calculator"},{"@type":"ListItem","position":3,"name":"${title}","item":"https://toolswaala.in/${uni.id}-cgpa-calculator"}]}</script>\n`;
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath={`/${uni.id}-cgpa-calculator`}>
  <Fragment set:html={faqSchemaStr} />
  <Fragment set:html={bcSchema} />
  
  <PageWrapper title={title} hindi="सीजीपीए कैलकुलेटर" client:load>
    <CgpaCalculator client:only="react" initialUniIdx={uni.idx} />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <div set:html={breadcrumb} />
    <h1>{title}</h1>
    <p>{description}</p>
    
    <h2>Frequently Asked Questions</h2>
    <h3>What is the formula for {uni.name} CGPA to percentage?</h3>
    <p>{uni.faq1}</p>
    
    <h3>What is a good CGPA in {uni.name}?</h3>
    <p>{uni.faq2}</p>
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>
