---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/PageWrapper';
import { NocGenerator } from '../react-pages/students';

const title = "NOC Letter Generator — No Objection Certificate";
const description = "Create No Objection Certificates for internships and events instantly.";

const faqs = [
  {
    "q": "What is a No Objection Certificate (NOC)?",
    "a": "An NOC is a legal document issued by an organization, landlord, or authority stating they have no objections to a specific action (e.g., job transfer, vehicle registration)."
  },
  {
    "q": "Is a printed NOC legally valid?",
    "a": "Yes, once printed on the organization's official letterhead, signed, and stamped by the authorized signatory, the NOC is fully valid."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<Layout title={`${title} | ToolsWaala`} description={description} currentPath="/noc-generator">
  <script type="application/ld+json" is:inline set:html={faqSchema}></script>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://toolswaala.in/"},{"@type":"ListItem","position":2,"name":"NOC Letter Generator — No Objection Certificate","item":"https://toolswaala.in/noc-generator"}]}</script>

  <PageWrapper title={title} hindi="एनओसी लेटर" client:load>
    <NocGenerator client:only="react" />
  </PageWrapper>

  <div style="max-width:800px;margin:40px auto;padding:20px;font-family:system-ui,sans-serif">
    <nav><a href="/">Home</a> &gt; <a href="/students">Student Tools</a> &gt; NOC Letter Generator — No Objection Certificate</nav>
    <h1>{title}</h1>
    <p>{description}</p>
    
    
    <h2>Frequently Asked Questions</h2>
    {faqs.map(faq => (
      <h3>{faq.q}</h3>
      <p>{faq.a}</p>
    ))}
    
    <p>Free tool by <a href="https://toolswaala.in">ToolsWaala</a> — India's free toolkit. No login required.</p>
  </div>
</Layout>